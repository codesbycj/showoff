{
  "url": "http://localhost:5408/",
  "w": 1440,
  "h": 900,
  "wait": 6500,
  "settle": 650,
  "beats": [
    { "name": "rest" },

    { "name": "day-15", "click": "[data-day='15']", "settle": 800, "rest": true },
    { "name": "day-19", "click": "[data-day='19']", "settle": 800, "rest": true },
    { "name": "day-20", "click": "[data-day='20']", "settle": 800, "rest": true },
    { "name": "day-17", "click": "[data-day='17']", "settle": 800, "rest": true },

    { "name": "shared", "click": "[data-group='lens'] [data-segment='shared']", "settle": 800, "rest": true },
    { "name": "comments", "click": "[data-group='lens'] [data-segment='comments']", "settle": 800, "rest": true },
    { "name": "overview", "click": "[data-group='lens'] [data-segment='all']", "settle": 800, "rest": true },

    { "name": "members-down", "wheel": ["[data-scroller='members']", 160], "settle": 500, "rest": true },
    { "name": "members-top", "wheel": ["[data-scroller='members']", -160], "settle": 500, "rest": true },
    { "name": "projects-down", "wheel": ["[data-scroller='projects']", 160], "settle": 500, "rest": true },
    { "name": "projects-top", "wheel": ["[data-scroller='projects']", -160], "settle": 500, "rest": true },
    { "name": "notices-down", "wheel": ["[data-scroller='notices']", 220], "settle": 500, "rest": true },
    { "name": "notices-top", "wheel": ["[data-scroller='notices']", -220], "settle": 500, "rest": true },

    { "name": "search-standup", "fill": ["[data-search='global']", "standup"], "settle": 900, "rest": true },
    { "name": "search-empty", "fill": ["[data-search='global']", "zzzz"], "settle": 900, "rest": true },
    { "name": "search-cleared", "click": "[data-search-clear]", "settle": 900, "rest": true },

    { "name": "open-recording", "click": "[data-recording='r2']", "settle": 1000, "rest": true },
    { "name": "back-home", "click": "[data-tab='home']", "settle": 1000, "rest": true },
    { "name": "open-team", "click": "[data-action='open-team']", "settle": 1000, "rest": true },
    { "name": "home", "click": "[data-tab='home']", "settle": 1000, "rest": true },

    { "name": "inert-calendar", "click": "[data-tab='calendar']", "against": "home", "expectUnchanged": true },
    { "name": "inert-files", "click": "[data-tab='files']", "against": "home", "expectUnchanged": true },
    { "name": "inert-settings", "click": "[data-tab='settings']", "against": "home", "expectUnchanged": true },

    { "name": "focus-first", "key": "Tab", "settle": 350, "against": "home" },
    { "name": "focus-second", "key": "Tab", "settle": 350, "against": "focus-first" }
  ]
}
