{
  "url": "http://localhost:5392/",
  "w": 1440,
  "h": 900,
  "wait": 6500,
  "settle": 650,
  "beats": [
    { "name": "rest" },
    { "name": "tracking", "click": "[data-tab='tracking']", "settle": 1000, "rest": true },

    { "name": "pick-delivered", "click": "[data-row='sh5']", "settle": 800, "rest": true },
    { "name": "pick-draft", "click": "[data-row='sh1']", "settle": 800, "rest": true },

    { "name": "lens-moving", "click": "[data-group='lens'] [data-segment='moving']", "settle": 800, "rest": true },
    { "name": "pick-second", "click": "[data-row='sh3']", "settle": 800, "rest": true },
    { "name": "pick-first", "click": "[data-row='sh2']", "settle": 800, "rest": true },
    { "name": "lens-booked", "click": "[data-group='lens'] [data-segment='booked']", "settle": 800, "rest": true },
    { "name": "lens-all", "click": "[data-group='lens'] [data-segment='all']", "settle": 800, "rest": true },

    { "name": "search-peoria", "fill": ["[data-search='tracking']", "peoria"], "settle": 900, "rest": true },
    { "name": "search-empty", "fill": ["[data-search='tracking']", "zzzz"], "settle": 900, "rest": true },
    { "name": "search-cleared", "click": "[data-search-clear]", "settle": 900, "rest": true },

    { "name": "inert-clients", "click": "[data-tab='clients']", "against": "search-cleared", "expectUnchanged": true },
    { "name": "inert-settings", "click": "[data-tab='settings']", "against": "search-cleared", "expectUnchanged": true }
  ]
}
