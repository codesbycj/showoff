{
  "url": "http://localhost:5376/",
  "w": 1440,
  "h": 900,
  "wait": 6500,
  "settle": 650,
  "beats": [
    { "name": "rest" },
    { "name": "markets", "click": "[data-tab='markets']", "settle": 1000, "rest": true },

    { "name": "lens-watchlist", "click": "[data-group='lens'] [data-segment='watchlist']", "settle": 800, "rest": true },
    { "name": "lens-holdings", "click": "[data-group='lens'] [data-segment='holdings']", "settle": 800, "rest": true },
    { "name": "lens-all", "click": "[data-group='lens'] [data-segment='all']", "settle": 800, "rest": true },

    { "name": "sort-24h", "click": "[data-sort='change24h']", "settle": 800, "rest": true },
    { "name": "sort-24h-up", "click": "[data-sort='change24h']", "settle": 800, "rest": true },
    { "name": "sort-volume", "click": "[data-sort='volume']", "settle": 800, "rest": true },
    { "name": "sort-rank", "click": "[data-sort='rank']", "settle": 800, "rest": true },

    { "name": "row-eth", "click": "[data-row='eth']", "settle": 800, "rest": true },
    { "name": "row-sol", "click": "[data-row='sol']", "settle": 800, "rest": true },
    { "name": "row-closed", "click": "[data-row='sol']", "settle": 800, "rest": true },

    { "name": "watch-ada", "click": "[data-watch='ada']", "settle": 600, "rest": true },
    { "name": "watch-ada-off", "click": "[data-watch='ada']", "settle": 600, "rest": true },

    { "name": "market-down", "wheel": ["[data-scroller='market']", 320], "settle": 500, "rest": true },
    { "name": "market-further", "wheel": ["[data-scroller='market']", 320], "settle": 500, "rest": true },
    { "name": "market-top", "wheel": ["[data-scroller='market']", -640], "settle": 500, "rest": true },

    { "name": "search-sol", "fill": ["[data-search='markets']", "sol"], "settle": 900, "rest": true },
    { "name": "search-empty", "fill": ["[data-search='markets']", "zzzz"], "settle": 900, "rest": true },
    { "name": "search-cleared", "click": "[data-search-clear]", "settle": 900, "rest": true },

    { "name": "inert-earn", "click": "[data-tab='earn']", "against": "search-cleared", "expectUnchanged": true },
    { "name": "inert-settings", "click": "[data-tab='settings']", "against": "search-cleared", "expectUnchanged": true }
  ]
}
