{
  "url": "http://localhost:5412/",
  "w": 1440,
  "h": 900,
  "wait": 6500,
  "settle": 650,
  "beats": [
    { "name": "rest" },
    { "name": "tasks", "click": "[data-tab='tasks']", "settle": 1000, "rest": true },

    { "name": "one-list", "click": "[data-group='lens'] [data-segment='list']", "settle": 900, "rest": true },
    { "name": "board", "click": "[data-group='lens'] [data-segment='board']", "settle": 900, "rest": true },

    { "name": "card-closed", "click": "[data-task='t1']", "settle": 800, "rest": true },
    { "name": "card-other", "click": "[data-task='t2']", "settle": 800, "rest": true },
    { "name": "card-todo", "click": "[data-task='t3']", "settle": 800, "rest": true },

    { "name": "track-uiux", "click": "[data-track='ui-ux-design']", "settle": 900, "rest": true },
    { "name": "track-branding", "click": "[data-track='branding']", "settle": 900, "rest": true },
    { "name": "track-all", "click": "[data-track='all']", "settle": 900, "rest": true },

    { "name": "search-interview", "fill": ["[data-search='global']", "interview"], "settle": 900, "rest": true },
    { "name": "search-empty", "fill": ["[data-search='global']", "zzzz"], "settle": 900, "rest": true },
    { "name": "search-cleared", "click": "[data-search-clear]", "settle": 900, "rest": true },

    { "name": "dark", "click": "[data-theme-btn='dark']", "settle": 900, "rest": true },
    { "name": "light", "click": "[data-theme-btn='light']", "settle": 900, "rest": true },

    { "name": "inert-calendar", "click": "[data-tab='calendar']", "against": "light", "expectUnchanged": true },
    { "name": "inert-messages", "click": "[data-tab='messages']", "against": "light", "expectUnchanged": true }
  ]
}
