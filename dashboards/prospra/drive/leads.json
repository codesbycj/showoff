{
  "url": "http://localhost:5380/",
  "w": 1440,
  "h": 900,
  "wait": 6500,
  "settle": 650,
  "beats": [
    { "name": "rest" },
    { "name": "leads", "click": "[data-tab='leads']", "settle": 1000, "rest": true },

    { "name": "stage-mql", "click": "[data-lifecycle='mql']", "settle": 800, "rest": true },
    { "name": "stage-sql", "click": "[data-lifecycle='sql']", "settle": 800, "rest": true },
    { "name": "stage-opportunity", "click": "[data-lifecycle='opportunity']", "settle": 800, "rest": true },
    { "name": "stage-cleared", "click": "[data-lifecycle='opportunity']", "settle": 800, "rest": true },

    { "name": "owner-open", "click": "[data-select='owner'] > button", "settle": 600, "rest": true },
    { "name": "owner-pick", "click": "[data-menu='owner'] [data-option='r3']", "settle": 900, "rest": true },
    { "name": "owner-open-2", "click": "[data-select='owner'] > button", "settle": 600, "rest": true },
    { "name": "owner-all", "click": "[data-menu='owner'] [data-option='all']", "settle": 900, "rest": true },

    { "name": "sort-open", "click": "[data-select='sort'] > button", "settle": 600, "rest": true },
    { "name": "sort-recent", "click": "[data-menu='sort'] [data-option='recent']", "settle": 900, "rest": true },
    { "name": "sort-open-2", "click": "[data-select='sort'] > button", "settle": 600, "rest": true },
    { "name": "sort-score", "click": "[data-menu='sort'] [data-option='score']", "settle": 900, "rest": true },

    { "name": "row-open", "click": "[data-row='l05']", "settle": 800, "rest": true },
    { "name": "row-other", "click": "[data-row='l01']", "settle": 800, "rest": true },
    { "name": "row-closed", "click": "[data-row='l01']", "settle": 800, "rest": true },

    { "name": "leads-down", "wheel": ["[data-scroller='leads']", 300], "settle": 500, "rest": true },
    { "name": "leads-top", "wheel": ["[data-scroller='leads']", -300], "settle": 500, "rest": true },

    { "name": "search-energy", "fill": ["[data-search='leads']", "energy"], "settle": 900, "rest": true },
    { "name": "search-empty", "fill": ["[data-search='leads']", "zzzz"], "settle": 900, "rest": true },
    { "name": "search-cleared", "click": "[data-search-clear]", "settle": 900, "rest": true },

    { "name": "open-row-again", "click": "[data-row='l05']", "settle": 800, "rest": true },
    { "name": "to-pipeline", "click": "[data-action='open-deal']", "settle": 1000, "rest": true },
    { "name": "back-leads", "click": "[data-tab='leads']", "settle": 1000, "rest": true },

    { "name": "inert-workflows", "click": "[data-tab='workflows']", "against": "back-leads", "expectUnchanged": true },
    { "name": "inert-reports", "click": "[data-tab='reports']", "against": "back-leads", "expectUnchanged": true }
  ]
}
