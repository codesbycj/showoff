{
  "url": "http://localhost:5388/",
  "w": 1440,
  "h": 900,
  "wait": 6500,
  "settle": 650,
  "beats": [
    { "name": "rest" },
    { "name": "routes", "click": "[data-tab='routes']", "settle": 1000, "rest": true },

    { "name": "lens-now", "click": "[data-lens='now']", "settle": 800, "rest": true },
    { "name": "lens-planned", "click": "[data-lens='planned']", "settle": 800, "rest": true },
    { "name": "lens-done", "click": "[data-lens='done']", "settle": 800, "rest": true },
    { "name": "lens-all", "click": "[data-lens='all']", "settle": 800, "rest": true },

    { "name": "sort-distance", "click": "[data-group='sort'] [data-segment='distance']", "settle": 800, "rest": true },
    { "name": "sort-id", "click": "[data-group='sort'] [data-segment='id']", "settle": 800, "rest": true },
    { "name": "sort-packages", "click": "[data-group='sort'] [data-segment='packages']", "settle": 800, "rest": true },

    { "name": "row-open", "click": "[data-row='131-044']", "settle": 800, "rest": true },
    { "name": "row-other", "click": "[data-row='107-591']", "settle": 800, "rest": true },
    { "name": "row-closed", "click": "[data-row='107-591']", "settle": 800, "rest": true },

    { "name": "routes-down", "wheel": ["[data-scroller='routes']", 220], "settle": 500, "rest": true },
    { "name": "routes-top", "wheel": ["[data-scroller='routes']", -220], "settle": 500, "rest": true },

    { "name": "search-salinas", "fill": ["[data-search='routes']", "salinas"], "settle": 900, "rest": true },
    { "name": "search-empty", "fill": ["[data-search='routes']", "zzzz"], "settle": 900, "rest": true },
    { "name": "search-cleared", "click": "[data-search-clear]", "settle": 900, "rest": true },

    { "name": "inert-depot", "click": "[data-tab='depot']", "against": "search-cleared", "expectUnchanged": true },
    { "name": "inert-alerts", "click": "[data-tab='alerts']", "against": "search-cleared", "expectUnchanged": true }
  ]
}
