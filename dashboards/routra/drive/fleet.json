{
  "url": "http://localhost:5388/",
  "w": 1440,
  "h": 900,
  "wait": 6500,
  "settle": 650,
  "beats": [
    { "name": "rest" },

    { "name": "driver-nolan", "click": "[data-driver='d1']", "settle": 900, "rest": true },
    { "name": "driver-talan", "click": "[data-driver='d4']", "settle": 900, "rest": true },
    { "name": "driver-gustavo", "click": "[data-driver='d8']", "settle": 900, "rest": true },
    { "name": "driver-james", "click": "[data-driver='d3']", "settle": 900, "rest": true },

    { "name": "slice-way", "click": "[data-slice='way']", "settle": 700, "rest": true },
    { "name": "slice-loading", "click": "[data-state='loading']", "settle": 700, "rest": true },
    { "name": "slice-cleared", "click": "[data-state='loading']", "settle": 700, "rest": true },

    { "name": "day-hover", "hover": "[data-slice='unloading']", "against": "slice-cleared" },
    { "name": "week-hover", "hover": "[data-mark='day-thu']", "against": "day-hover" },
    { "name": "week-hover-2", "hover": "[data-mark='day-sun']", "against": "week-hover" },

    { "name": "drivers-down", "wheel": ["[data-scroller='drivers']", 220], "settle": 500, "rest": true },
    { "name": "drivers-top", "wheel": ["[data-scroller='drivers']", -220], "settle": 500, "rest": true },
    { "name": "routes-down", "wheel": ["[data-scroller='routes']", 200], "settle": 500, "rest": true },
    { "name": "routes-top", "wheel": ["[data-scroller='routes']", -200], "settle": 500, "rest": true },

    { "name": "search-harlo", "fill": ["[data-search='drivers']", "harlo"], "settle": 900, "rest": true },
    { "name": "search-empty", "fill": ["[data-search='drivers']", "zzzz"], "settle": 900, "rest": true },
    { "name": "search-cleared", "click": "[data-search-clear]", "settle": 900, "rest": true },

    { "name": "to-routes", "click": "[data-tab='routes']", "settle": 1000, "rest": true },
    { "name": "to-vehicles", "click": "[data-tab='vehicles']", "settle": 1000, "rest": true },
    { "name": "back-fleet", "click": "[data-tab='fleet']", "settle": 1000, "rest": true },

    { "name": "inert-map", "click": "[data-tab='map']", "against": "back-fleet", "expectUnchanged": true },
    { "name": "inert-messages", "click": "[data-tab='messages']", "against": "back-fleet", "expectUnchanged": true },
    { "name": "inert-docs", "click": "[data-action='documents']", "against": "back-fleet", "expectUnchanged": true },

    { "name": "focus-first", "key": "Tab", "settle": 350, "against": "back-fleet" },
    { "name": "focus-second", "key": "Tab", "settle": 350, "against": "focus-first" }
  ]
}
