{
  "url": "http://localhost:5332/",
  "w": 1440,
  "h": 900,
  "wait": 6500,
  "settle": 650,
  "beats": [
    { "name": "open-history", "click": "[data-tab='history']", "settle": 900, "rest": true },

    { "name": "filter-software", "click": "[data-group='category'] [data-segment='Software']", "settle": 850, "rest": true },
    { "name": "filter-income", "click": "[data-group='category'] [data-segment='Income']", "settle": 850, "rest": true },
    { "name": "filter-transfer", "click": "[data-group='category'] [data-segment='Transfer']", "settle": 850, "rest": true },
    { "name": "filter-all", "click": "[data-group='category'] [data-segment='all']", "settle": 850, "rest": true },

    { "name": "sort-amount", "click": "[data-sort='amount']", "settle": 750, "rest": true },
    { "name": "sort-amount-asc", "click": "[data-sort='amount']", "settle": 750, "rest": true },
    { "name": "sort-name", "click": "[data-sort='name']", "settle": 750, "rest": true },
    { "name": "sort-date", "click": "[data-sort='date']", "settle": 750, "rest": true },

    { "name": "ledger-scrolled", "wheel": ["[data-scroller='ledger']", 280], "rest": true },
    { "name": "ledger-top", "wheel": ["[data-scroller='ledger']", -280], "rest": true },

    { "name": "bars-jan-in", "hover": "[data-card='flowbars'] [data-mark='jan-earned']", "against": "ledger-top" },
    { "name": "bars-jan-out", "hover": "[data-card='flowbars'] [data-mark='jan-spent']", "against": "bars-jan-in" },
    { "name": "bars-mar-in", "hover": "[data-card='flowbars'] [data-mark='mar-earned']", "against": "bars-jan-out" },

    { "name": "search-corvid", "fill": ["[data-search]", "corvid"], "settle": 900, "rest": true },
    { "name": "search-empty", "fill": ["[data-search]", "zzzz"], "settle": 900, "rest": true },
    { "name": "search-cleared", "click": "[data-search-clear]", "settle": 900, "rest": true },

    { "name": "inert-people", "click": "[data-tab='people']", "against": "search-cleared", "expectUnchanged": true },
    { "name": "inert-goals", "click": "[data-tab='goals']", "against": "search-cleared", "expectUnchanged": true }
  ]
}
