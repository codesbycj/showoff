      "settle": 800,
      "rest": true
    },
    {
      "name": "tile-paid",
      "click": "[data-segment='Paid']",
      "settle": 800,
      "rest": true
    },
    {
      "name": "tile-awaiting",
      "click": "[data-segment='Awaiting']",
      "settle": 800,
      "rest": true
    },
    {
      "name": "show-all",
      "click": "[data-segment='all']",
      "settle": 800,
      "rest": true
    },
    {
      "name": "sort-open",
      "click": "[data-select='sort'] button",
      "settle": 320
    },
    {
      "name": "sort-total",
      "click": "[data-menu='sort'] [data-option='total']",
      "settle": 800
    },
    {
      "name": "sort-open-2",
      "click": "[data-select='sort'] button",
      "settle": 320
    },
    {
      "name": "sort-customer",
      "click": "[data-menu='sort'] [data-option='customer']",
      "settle": 800
    },
    {
      "name": "sort-open-3",
      "click": "[data-select='sort'] button",
      "settle": 320
    },
    {
      "name": "sort-recent",
      "click": "[data-menu='sort'] [data-option='recent']",
      "settle": 800
    },
    {
      "name": "invoices-scrolled",
      "wheel": [
        "[data-scroller='invoices']",
        300
      ],
      "rest": true
    },
    {
      "name": "invoices-top",
      "wheel": [
        "[data-scroller='invoices']",
        -300
      ],
      "rest": true
    },
    {
      "name": "slice-card",
      "hover": "[data-mark='slice-Card']",
