    },
    {
      "name": "slice-transfer",
      "hover": "[data-mark='slice-Transfer']",
      "against": "slice-card"
    },
    {
      "name": "legend-wallet",
      "click": "[data-legend='Wallet']",
      "settle": 600
    },
    {
      "name": "legend-wallet-off",
      "click": "[data-legend='Wallet']",
      "settle": 600
    },
    {
      "name": "search-clarke",
      "fill": [
        "[data-search]",
        "clarke"
      ],
      "settle": 800,
      "rest": true
    },
    {
      "name": "search-clear",
      "click": "[data-search-clear]",
      "settle": 800,
      "rest": true
    },
    {
      "name": "theme-dark",
      "click": "[data-theme-btn='dark']",
      "settle": 800,
      "rest": true
    },
    {
      "name": "theme-light",
      "click": "[data-theme-btn='light']",
      "settle": 800,
      "rest": true
    },
    {
      "name": "inert-reports",
      "click": "[data-tab='reports']",
      "expectUnchanged": true,
      "rest": true,
