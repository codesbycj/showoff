{
  "url": "http://localhost:5348/",
  "w": 1440,
  "h": 900,
  "wait": 6500,
  "settle": 650,
  "beats": [
    { "name": "open-transactions", "click": "[data-tab='transactions']", "settle": 950, "rest": true },

    { "name": "status-success", "click": "[data-group='status'] [data-segment='Success']", "settle": 850, "rest": true },
    { "name": "status-pending", "click": "[data-group='status'] [data-segment='Pending']", "settle": 850, "rest": true },
    { "name": "status-failed", "click": "[data-group='status'] [data-segment='Failed']", "settle": 850, "rest": true },
    { "name": "status-all", "click": "[data-group='status'] [data-segment='all']", "settle": 850, "rest": true },

    { "name": "cat-software", "click": "[data-category='Software']", "settle": 900, "rest": true },
    { "name": "cat-living", "click": "[data-category='Living']", "settle": 900, "rest": true },
    { "name": "cat-leisure", "click": "[data-category='Leisure']", "settle": 900, "rest": true },
    { "name": "cat-cleared", "click": "[data-action='clear-category']", "settle": 900, "rest": true },

    { "name": "sort-price", "click": "[data-sort='price']", "settle": 750, "rest": true },
    { "name": "sort-price-asc", "click": "[data-sort='price']", "settle": 750, "rest": true },
    { "name": "sort-activity", "click": "[data-sort='activity']", "settle": 750, "rest": true },
    { "name": "sort-date", "click": "[data-sort='stamp']", "settle": 750, "rest": true },

    { "name": "ledger-scrolled", "wheel": ["[data-scroller='ledger']", 280], "rest": true },
    { "name": "ledger-top", "wheel": ["[data-scroller='ledger']", -280], "rest": true },

    { "name": "search-cloud", "fill": ["[data-search]", "cloud"], "settle": 900, "rest": true },
    { "name": "search-empty", "fill": ["[data-search]", "zzzz"], "settle": 900, "rest": true },
    { "name": "search-cleared", "click": "[data-search-clear]", "settle": 900, "rest": true },

    { "name": "inert-subscriptions", "click": "[data-tab='subscriptions']", "against": "search-cleared", "expectUnchanged": true },
    { "name": "inert-settings", "click": "[data-tab='settings']", "against": "search-cleared", "expectUnchanged": true }
  ]
}
