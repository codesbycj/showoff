import { Image, Pressable, View, type ImageSourcePropType } from 'react-native';

import { CarouselDots } from './carousel-dots';
import { Icon } from './icon';
import { T } from './text';
import { PROMO_HEIGHT, PROMO_PANEL } from '../layout';
import { radius, vl } from '../theme';

/** Half the dots pill's height — how far it straddles the card's bottom edge. */
const DOTS_OVERHANG = 11;

/**
 * The promotion: a lime card, a badge, two lines of headline, a dark CTA, a
 * photograph filling its right end, and the carousel's position notched into
 * its bottom edge.
 *
 * Three things here are worth the words.
 *
 * **The photograph is a bled panel, not a cut-out figure.** The reference puts
 * a cut-out shopper on the green, which is the more charming of the two — but
 * the stock frame standing in for her has a backdrop whose border pixels
 * measure a standard deviation of 31, so a flood-fill cut leaves a grey halo
 * and chewed edges on the hair and the bag handles, at a size where that is
 * all you would see. A clean bleed beats a bad cut-out.
 *
 * **The dots sit in a pill straddling the card's bottom edge.** That is why
 * this component is two nested views: the inner one clips, so the photograph
 * stops at the radius, and the outer one does not, so the pill can cross that
 * edge. One view cannot do both.
 *
 * The outer view is padded by the overhang rather than letting the pill spill
 * past its bounds. Nothing here relies on overflow being visible — Android
 * clips an overflowing child far more readily than the web harness does, and
 * a bottom half missing from the dots is exactly the kind of fault a web
 * render would never show.
 *
 * **`overflow: hidden` and `elevation` are never on the same view.** The pair
 * is unreliable on Android. The clip is on the inner card; nothing here is
 * raised.
 */
export function PromoCard({
  badge,
  headline,
  cta,
  image,
  slides,
  activeSlide = 0,
  onPress,
}: {
  badge: string;
  headline: readonly string[];
  cta: string;
  image: ImageSourcePropType;
  slides: number;
  activeSlide?: number;
  onPress?: () => void;
}) {
  return (
    <View style={{ paddingBottom: DOTS_OVERHANG }}>
      <View
        style={{
          height: PROMO_HEIGHT,
          borderRadius: radius.card,
          backgroundColor: vl.lime,
          overflow: 'hidden',
          flexDirection: 'row',
        }}
      >
        {/*
          A soft darker shape behind the copy. The reference has one and it is
          easy to miss, but it is what stops a flat fill this size looking
          like a placeholder. Drawn as an oversized circle so its curve reads
          as a sweep rather than as a blob with an edge.
        */}
        <View
          pointerEvents="none"
          style={{
            position: 'absolute',
            left: -70,
            top: -120,
            width: 300,
            height: 300,
            borderRadius: 150,
            backgroundColor: vl.limeShade,
          }}
        />

        <View
          style={{
            flex: 1,
            paddingLeft: 18,
            paddingVertical: 18,
            justifyContent: 'space-between',
          }}
        >
          <View
            style={{
              alignSelf: 'flex-start',
              borderRadius: radius.full,
              backgroundColor: vl.pill,
              paddingHorizontal: 10,
              paddingVertical: 5,
            }}
          >
            <T variant="badge" color={vl.onPill}>
              {badge}
            </T>
          </View>

          <View>
            {headline.map((line) => (
              <T key={line} variant="promo" color={vl.ink}>
                {line}
              </T>
            ))}
          </View>

          {/*
            The CTA's arrow sits in a light disc rather than inline with the
            label. Inline, a 13px bold label and a 14px glyph fight for the
            same optical weight; in a disc the glyph becomes punctuation.
          */}
          <Pressable onPress={onPress} accessibilityRole="button" accessibilityLabel={cta}>
            <View
              style={{
                alignSelf: 'flex-start',
                flexDirection: 'row',
                alignItems: 'center',
                gap: 8,
                borderRadius: radius.full,
                backgroundColor: vl.pill,
                paddingLeft: 16,
                paddingRight: 6,
                paddingVertical: 6,
              }}
            >
              <T variant="cta" color={vl.onPill}>
                {cta}
              </T>
              <View
                style={{
                  width: 24,
                  height: 24,
                  borderRadius: radius.full,
                  backgroundColor: vl.onPill,
                  alignItems: 'center',
                  justifyContent: 'center',
                }}
              >
                <Icon name="arrow" size={14} color={vl.pill} strokeWidth={2.2} />
              </View>
            </View>
          </Pressable>
        </View>

        <Image
          source={image}
          style={{ width: PROMO_PANEL, height: '100%' }}
          resizeMode="cover"
          accessibilityIgnoresInvertColors
        />
      </View>

      {/* Straddling the bottom edge, in the page's own colour, so it reads as
          a notch cut into the card rather than a chip laid on top of it. The
          wrapper's padding is what it straddles into, so it stays inside. */}
      <View
        style={{
          position: 'absolute',
          bottom: 0,
          left: 0,
          right: 0,
          alignItems: 'center',
        }}
        pointerEvents="none"
      >
        <View
          style={{
            backgroundColor: vl.canvas,
            borderRadius: radius.full,
            paddingHorizontal: 12,
            paddingVertical: 8,
          }}
        >
          <CarouselDots count={slides} active={activeSlide} />
        </View>
      </View>
    </View>
  );
}
