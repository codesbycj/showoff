import { Image, Pressable, ScrollView, View } from 'react-native';

import { T } from './text';
import type { Category } from '../data/home';
import { CHIP_GAP, CHIP_HEIGHT, CHIP_THUMB_H, CHIP_THUMB_W, CHIP_WIDTH, MARGIN } from '../layout';
import { radius, vl } from '../theme';

/**
 * The categories: a label and a thumbnail, side by side, in a row that runs
 * off the right edge of the screen.
 *
 * **A scrolling row, not a wrap.** The reference shows the third chip clipped
 * by the screen edge, and a clipped item is the signature of a horizontal
 * scroll: a wrapping layout physically cannot produce it, because it would
 * have moved that chip to a second line instead.
 *
 * The row is laid out edge-to-edge and takes the page margin as its own
 * content padding, so the first chip lines up with everything above it while
 * the last one is still free to run under the screen's edge. Putting the
 * margin on a parent instead would clip the scroll at the margin and lose
 * exactly the effect it is here for.
 */
export function CategoryRow({
  categories,
  onSelect,
}: {
  categories: Category[];
  onSelect?: (c: Category) => void;
}) {
  return (
    <ScrollView
      horizontal
      showsHorizontalScrollIndicator={false}
      contentContainerStyle={{ paddingHorizontal: MARGIN, gap: CHIP_GAP }}
    >
      {categories.map((c) => (
        <Pressable
          key={c.id}
          onPress={() => onSelect?.(c)}
          accessibilityRole="button"
          accessibilityLabel={c.label}
        >
          <View
            style={{
              width: CHIP_WIDTH,
              height: CHIP_HEIGHT,
              borderRadius: radius.chip,
              backgroundColor: vl.field,
              flexDirection: 'row',
              alignItems: 'center',
              paddingLeft: 12,
              paddingRight: 5,
              justifyContent: 'space-between',
            }}
          >
            {/*
              The label is given the room it needs and allowed two lines.
              "Men's footwear" does not fit on one at this width, and letting
              it wrap is what keeps all three chips the same size — the
              alternative is three different widths and a ragged row.
            */}
            <T
              variant="chip"
              color={vl.inkSoft}
              numberOfLines={2}
              style={{ flex: 1, marginRight: 8 }}
            >
              {c.label}
            </T>
            <Image
              source={c.image}
              style={{ width: CHIP_THUMB_W, height: CHIP_THUMB_H, borderRadius: radius.thumb }}
              resizeMode="cover"
              accessibilityIgnoresInvertColors
            />
          </View>
        </Pressable>
      ))}
    </ScrollView>
  );
}
