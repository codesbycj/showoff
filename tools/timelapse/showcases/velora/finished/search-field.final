import { Pressable, View } from 'react-native';

import { Icon } from './icon';
import { T } from './text';
import { FIELD_HEIGHT } from '../layout';
import { radius, vl } from '../theme';

/**
 * The search field.
 *
 * Not a `TextInput`. Nothing on this screen is typed into, and a real input
 * would bring a caret, a keyboard on tap and a focus ring — three things to
 * suppress for a screen that is going to be filmed rather than used. It is a
 * button that *looks* like a field, labelled as one for a screen reader.
 *
 * The filter control is divided off with a hairline rather than floated at the
 * edge, which is what keeps it reading as part of the field instead of a
 * second button sitting next to it.
 */
export function SearchField({
  placeholder,
  onPress,
  onFilter,
}: {
  placeholder: string;
  onPress?: () => void;
  onFilter?: () => void;
}) {
  /*
   * The two controls are siblings inside a plain `View`, not one `Pressable`
   * wrapping another.
   *
   * `accessibilityRole="button"` makes react-native-web render a real
   * `<button>`, and a button inside a button is invalid HTML — the static
   * build's parser pulls the inner one out of its parent, which rearranges the
   * row and logs `<button> cannot contain a nested <button>`. It renders fine
   * on native, so this is exactly the kind of fault only the web harness sees.
   */
  return (
    <View
      style={{
        height: FIELD_HEIGHT,
        borderRadius: radius.full,
        backgroundColor: vl.card,
        flexDirection: 'row',
        alignItems: 'center',
        paddingLeft: 16,
        paddingRight: 8,
      }}
    >
      <Pressable
        onPress={onPress}
        accessibilityRole="button"
        accessibilityLabel={placeholder}
        style={{ flex: 1 }}
      >
        <View style={{ flexDirection: 'row', alignItems: 'center' }}>
          <Icon name="search" size={18} color={vl.muted} />
          <T variant="field" color={vl.muted} style={{ marginLeft: 10 }}>
            {placeholder}
          </T>
        </View>
      </Pressable>

      <View style={{ width: 1, height: 22, backgroundColor: vl.rule }} />

      <Pressable onPress={onFilter} accessibilityRole="button" accessibilityLabel="Filter results">
        <View style={{ width: 40, height: 40, alignItems: 'center', justifyContent: 'center' }}>
          <Icon name="filter" size={18} color={vl.ink} />
        </View>
      </Pressable>
    </View>
  );
}
