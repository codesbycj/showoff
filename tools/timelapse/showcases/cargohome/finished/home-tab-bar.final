import { Pressable, View } from 'react-native';

import { Icon } from './icon';
import { T } from './text';
import { TABS } from '../data/home';
import { TAB_HEIGHT } from '../layout';
import { shadow, cg } from '../theme';

/**
 * The four places the app goes.
 *
 * A full-width bar sitting on the bottom edge, not a floating pill — that is
 * what the reference has, and it is the right call for a screen whose content
 * is already a stack of rounded cards: one more rounded thing floating over
 * them would be a fifth card.
 *
 * Every tab carries its label, active or not. The active one is simply darker.
 * Hiding the inactive labels would save a few points of height and cost the
 * three destinations nobody has visited yet their only explanation.
 *
 * Carries `elevation` and does not clip — the pair is unreliable on Android.
 */
export function HomeTabBar({
  active,
  bottomInset,
  onSelect,
}: {
  active: string;
  bottomInset: number;
  onSelect?: (id: string) => void;
}) {
  return (
    <View
      style={{
        position: 'absolute',
        left: 0,
        right: 0,
        bottom: 0,
        paddingBottom: bottomInset,
        backgroundColor: cg.surface,
        ...shadow.bar,
      }}
    >
      <View
        style={{
          height: TAB_HEIGHT,
          flexDirection: 'row',
          alignItems: 'center',
          justifyContent: 'space-around',
          paddingHorizontal: 8,
        }}
      >
        {TABS.map((tab) => {
          const on = tab.id === active;
          return (
            <Pressable
              key={tab.id}
              onPress={() => onSelect?.(tab.id)}
              accessibilityRole="tab"
              accessibilityState={{ selected: on }}
              accessibilityLabel={tab.label}
            >
              <View style={{ alignItems: 'center', gap: 4, paddingHorizontal: 10 }}>
                <Icon
                  name={tab.icon}
                  size={21}
                  color={on ? cg.ink : cg.placeholder}
                  filled={on && tab.icon === 'home'}
                />
                <T variant="chip" color={on ? cg.ink : cg.placeholder}>
                  {tab.label}
                </T>
              </View>
            </Pressable>
          );
        })}
      </View>
    </View>
  );
}
