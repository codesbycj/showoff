            onPress={() => router.push('/flowmeals')}
          >
            <View
              style={{
                height: L.cta.h,
                flexDirection: 'row',
                alignItems: 'center',
                justifyContent: 'center',
                gap: 10,
              }}
            >
              {/* STEP 1.27 view
              <View
                style={{
                  position: 'absolute',
                  top: 0,
                  left: 0,
                  right: 0,
                  bottom: 0,
                  borderRadius: L.cta.h / 2,
                  backgroundColor: ct.dark,
                }}
              />
              */}

              {/* STEP 1.28 cta
              <T variant="cta">{recipe.cta}</T>
              */}
              {/* STEP 1.30 a stray gap above it | FIX 1.31 take the gap back out
              <View style={{ width: 23, height: 23 }} />
              */}
              {/* STEP 1.29 glyph
              <Glyph name="arrow" size={18} color={ct.onDark} strokeWidth={2} />
              */}
            </View>
          </Pressable>
        </View>
      </View>
