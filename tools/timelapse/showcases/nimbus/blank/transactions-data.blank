/**
 * The transactions under the card.
 *
 * The reference shows three, the third cut off by the floating dock — which is
 * how it says there are more. There is a fourth here so that there are: the
 * dock floats over a scroll, and a list ending exactly at the dock would have
 * nothing to scroll.
 */
/** The marks `brand-mark.tsx` draws, named by the data that asks for them. */
export type BrandKey = 'appleMusic' | 'uberEats' | 'prime' | 'netflix';

export const TRANSACTIONS: {
  id: string;
  brand: BrandKey;
  title: string;
  when: string;
  amount: string;
  tag: string;
}[] = [
