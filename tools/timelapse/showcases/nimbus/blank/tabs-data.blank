/**
 * The dock's four destinations, in order. The key is also the glyph's name:
 * `dock-glyph.tsx` draws one shape per key and takes this type, rather than
 * the data taking a type from the component — the data is what decides how
 * many tabs there are.
 */
export type TabKey = 'home' | 'cards' | 'analytics' | 'settings';

export const TABS: { key: TabKey; label: string }[] = [
  // STEP 1.46 home
  // { key: 'home', label: 'Home' },
  // STEP 1.47 the cards, which is where we are
  // { key: 'cards', label: 'Cards' },
  // STEP 1.48 analytics
  // { key: 'analytics', label: 'Analytics' },
  // STEP 1.49 and settings
  // { key: 'settings', label: 'Settings' },
];
