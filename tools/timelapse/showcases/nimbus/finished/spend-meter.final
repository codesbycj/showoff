import { View } from 'react-native';

import { SPEND } from '../data/cards';
import { METER_HEIGHT, METER_PAD, METER_PAD_TOP } from '../layout';
import { nb, radius, shadow } from '../theme';
import { MeterTrack } from './meter-track';
import { T } from './text';

/**
 * "Spent this month": a heading and a figure, the bar, then the two captions
 * under it.
 *
 * The three bands are stacked by measured gaps rather than spread with
 * `space-between`, because the card's height is measured too and a spread
 * would move every band if the type ramp ever shifted by a point.
 */
export function SpendMeter() {
  return (
    <View
      style={{
        height: METER_HEIGHT,
        borderRadius: radius.tile,
        backgroundColor: nb.surface,
        paddingHorizontal: METER_PAD,
        paddingTop: METER_PAD_TOP,
        ...shadow.soft,
      }}
    >
      <View style={{ flexDirection: 'row', alignItems: 'baseline' }}>
        <T variant="meterHead" color={nb.inkSoft}>
          {SPEND.head}
        </T>
        <View style={{ flex: 1 }} />
        <T variant="meterAmount" color={nb.ink}>
          {SPEND.amount}
        </T>
        <T variant="meterTotal" color={nb.mutedLight}>
          {SPEND.total}
        </T>
      </View>

      <View style={{ marginTop: 11 }}>
        <MeterTrack fraction={SPEND.fraction} />
      </View>

      <View style={{ flexDirection: 'row', justifyContent: 'space-between', marginTop: 2.5 }}>
        <T variant="meterNote" color={nb.muted}>
          {SPEND.note}
        </T>
        <T variant="meterNote" color={nb.mutedLight}>
          {SPEND.cap}
        </T>
      </View>
    </View>
  );
}
