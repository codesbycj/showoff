/**
 * The transactions under the card.
 *
 * The reference shows three, the third cut off by the floating dock — which is
 * how it says there are more. There is a fourth here so that there are: the
 * dock floats over a scroll, and a list ending exactly at the dock would have
 * nothing to scroll.
 */
/** The marks `brand-mark.tsx` draws, named by the data that asks for them. */
export type BrandKey = 'appleMusic' | 'uberEats' | 'prime' | 'netflix';

export const TRANSACTIONS: {
  id: string;
  brand: BrandKey;
  title: string;
  when: string;
  amount: string;
  tag: string;
}[] = [
  {
    id: 'apple-music',
    brand: 'appleMusic',
    title: 'Apple Music',
    when: 'Today, 1:00 PM',
    amount: '$25.00',
    tag: 'Subscription',
  },
  {
    id: 'uber-eats',
    brand: 'uberEats',
    title: 'Uber Eats',
    when: 'Today, 9:23 AM',
    amount: '$78.00',
    tag: 'Food',
  },
  {
    id: 'amazon-prime',
    brand: 'prime',
    title: 'Amazon Prime',
    when: 'Today, 1:00 PM',
    amount: '$89.00',
    tag: 'Subscription',
  },
  {
    id: 'netflix',
    brand: 'netflix',
    title: 'Netflix',
    when: 'Yesterday, 7:40 PM',
    amount: '$15.99',
    tag: 'Subscription',
  },
];
