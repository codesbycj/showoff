import { Pressable, View } from 'react-native';

import { TABS } from '../data/tabs';
import {
  DOCK_BOTTOM,
  DOCK_HEIGHT,
  DOCK_ICON_TOP,
  DOCK_MARGIN,
  DOCK_PAD,
  DOCK_PILL_INSET,
  DOCK_PILL_OVERHANG,
} from '../layout';
import { nb, radius, shadow } from '../theme';
import { DockGlyph } from './dock-glyph';
import { T } from './text';

/**
 * The floating dock.
 *
 * Four items on a 61dp pill that sits 20dp off the bottom of the screen — over
 * the home indicator's safe area rather than above it, which is where the
 * reference puts it and what makes the last transaction run under it.
 *
 * Two measured details the layout would not otherwise produce:
 *
 *   * the items are not spread edge to edge. Their centres are 81.6dp apart
 *     inside a 342.5dp pill, which is a 7.7dp padding around four equal
 *     columns — spreading them would put the outer two 5.8dp further out.
 *   * the active pill is *wider than its column* — 92.4 against 81.8 — so it
 *     is drawn as an overhang either side rather than as the column's own
 *     background.
 *
 * The dock reports taps and decides nothing. `active` comes in from the
 * screen, so this component never knows which screen it is on.
 */
export function TabDock({
  active,
  onSelect,
}: {
  active: string;
  onSelect?: (key: string) => void;
}) {
  return (
    <View
      style={{
        position: 'absolute',
        left: DOCK_MARGIN,
        right: DOCK_MARGIN,
        bottom: DOCK_BOTTOM,
        height: DOCK_HEIGHT,
        borderRadius: radius.full,
        backgroundColor: nb.dock,
        flexDirection: 'row',
        paddingHorizontal: DOCK_PAD,
        ...shadow.dock,
      }}
    >
      {TABS.map((tab) => {
        const on = tab.key === active;
        return (
          <Pressable
            key={tab.key}
            style={{ flex: 1, alignItems: 'center', paddingTop: DOCK_ICON_TOP }}
            onPress={() => onSelect?.(tab.key)}
            accessibilityRole="button"
            accessibilityState={{ selected: on }}
          >
            {on ? (
              <View
                style={{
                  position: 'absolute',
                  left: -DOCK_PILL_OVERHANG,
                  right: -DOCK_PILL_OVERHANG,
                  top: DOCK_PILL_INSET,
                  bottom: DOCK_PILL_INSET,
                  borderRadius: radius.full,
                  backgroundColor: nb.sunken,
                }}
              />
            ) : null}

            {/*
              Wrapped, and not for layout: react-native-svg renders a bare
              `<svg>` on web, which CSS paints *below* a positioned sibling —
              so the active pill covered the glyph and left its label showing.
              A `View` is position:relative, so paint order follows the
              children, which is what React Native does natively anyway.
            */}
            <View>
              <DockGlyph name={tab.key} color={on ? nb.ink : nb.muted} />
            </View>

            <T
              variant={on ? 'tabLabelOn' : 'tabLabel'}
              color={on ? nb.ink : nb.muted}
              style={{ marginTop: 2.5 }}
            >
              {tab.label}
            </T>
          </Pressable>
        );
      })}
    </View>
  );
}
