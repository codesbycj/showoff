import { View } from 'react-native';

import { gps } from '../data/start';
import { ct } from '../theme';
import { T } from './text';

type Props = { top: number };

/**
 * The fix the watch has.
 *
 * It floats over the map rather than inside it, so it is readable whatever the
 * map is showing - the dark pill is what makes the label clear 4.5:1 over a
 * lime park (R4).
 */
export function GpsPill({ top }: Props) {
  return (
    <View style={{ position: 'absolute', top, left: 0, right: 0, alignItems: 'center' }}>
      <View
        style={{
          height: 32,
          paddingHorizontal: 14,
          borderRadius: 16,
          backgroundColor: 'rgba(10,11,13,0.82)',
          flexDirection: 'row',
          alignItems: 'center',
          gap: 8,
        }}
      >
        <View style={{ width: 7, height: 7, borderRadius: 4, backgroundColor: ct.lime }} />
        <T variant="chipOff">
          {gps.state} · {gps.accuracy}
        </T>
      </View>
    </View>
  );
}
