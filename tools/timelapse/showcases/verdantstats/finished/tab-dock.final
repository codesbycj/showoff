import { useState } from 'react';
import { Pressable, View } from 'react-native';

import { tabs, type TabKey } from '../data/analytics';
import { DOCK_HEIGHT, DOCK_ICON, DOCK_LABEL_TOP, FAB_RISE, FAB_SIZE } from '../layout';
import { radius, shadow, vs } from '../theme';
import { Icon } from './icon';
import { T } from './text';

/**
 * The dock: four destinations and the action the app is built around.
 *
 * The centre button is a **sibling of the row, positioned over it**, not a
 * cell inside it. It overhangs the dock's top edge, and an overhanging child
 * of a clipped box is the one thing Android reliably cuts off — `overflow:
 * 'hidden'` and `elevation` on the same view is already a known trap here, and
 * this avoids needing either.
 *
 * The four cells are equal flex columns with the middle one left empty, so the
 * glyphs sit where they would if the button were one of them, and the pair
 * either side stays even however wide the phone is.
 */
export function TabDock({
  active,
  bottomInset,
  onSelect,
  onSwap,
}: {
  active: TabKey;
  bottomInset: number;
  onSelect?: (key: TabKey) => void;
  onSwap?: () => void;
}) {
  const [held, setHeld] = useState(false);

  return (
    <View style={{ backgroundColor: vs.surface, paddingBottom: bottomInset }}>
      <View style={{ height: DOCK_HEIGHT, flexDirection: 'row', alignItems: 'center' }}>
        {tabs.slice(0, 2).map((t) => (
          <Cell key={t.key} tab={t} active={active} onSelect={onSelect} />
        ))}

        {/* The column the centre button stands in. */}
        <View style={{ flex: 1 }} />

        {tabs.slice(2).map((t) => (
          <Cell key={t.key} tab={t} active={active} onSelect={onSelect} />
        ))}
      </View>

      <View
        style={{ position: 'absolute', left: 0, right: 0, top: -FAB_RISE, alignItems: 'center' }}
        pointerEvents="box-none"
      >
        <Pressable
          onPress={onSwap}
          onPressIn={() => setHeld(true)}
          onPressOut={() => setHeld(false)}
          accessibilityRole="button"
          accessibilityLabel="Move money"
        >
          <View
            style={{
              width: FAB_SIZE,
              height: FAB_SIZE,
              borderRadius: radius.full,
              backgroundColor: vs.green,
              alignItems: 'center',
              justifyContent: 'center',
              opacity: held ? 0.86 : 1,
              ...shadow.fab,
            }}
          >
            <Icon name="swap" size={20} color={vs.onGreen} strokeWidth={2.1} />
          </View>
        </Pressable>
      </View>
    </View>
  );
}

function Cell({
  tab,
  active,
  onSelect,
}: {
  tab: { key: TabKey; label: string };
  active: TabKey;
  onSelect?: (key: TabKey) => void;
}) {
  const on = tab.key === active;
  return (
    <Pressable
      onPress={() => onSelect?.(tab.key)}
      accessibilityRole="button"
      accessibilityLabel={tab.label}
      style={{ flex: 1 }}
    >
      <View style={{ alignItems: 'center' }}>
        <Icon
          name={tab.key}
          size={DOCK_ICON}
          color={on ? vs.ink : vs.muted}
          strokeWidth={on ? 2.1 : 1.8}
        />
        <T
          variant={on ? 'dockOn' : 'dock'}
          color={on ? vs.ink : vs.muted}
          style={{ marginTop: DOCK_LABEL_TOP }}
        >
          {tab.label}
        </T>
      </View>
    </Pressable>
  );
}
