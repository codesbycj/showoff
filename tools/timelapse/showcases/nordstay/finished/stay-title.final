import { View } from 'react-native';

import { stay } from '../data/stay';
import { ct } from '../theme';
import { Glyph } from './glyph';
import { T } from './text';

type Props = { margin: number; height: number };

/** The listing's name and its rating. */
export function StayTitle({ margin, height }: Props) {
  return (
    <View style={{ marginHorizontal: margin, height, justifyContent: 'center' }}>
      <T variant="title">{stay.title}</T>

      <View style={{ flexDirection: 'row', alignItems: 'center', gap: 6, marginTop: 2 }}>
        <Glyph name="star" size={15} color={ct.star} />
        <T variant="rating">
          {stay.rating.toFixed(2)} ({stay.reviews} reviews)
        </T>
      </View>
    </View>
  );
}
