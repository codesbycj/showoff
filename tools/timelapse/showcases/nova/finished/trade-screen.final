import { router } from 'expo-router';
import { StatusBar } from 'expo-status-bar';
import { Pressable, ScrollView, Text, View } from 'react-native';
import { useSafeAreaInsets } from 'react-native-safe-area-context';

import { DeltaPill, ScreenHead } from '@/features/nova/components/bits';
import { PriceChart, StatTile } from '@/features/nova/components/price-chart';
import { TRADE } from '@/features/nova/data/trade';
import { FONT, LEVEL, SP, TYPE, nv, novaTheme } from '@/features/nova/theme';

/**
 * Screen 4 — the Ethereum trade view.
 *
 * The only screen in the set without a dock: the reference pins a full-width
 * Sell button to the bottom instead, so the back button is the way out.
 *
 * The title wraps to two lines in the reference ("Trade" over "Ethereum"),
 * which is an artifact of its 438px render — the markup sets it on one line,
 * and that is what is built.
 */
/** The stat tiles, chunked into rows of two. */
const STAT_ROWS = TRADE.stats.reduce<(typeof TRADE.stats)[number][][]>((rows, stat, i) => {
  if (i % 2 === 0) rows.push([stat]);
  else rows[rows.length - 1].push(stat);
  return rows;
}, []);

export default function NovaTrade() {
  const insets = useSafeAreaInsets();

  return (
    <View style={[novaTheme, { flex: 1, backgroundColor: nv.surface }]}>
      <StatusBar style="dark" />

      <View style={{ paddingTop: insets.top + 8, paddingHorizontal: SP.margin }}>
        <ScreenHead title={TRADE.title} action="more" onBack={() => router.back()} />
      </View>

      <ScrollView
        showsVerticalScrollIndicator={false}
        contentContainerStyle={{ paddingHorizontal: SP.margin, paddingBottom: SP.md }}
      >
        <View
          style={{
            flexDirection: 'row',
            alignItems: 'flex-end',
            justifyContent: 'space-between',
            marginTop: SP.md,
            marginBottom: 12,
          }}
        >
          <View>
            <Text
              style={{ fontFamily: FONT.medium, fontSize: 13, lineHeight: 18, color: '#6b7280' }}
            >
              {TRADE.priceLabel}
            </Text>

            <View style={{ flexDirection: 'row', alignItems: 'center', gap: 10, marginTop: 4 }}>
              <Text style={[TYPE.balance, { color: nv.ink }]}>
                {TRADE.amount}
                <Text style={{ fontFamily: FONT.bold, fontSize: 20, color: nv.ink }}>
                  {TRADE.cents}
                </Text>
              </Text>
              <DeltaPill value={TRADE.delta} up />
            </View>
          </View>

          <Pressable onPress={() => router.push('/nova/wallet')} accessibilityRole="button">
            <View
              style={[
                {
                  backgroundColor: nv.blue,
                  paddingHorizontal: 24,
                  paddingVertical: 10,
                  borderRadius: 999,
                },
                LEVEL.blue,
              ]}
            >
              <Text
                style={{
                  fontFamily: FONT.semibold,
                  fontSize: 14,
                  lineHeight: 19,
                  color: '#ffffff',
                }}
              >
                {TRADE.buy}
              </Text>
            </View>
          </Pressable>
        </View>

        <View
          style={{
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'space-between',
            paddingVertical: SP.sm,
          }}
        >
          {TRADE.ranges.map((r) => {
            const on = r === TRADE.activeRange;

            return (
              <Pressable key={r} accessibilityRole="button">
                <View
                  style={[
                    {
                      paddingHorizontal: on ? 14 : 10,
                      paddingVertical: 4,
                      borderRadius: 999,
                    },
                    on && { backgroundColor: nv.lime },
                    on && LEVEL.sm,
                  ]}
                >
                  <Text
                    style={{
                      fontFamily: on ? FONT.bold : FONT.medium,
                      fontSize: 13,
                      lineHeight: 18,
                      color: on ? nv.ink : '#a3a3a3',
                    }}
                  >
                    {r}
                  </Text>
                </View>
              </Pressable>
            );
          })}
        </View>

        <View style={{ marginTop: SP.sm }}>
          <PriceChart />
        </View>

        {/* Two per row, taken in pairs off the flat list — so a tile is an
            entry in the data rather than a hard-coded index here. */}
        <View style={{ marginTop: SP.md, gap: 12 }}>
          {STAT_ROWS.map((row, i) => (
            <View key={i} style={{ flexDirection: 'row', gap: 12 }}>
              {row.map((stat) => (
                <StatTile key={stat.key} value={stat.value} label={stat.label} />
              ))}
              {row.length === 1 ? <View style={{ flex: 1 }} /> : null}
            </View>
          ))}
        </View>
      </ScrollView>

      <View
        style={{
          paddingHorizontal: SP.margin,
          paddingTop: SP.sm,
          paddingBottom: Math.max(insets.bottom, 16) + 8,
        }}
      >
        <Pressable onPress={() => router.push('/nova/activity')} accessibilityRole="button">
          <View
            style={[
              {
                backgroundColor: nv.ink,
                borderRadius: 999,
                paddingVertical: 18,
                alignItems: 'center',
              },
              LEVEL.card,
            ]}
          >
            <Text style={{ fontFamily: FONT.bold, fontSize: 15, lineHeight: 20, color: '#ffffff' }}>
              {TRADE.sell}
            </Text>
          </View>
        </Pressable>
      </View>
    </View>
  );
}
