import type { CoinKey } from '../theme';

/** Everything the activity screen says. */
export const ACTIVITY = {
  title: 'Activity',
  filters: ['All', 'Sent', 'Received', 'Trade', 'Staking'] as const,
} as const;

export type Entry = {
  key: string;
  coin: CoinKey;
  title: string;
  time: string;
  delta: string;
  deltaUp: boolean;
  /** The crypto amount, signed. */
  amount: string;
  /** The fiat value, and how it should be coloured. */
  value: string;
  valueTone: 'gain' | 'loss' | 'muted';
};

export type Group = { key: string; label: string; count: string; entries: Entry[] };

/**
 * The list, grouped by day. Grouping lives in the data rather than being
 * derived in the screen, because the reference's group labels are not all
 * dates — "Today" and "Yesterday" sit beside "October 24, 2024".
