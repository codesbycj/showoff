export type Verdict = 'true' | 'false' | 'unclear';

export type FactCheck = {
  key: string;
  claim: string;
  verdict: Verdict;
  detail: string;
  source: string;
};

/**
 * The fact-check rail.
 *
 * Its three verdicts are the one place this app puts a judgement on screen, so
 * they are the one place it spends full-strength colour on something that is
 * not a party — green, red and amber, each on its own pale wash, and each
 * carrying the word as well as the colour so the verdict survives a
 * screenshot, a colour-blind reader and a monochrome print.
 */
export const CHECKS: readonly FactCheck[] = [
  {
    key: 'result-sheets',
    claim: 'Result sheets from Kano were uploaded twice',
    verdict: 'false',
    detail: 'Two scans of the same sheet were filed; the tally counted it once.',
    source: 'Checked against the INEC upload log',
  },
  {
    key: 'turnout-claim',
    claim: 'Turnout passed 40% nationally for the first time since 2003',
    verdict: 'true',
    detail: 'Provisional turnout stands at 41.2% with 96.8% of units reporting.',
    source: 'Checked against returning-officer filings',
  },
  {
    key: 'deadline',
    claim: 'Collation must finish within 48 hours of the close of polls',
    verdict: 'unclear',
    detail: 'The guideline sets a target, not a statutory deadline, and allows extensions.',
    source: 'Checked against the 2026 election guidelines',
  },
];
