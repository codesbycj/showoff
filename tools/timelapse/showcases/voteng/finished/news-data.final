/**
 * The News tab's content.
 *
 * This screen has no reference render behind it — the Stitch export stopped at
 * home and results, and the News tab was a dead link in both. So it is designed
 * from the same system rather than measured off a capture: the type scale, the
 * radii, the card elevation and the chip shapes are the ones the two built
 * screens already use, and nothing new was invented for it except the verdict
 * palette, which is recorded in `theme.ts`.
 *
 * Every headline, outlet and timestamp here is fictional, and the photographs
 * are free-licensed stand-ins that do not illustrate the stories they carry.
 * See the note at the top of `assets/images/voteng/CREDITS.md`.
 */

export const NEWS_PAGE = {
  title: 'News',
  subtitle: 'Verified coverage, updated as results land',
  filters: ['All', 'Election', 'Politics', 'Fact check', 'Updates'] as const,
  topTitle: 'Top Stories',
  topAction: 'See all',
  factTitle: 'Fact Check',
  factAction: 'How we verify',
} as const;

export type Story = {
  key: string;
  tag: string;
  tagInk: string;
  title: string;
  /** Only the lead story carries a standfirst; the rows are headline-only. */
  blurb?: string;
  source: string;
  when: string;
  image: number;
};

/** The one story the screen opens on, given a full-bleed banner. */
