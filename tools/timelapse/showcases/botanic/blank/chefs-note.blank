import { Text, View } from 'react-native';

import { NOTE } from '../data/product';
import { alpha, type as t } from '../theme';
import { SectionHeading } from './section-heading';

/**
 * The culinary story.
 *
 * `leading-relaxed` on a 14dp face is a 22.75dp line — a fractional value that
 * is worth setting exactly rather than rounding to 23, because it compounds:
 * over the five lines this paragraph runs to, a quarter-point per line is more
 * than a point of drift by the last one, and everything below inherits it.
 */
export function ChefsNote() {
  return (
    <View style={{ gap: 8 }}>
{/* STEP 1.32 give it a heading
      <SectionHeading>{NOTE.heading}</SectionHeading>
*/}
{/* STEP 1.33 and the paragraph under it
      <Text
        style={{
          fontFamily: t.note.family,
          fontSize: t.note.size,
          lineHeight: t.note.line,
          color: alpha.noteInk,
        }}
      >
        {NOTE.body}
      </Text>
*/}
    </View>
  );
}
