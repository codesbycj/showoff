export type Row = {
  key: string;
  icon: SymbolName;
  title: string;
  subtitle: string;
  /** A row is either a switch, a badge or a plain disclosure. */
  kind: 'link' | 'toggle' | 'badge';
  on?: boolean;
  badge?: string;
  /** The green-tinted well the carbon-neutral row uses. */
  tint?: 'green';
};

export type Group = { key: string; label: string; rows: Row[] };

