/**
 * The zen face on the hero badge, in its own 36-unit box.
 *
 * Its blush is `#fecaca` — a rose that appears nowhere else in the palette and
 * has no token, so it is kept literally rather than forced into `PASTEL`.
 */
export const ZEN_FACE = {
  eyeL: 'M9 14C11 11.5 13 11.5 15 14',
  eyeR: 'M21 14C23 11.5 25 11.5 27 14',
  mouth: 'M14 22C16 24 20 24 22 22',
  blush: '#fecaca',
  stroke: mp.ink,
} as const;

/** The yellow the "Empathetic" pill on the profile screen sits on. */
export const EMPATHETIC = { fill: `${PASTEL.yellow.fill}4d`, ink: PASTEL.yellow.ink } as const;
