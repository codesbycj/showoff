import type { SymbolName } from '../symbols';
import { PASTEL, mp } from '../theme';

/**
 * The insights screen's content.
 *
 * This screen carries thirteen of the export's nineteen emoji — a lotus, a
 * herb, a sun, a shoe, a salad, a phone, a sandwich, a coffee, a bowl of pasta,
 * a target, a rain cloud and two sparkles — all set as literal text in a
 * `<span>`. Every one is replaced by the equivalent Material Symbol here, which
 * is the set the design specifies for its icons anyway.
 *
 * That is not a stylistic preference. An emoji is drawn by whichever font on
 * the device claims that codepoint: Segoe UI Emoji on Windows, Noto Color Emoji
 * on Android, Apple Color Emoji on iOS — three different pictures, one of them
 * flat and two of them coloured, at three different optical weights. The web
 * harness renders on one of those and so cannot show the difference, which
 * makes it precisely the class of problem that has to be designed out rather
 * than caught later.
 */

export const INSIGHTS = {
  title: 'Mindful Insights',
  badge: 'AI Coach',
  subtitle: 'Daily practices & emotional analysis',

  heroChip: '82% Emotional Harmony',
  heroEyebrow: 'AI Mindful Summary',
  heroBody:
    'Your calm energy spiked after afternoon meditation. Low stress detected throughout deep work.',
  /** The two context tags under the summary. `icon` replaces an emoji. */
  heroTags: [
    { key: 'calm', icon: 'selfImprovement' as SymbolName, label: 'Calm Peak • 3:20 PM' },
    { key: 'flow', icon: 'psychiatry' as SymbolName, label: 'Flow State: 2h 40m' },
  ],

  practicesTitle: 'Micro-Practices',
  practicesSub: 'Bite-sized moments for regulation',
  practicesCount: '3 Tailored',

  correlationTitle: 'Correlation Analysis',
  correlationSub: 'What lifted or drained your vibe this week',
  boostersTitle: 'Top Mood Boosters',
  boostersNote: 'Past 7 days',
  drainsTitle: 'Energy Drains',
  drainsNote: 'Patterns to rebalance',
  coachNote: 'Moving your walk before 10 AM magnified afternoon calm by nearly 1.5x.',

  reflectionTitle: 'Weekly Reflection',
  reflectionWeek: 'Week 42',
  reflectionPrompt: 'What brought you genuine peace this week?',
  reflectionSub: 'A moment where you felt fully present and content.',
  quickSelect: 'Quick Select',
  placeholder: 'Jot down a few words or tap a chip above...',
  privacy: 'Private to your diary',
  save: 'Save Note',
} as const;

export type Practice = {
  key: string;
  tag: string;
  meta: string;
  icon: SymbolName;
  title: string;
  body: string;
  /** The footnote, and the icon standing in for its emoji (null where none). */
  note: string;
  noteIcon: SymbolName | null;
  /** A leading dot instead of an icon, on the first card only. */
  noteDot?: string;
  action: string;
  actionIcon: SymbolName;
  /** True where the action is the obsidian pill rather than the white one. */
  primary?: boolean;
  fill: string;
  ink: string;
  inkSoft: string;
};

