import { LinearGradient } from 'expo-linear-gradient';
import { Image, View } from 'react-native';

import { hero } from '../data/start';
import { ct } from '../theme';

type Props = { width: number; height: number; scrimH: number };

/**
 * The photograph, and the scrim that makes the copy readable on it.
 *
 * **This is the page's own ground** (§5.5), so it may paint in frame one — like
 * the gradient backgrounds several of these designs use. Everything else is
 * staged over it.
 *
 * The `Image` carries explicit numeric width and height: absolute insets alone
 * make an `Image` paint nothing on native, silently (Part 7).
 *
 * The scrim runs top to bottom, which `expo-linear-gradient` handles; only a
 * *diagonal* is mirrored on web (Part 7). Without it the body copy sits at
 * about 3:1 on the photograph and fails R4 — and R4 says a design shot is not
 * an authority on contrast.
 */
export function HeroFrame({ width, height, scrimH }: Props) {
  return (
    <View style={{ position: 'absolute', top: 0, left: 0, width, height }}>
      {/* STEP 1.02 image
      <Image source={hero} style={{ width, height }} resizeMode="cover" />
      */}
      {/* STEP 1.03 linear gradient
      <LinearGradient
        colors={[ct.scrimTop, ct.scrimMid, ct.scrimBottom]}
        locations={[0, 0.55, 1]}
        style={{ position: 'absolute', left: 0, right: 0, bottom: 0, height: scrimH }}
        pointerEvents="none"
      />
      */}
    </View>
  );
}
