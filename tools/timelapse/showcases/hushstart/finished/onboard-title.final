import { View } from 'react-native';

import { onboarding } from '../data/onboarding';
import { T } from './text';

type Props = { margin: number; height: number };

/**
 * The promise - the dominant line on the screen (R8).
 *
 * Its two lines are two elements rather than one string with a newline in it:
 * the reveal paints one element per step, and a two-line display that lands
 * whole is the biggest thing on the screen arriving in one beat (I9).
 */
export function OnboardTitle({ margin, height }: Props) {
  return (
    <View style={{ marginHorizontal: margin, height, justifyContent: 'flex-end' }}>
      <T variant="display">{onboarding.displayTop}</T>
      <T variant="display">{onboarding.displayBottom}</T>
    </View>
  );
}
