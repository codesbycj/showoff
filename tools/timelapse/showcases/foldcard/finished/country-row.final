import { Pressable, View } from 'react-native';

import { country } from '../data/card';
import { ct } from '../theme';
import { Glyph } from './glyph';
import { T } from './text';

type Props = { margin: number; width: number; height: number; radius: number };

/**
 * Where the card is issued.
 *
 * **The flag is drawn, not an emoji.** Emoji flags differ across Windows,
 * Android and iOS and are missing outright on Windows, so shipping one as UI
 * is shipping a blank box to a third of the devices (I8).
 *
 * The disc is the middle band with the outer two laid **inside** it, rather
 * than three bands side by side: three adjacent boxes share their edges, and a
 * shared edge is what `audit.js` reports as a partial overlap. A child wholly
 * inside its parent is layering by design and is ignored (R3).
 *
 * The row's fill is on the row itself: this component is one staged block, so
 * there is no container left behind to paint an empty strip (I9).
 */
export function CountryRow({ margin, width, height, radius }: Props) {
  return (
    <Pressable accessibilityRole="button" accessibilityLabel={`Country: ${country.label}`}>
      <View
        style={{
          marginHorizontal: margin,
          width,
          height,
          borderRadius: radius,
          flexDirection: 'row',
          alignItems: 'center',
          justifyContent: 'space-between',
          paddingHorizontal: 18,
          backgroundColor: ct.card,
        }}
      >
        <View style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
          <View
            style={{
              width: 24,
              height: 24,
              borderRadius: 12,
              overflow: 'hidden',
              backgroundColor: '#F4F4F2',
            }}
          >
            <View
              style={{
                position: 'absolute',
                left: 0,
                top: 0,
                bottom: 0,
                width: 8,
                backgroundColor: '#118050',
              }}
            />
            <View
              style={{
                position: 'absolute',
                right: 0,
                top: 0,
                bottom: 0,
                width: 8,
                backgroundColor: '#C8273B',
              }}
            />
          </View>

          <T variant="fieldValue">{country.label}</T>
        </View>

        <Glyph name="chevronDown" size={16} color={ct.muted} strokeWidth={1.8} />
      </View>
    </Pressable>
  );
}
