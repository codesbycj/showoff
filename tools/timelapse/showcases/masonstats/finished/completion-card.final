import { View } from 'react-native';
import Svg, { Circle } from 'react-native-svg';

import { completion, copy, weeks } from '../data/start';
import { CARD_PAD, CARD_TOP, DONE_HEIGHT } from '../layout';
import { ms, radius, type } from '../theme';
import { BarChart } from './bar-chart';
import { T } from './text';

/**
 * How far through the project is.
 *
 * The figure is `completion`, computed from the same work list the home
 * screen carries. The reference prints 72% there and 66% here for the same
 * measurement — a dashboard whose headline contradicts itself two screens
 * apart is worse than one with no headline.
 */
export function CompletionCard() {
  return (
    <View
      style={{
        height: DONE_HEIGHT,
        marginTop: CARD_TOP,
        borderRadius: radius.card,
        backgroundColor: ms.card,
        padding: CARD_PAD,
        shadowColor: '#2A1B12',
        shadowOpacity: 0.08,
        shadowRadius: 18,
        shadowOffset: { width: 0, height: 8 },
        elevation: 4,
      }}
    >
      <View style={{ flexDirection: 'row', alignItems: 'center' }}>
        <T variant="cardTitle" color={ms.ink} style={{ flex: 1, height: type.cardTitle.line }}>
          {copy.overall}
        </T>
        <Svg width={18} height={18} viewBox="0 0 24 24">
          <Circle cx={6} cy={12} r={1.6} fill={ms.faint} />
          <Circle cx={12} cy={12} r={1.6} fill={ms.faint} />
          <Circle cx={18} cy={12} r={1.6} fill={ms.faint} />
        </Svg>
      </View>

      <View style={{ flex: 1, flexDirection: 'row', alignItems: 'flex-end' }}>
        <View style={{ flex: 1 }}>
          <View style={{ flexDirection: 'row', alignItems: 'flex-start' }}>
            <T variant="big" color={ms.ink} style={{ height: type.big.line }}>
              {String(completion)}
            </T>
            <T
              variant="bigUnit"
              color={ms.ink}
              style={{ marginTop: 10, height: type.bigUnit.line }}
            >
              %
            </T>
          </View>
          <T variant="sub" color={ms.muted} style={{ height: type.sub.line }}>
            {copy.completionLabel}
          </T>
          <View
            style={{
              flexDirection: 'row',
              alignItems: 'center',
              alignSelf: 'flex-start',
              marginTop: 8,
              paddingHorizontal: 10,
              paddingVertical: 5,
              borderRadius: radius.chip,
              backgroundColor: ms.well,
            }}
          >
            <Svg width={8} height={8} viewBox="0 0 8 8">
              <Circle cx={4} cy={4} r={4} fill={ms.green} />
            </Svg>
            <T variant="chip" color={ms.ink} style={{ marginLeft: 6, height: type.chip.line }}>
              {copy.onTrack}
            </T>
          </View>
        </View>

        <BarChart values={weeks} w={140} h={88} />
      </View>
    </View>
  );
}
