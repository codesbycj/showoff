import Package from 'lucide-react-native/icons/package';
import ChevronRight from 'lucide-react-native/icons/chevron-right';
import { Pressable, View } from 'react-native';

import { T } from './text';
import { BUTTON_HEIGHT, DISC, DISC_INSET } from '../layout';
import { radius, shadow, cg } from '../theme';

/**
 * The call to action: a white pill with a dark disc at one end and a run of
 * chevrons at the other.
 *
 * **The label is centred on the button, not between the two ornaments.** The
 * disc and the chevrons are different widths, so laying all three out in a row
 * would push "Get Started" off-centre by the difference. Both are positioned
 * absolutely against the pill instead and the label centres in the full width,
 * which is what the reference does and what survives a change to either
 * ornament.
 *
 * The visual box is on an inner `View`, not on the `Pressable`: a `Pressable`
 * given a function style renders with no style at all in a static web render,
 * which is what the preview harness takes — the button silently loses its
 * height and its fill.
 *
 * Lucide icons are imported one per subpath. The package barrel pulls in every
 * icon it ships; `lucide-react-native/icons/x` is a single module and is in
 * the package's own export map, types included.
 */
export function StartButton({ label, onPress }: { label: string; onPress?: () => void }) {
  return (
    <Pressable onPress={onPress} accessibilityRole="button" accessibilityLabel={label}>
      <View
        style={{
          height: BUTTON_HEIGHT,
          borderRadius: radius.full,
          backgroundColor: cg.surface,
          alignItems: 'center',
          justifyContent: 'center',
          ...shadow.button,
        }}
      >
        <T variant="cta" color={cg.onSurface}>
          {label}
        </T>

        <View
          style={{
            position: 'absolute',
            left: DISC_INSET,
            width: DISC,
            height: DISC,
            borderRadius: radius.full,
            backgroundColor: cg.onSurface,
            alignItems: 'center',
            justifyContent: 'center',
          }}
        >
          <Package size={21} color={cg.discGlyph} strokeWidth={1.9} />
        </View>

        {/*
          Three chevrons, fading as they go, rather than Lucide's
          `chevrons-right` — which draws two of equal weight. The reference's
          run of three reads as motion because each one is lighter than the
          last, and a pair at full strength reads as a fast-forward button.

          They are overlapped by a negative margin so they nest the way a
          drawn run would, instead of sitting as three separate arrows.
        */}
        <View style={{ position: 'absolute', right: 18, flexDirection: 'row' }}>
          {[1, 0.55, 0.28].map((opacity, i) => (
            <View key={opacity} style={{ marginLeft: i === 0 ? 0 : -7, opacity }}>
              <ChevronRight size={20} color={cg.onSurface} strokeWidth={2.4} />
            </View>
          ))}
        </View>
      </View>
    </Pressable>
  );
}
