import { Image, Pressable, View } from 'react-native';
import Svg, { Path } from 'react-native-svg';

import { copy, courier } from '../data/start';
import { COURIER_DISC, COURIER_HEIGHT } from '../layout';
import { cr, radius, type } from '../theme';
import { T } from './text';

/**
 * Who is carrying it, and the two ways to reach them.
 *
 * The call and the chat are separate 44dp discs rather than one control with
 * two halves: they do different things, and a bar that is a single target
 * sends half the taps to the wrong one.
 *
 * The courier is a photograph, per AGENTS.md — a face is a picture, not an
 * icon — with numeric width and height.
 */
export function CourierBar({ onCall, onChat }: { onCall?: () => void; onChat?: () => void }) {
  const disc = (fill: string) => ({
    width: COURIER_DISC,
    height: COURIER_DISC,
    marginLeft: 10,
    borderRadius: radius.pill,
    backgroundColor: fill,
    alignItems: 'center' as const,
    justifyContent: 'center' as const,
  });

  return (
    <View
      style={{
        height: COURIER_HEIGHT,
        flexDirection: 'row',
        alignItems: 'center',
        paddingHorizontal: 14,
      }}
    >
      <Image
        source={courier}
        style={{ width: COURIER_DISC, height: COURIER_DISC, borderRadius: radius.pill }}
        accessibilityIgnoresInvertColors
      />
      <T
        variant="courier"
        color={cr.onPanel}
        style={{ flex: 1, marginLeft: 11, height: type.courier.line }}
      >
        {copy.courier}
      </T>

      <Pressable onPress={onCall} accessibilityRole="button" accessibilityLabel="Call the courier">
        <View style={disc(cr.panelSoft)}>
          <Svg width={19} height={19} viewBox="0 0 24 24">
            <Path
              d="M6.6 3.6h3l1.6 4-2 1.4a12 12 0 0 0 5.8 5.8l1.4-2 4 1.6v3a2 2 0 0 1-2.2 2A16.6 16.6 0 0 1 4.6 5.8a2 2 0 0 1 2-2.2Z"
              fill={cr.onPanel}
            />
          </Svg>
        </View>
      </Pressable>

      <Pressable
        onPress={onChat}
        accessibilityRole="button"
        accessibilityLabel="Message the courier"
      >
        <View style={disc(cr.orange)}>
          <Svg width={19} height={19} viewBox="0 0 24 24">
            <Path
              d="M4 6.4a2.4 2.4 0 0 1 2.4-2.4h11.2A2.4 2.4 0 0 1 20 6.4v7.2a2.4 2.4 0 0 1-2.4 2.4H9.6L5 19.6V16a1 1 0 0 1-1-1Z"
              fill={cr.onOrange}
            />
          </Svg>
        </View>
      </Pressable>
    </View>
  );
}
