import { View } from 'react-native';
import Svg, { Path, Rect } from 'react-native-svg';

import { sticker } from '../data/cam';
import { STICKER } from '../layout';
import { hk, radius } from '../theme';
import { T } from './text';

/**
 * The promo sticker in the corner of the picture.
 *
 * The zig-zag band is drawn, because it is a flat mark and the alternative is
 * a bitmap that would have to be re-cut for every size. It runs behind the
 * type rather than round it: the reference's zig-zags cross the disc edge to
 * edge and the words sit on top.
 *
 * The italic second line is a **skew**, not an italic face. Poppins ships one,
 * but React Native resolves a face by family name and would need a separate
 * registration for a single word; a 14-degree `skewX` is the same shape and
 * no asset (AGENTS.md note on synthetic italic).
 */
export function StickerBadge() {
  return (
    <View
      style={{ width: STICKER, height: STICKER, alignItems: 'center', justifyContent: 'center' }}
    >
      {/* The zig-zags are clipped by a round View, not by an SVG clip path.
          `ClipPath` needs an id, and react-native-svg's ids are
          document-global on web, so two of them on one page collide; a
          rounded parent needs none. Safe here because nothing carries
          `elevation`. */}
      {/* STEP 1.04 the zig-zags
      <View
        style={{
          position: 'absolute',
          width: STICKER,
          // MISTAKE 1.10 the sticker came in square
          borderWidth: 6,
          height: STICKER,
          borderRadius: radius.full,
          backgroundColor: hk.sticker,
          overflow: 'hidden',
        }}
      >
        <Svg width={STICKER} height={STICKER} viewBox="0 0 100 100">
          {[10, 28, 72, 90].map((y) => (
            <Path
              key={y}
              d={`M-6 ${y} L8 ${y - 9} L22 ${y} L36 ${y - 9} L50 ${y} L64 ${y - 9} L78 ${y} L92 ${y - 9} L106 ${y}`}
              stroke={hk.stickerZag}
              strokeWidth={6}
              fill="none"
            />
          ))}
        </Svg>
      </View>
      */}

      <View style={{ alignItems: 'center' }}>
        {/* STEP 1.05 and the words on them
        <T variant="sticker" color={hk.stickerInk}>
          {sticker.line}
        </T>
        */}
        <T
          variant="stickerSub"
          color={hk.stickerAccent}
          style={{ transform: [{ skewX: '-14deg' }] }}
        >
          {sticker.sub}
        </T>
      </View>
    </View>
  );
}

/** The grid control at the top of the picture. */
export function GridMark({ size }: { size: number }) {
  return (
    <Svg width={size} height={size} viewBox="0 0 24 24">
      {[
        [3, 3],
        [13.5, 3],
        [3, 13.5],
        [13.5, 13.5],
      ].map(([x, y]) => (
        <Rect key={`${x}-${y}`} x={x} y={y} width={7.5} height={7.5} rx={2.2} fill={hk.ink} />
      ))}
    </Svg>
  );
}

/** The like mark at the left of the bar. Drawn: an emoji heart differs per platform. */
export function Heart({ size }: { size: number }) {
  return (
    <Svg width={size} height={size * 0.9} viewBox="0 0 20 18">
      <Path
        d="M10 17 C2 11.6 0 8.3 0 5.4 C0 2.4 2.2 0.4 5 0.4 C7 0.4 8.9 1.6 10 3.4 C11.1 1.6 13 0.4 15 0.4 C17.8 0.4 20 2.4 20 5.4 C20 8.3 18 11.6 10 17 Z"
        fill={hk.ink}
      />
    </Svg>
  );
}

/** The send mark in the disc at the right of the bar. */
export function Send({ size }: { size: number }) {
  return (
    <Svg width={size} height={size} viewBox="0 0 24 24">
      <Path d="M21.4 3.2 L2.6 10.4 L10 13 L12.6 20.8 Z" fill={hk.ink} />
      <Path d="M10 13 L21.4 3.2" stroke={hk.glass} strokeWidth={1.4} />
    </Svg>
  );
}

/** The radius token, re-exported so the screen does not import the theme twice. */
export const STICKER_RADIUS = radius.full;
