import { Pressable, View } from 'react-native';

import { account } from '../data/home';
import { ct } from '../theme';
import { Glyph } from './glyph';
import { T } from './text';

type Props = { margin: number; height: number };

/** The greeting and the notification bell. */
export function HomeHeader({ margin, height }: Props) {
  return (
    <View
      style={{
        marginHorizontal: margin,
        height,
        flexDirection: 'row',
        alignItems: 'center',
        justifyContent: 'space-between',
      }}
    >
      <View>
        <T variant="greeting">{account.greeting}</T>
        <T variant="title">{account.title}</T>
      </View>

      <Pressable
        accessibilityRole="button"
        accessibilityLabel="Notifications"
        hitSlop={{ top: 10, bottom: 10, left: 10, right: 10 }}
      >
        <View
          style={{
            width: 44,
            height: 44,
            borderRadius: 22,
            backgroundColor: ct.card,
            alignItems: 'center',
            justifyContent: 'center',
          }}
        >
          <Glyph name="bell" size={20} color={ct.ink} strokeWidth={1.7} />
        </View>
      </Pressable>
    </View>
  );
}
