import { useWindowDimensions, View } from 'react-native';

import { brand, tags } from '../data/signin';
import { MARGIN, PILL_HEIGHT, PILL_PAD } from '../layout';
import { radius, shadow, wv } from '../theme';
import { T } from './text';

/**
 * The throw of category pills at the top of the screen.
 *
 * Positions come from the data as fractions of the page, so the arrangement
 * keeps its shape on a 360dp phone as well as a 430dp one — a cluster laid out
 * in dp slides off the narrow one and leaves a hole on the wide one.
 *
 * **Each pill anchors to a side rather than always to the left.** Placing
 * every pill by a `left` fraction bunched the throw down the left edge and let
 * a long label on a right-hand pill run off the screen, because a pill is as
 * wide as its words and nothing knows that in advance. A right-anchored pill
 * is positioned by `right`, so it cannot overflow whatever it says, and the
 * two sides alternate down an even vertical rhythm — which is what makes it
 * read as a scatter instead of a list.
 *
 * The pills are written out rather than mapped so the reveal can land them one
 * at a time: on a screen with four elements, the throw arriving pill by pill
 * is most of the build (AGENTS.md, "composite components are staged internally
 * so a row fills in one item at a time").
 *
 * Each pill is rotated about its own centre, which is the only pivot React
 * Native offers whatever `transformOrigin` says. That is the right pivot here:
 * a tag thrown onto a table turns about itself.
 *
 * The cluster's height is given by the caller rather than measured, because
 * the screen already knows what it can spare — and a measured height would
 * cost a second render pass and a frame of the pills stacked at the top,
 * which is exactly the frame a screenshot catches.
 */
export function TagCluster({ height }: { height: number | `${number}%` }) {
  const { width, height: screen } = useWindowDimensions();
  const span = width - MARGIN * 2;
  /** Percent heights cannot be multiplied, so the throw is placed against the
   *  window's own height when the caller hands the cluster the whole slot. */
  const spanY = typeof height === 'number' ? height : screen * 0.46;

  const at = (t: { from: 'left' | 'right'; x: number; y: number; angle: number }) => ({
    from: t.from,
    offset: span * t.x,
    top: spanY * t.y,
    angle: t.angle,
  });

  return (
    <View style={{ height }}>
      <Pill
        label={brand.label}
        color={wv.brand}
        ink={wv.onBrand}
        variant="brand"
        raised
        {...at(brand)}
      />
      <Pill
        label={tags[0].label}
        color={tags[0].color}
        ink={wv.onTag}
        variant="tag"
        {...at(tags[0])}
      />
      <Pill
        label={tags[1].label}
        color={tags[1].color}
        ink={wv.onTag}
        variant="tag"
        {...at(tags[1])}
      />
      <Pill
        label={tags[2].label}
        color={tags[2].color}
        ink={wv.onTag}
        variant="tag"
        {...at(tags[2])}
      />
      <Pill
        label={tags[3].label}
        color={tags[3].color}
        ink={wv.onTag}
        variant="tag"
        {...at(tags[3])}
      />
      <Pill
        label={tags[4].label}
        color={tags[4].color}
        ink={wv.onTag}
        variant="tag"
        {...at(tags[4])}
      />
    </View>
  );
}

function Pill({
  label,
  color,
  ink,
  variant,
  from,
  offset,
  top,
  angle,
  raised,
}: {
  label: string;
  color: string;
  ink: string;
  variant: 'brand' | 'tag';
  from: 'left' | 'right';
  offset: number;
  top: number;
  angle: number;
  raised?: boolean;
}) {
  return (
    <View
      style={{
        position: 'absolute',
        ...(from === 'left' ? { left: offset } : { right: offset }),
        top,
        height: PILL_HEIGHT,
        paddingHorizontal: PILL_PAD,
        borderRadius: radius.pill,
        backgroundColor: color,
        alignItems: 'center',
        justifyContent: 'center',
        transform: [{ rotate: `${angle}deg` }],
        ...(raised ? shadow.pill : null),
      }}
    >
      <T variant={variant} color={ink}>
        {label}
      </T>
    </View>
  );
}
