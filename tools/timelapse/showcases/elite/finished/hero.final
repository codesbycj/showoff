import { Image, View } from 'react-native';

import { HERO } from '../data/onboarding';
import { HERO_HEIGHT } from '../layout';

/**
 * The photograph at the top of the screen.
 *
 * One flat asset and one draw. The reference lays a cut-out stylist on a mauve
 * wash that fades to white where the page begins; here the wash and the fade
 * are **baked into the file** by `tools/bake/elite.py` rather than layered at
 * runtime.
 *
 * That is a deliberate trade. `expo-linear-gradient` could do the fade live,
 * but the hero would then be three stacked views whose order and opacity have
 * to stay right on two platforms, and the tint on top of them wants a blend
 * mode React Native does not have. Baked, there is no boundary for anything to
 * line up with and nothing to get wrong on a device the harness cannot see.
 *
 * It runs full-bleed under the status bar rather than starting below it. The
 * photograph is the first thing on the page, and a band of inset white above
 * it reads as a mistake.
 */
export function Hero() {
  return (
    <View style={{ height: HERO_HEIGHT }}>
      <Image
        source={HERO}
        style={{ width: '100%', height: '100%' }}
        resizeMode="cover"
        accessibilityIgnoresInvertColors
        accessible
        accessibilityRole="image"
        accessibilityLabel="A stylist at work in the salon"
      />
    </View>
  );
}
