import { Pressable, View } from 'react-native';
import Svg, { Path, Rect } from 'react-native-svg';

import { cards } from '../data/home';
import { CARD_HEIGHT, CARD_PAD, CARD_PEEK } from '../layout';
import { radius, tl, type } from '../theme';
import { Glyph } from './glyph';
import { T } from './text';

/**
 * The wallet: the card you are paying with, and the ones under it.
 *
 * **The scheme mark is invented.** The reference prints VISA on two of its
 * cards and Mastercard's interlocking discs on the third; those are other
 * companies' trademarks and this page is branded as an app that is not
 * theirs, so the cards carry a mark of this project's instead — two offset
 * bars, drawn, in the same corner at the same size.
 *
 * **The cards behind are strips, not full cards pulled up.** The first attempt
 * rendered three full cards and pulled each one up over the last, which puts
 * the *later* siblings on top — React Native paints in document order, so the
 * card you are paying with ended up underneath the two behind it and lost its
 * expiry, its holder and its button. A card that is not the front one is only
 * ever its own top edge, so it is drawn as exactly that.
 *
 * `overflow: 'hidden'` and `elevation` are kept off the same `View`, which is
 * unreliable on Android.
 */
function SchemeMark({ tint }: { tint: string }) {
  return (
    <Svg width={46} height={16} viewBox="0 0 46 16">
      <Rect x={0} y={3} width={20} height={10} rx={5} fill={tint} />
      <Path d="M24 13 32 3h4l-8 10Z" fill={tint} />
      <Rect x={36} y={3} width={10} height={10} rx={5} fill={tint} opacity={0.75} />
    </Svg>
  );
}

export function CardStack() {
  const fill = (tone: string) =>
    tone === 'violet' ? tl.violet : tone === 'coral' ? tl.coral : tl.lime;
  const ink = (tone: string) => (tone === 'lime' ? tl.ink : tl.onNavy);

  return (
    <View>
