            style={{ marginTop: front ? 0 : 0 }}
          >
            <View
              style={{
                height: front ? CARD_HEIGHT : CARD_PEEK,
                borderRadius: radius.card,
                backgroundColor: fill(c.tone),
                paddingHorizontal: CARD_PAD,
                paddingTop: front ? 22 : 18,
              }}
            >
              <View style={{ flexDirection: 'row', alignItems: 'center' }}>
                <T variant="pan" color={ink(c.tone)} style={{ flex: 1, height: type.pan.line }}>
                  {c.pan}
                </T>
