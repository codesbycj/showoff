import { StatusBar } from 'expo-status-bar';
import { useId } from 'react';
import { Pressable, View, useWindowDimensions } from 'react-native';
import Svg, { Defs, Path, RadialGradient, Rect, Stop } from 'react-native-svg';

import { RewardBadge, Sparkles } from '@/features/lootwin/components/badge';
import { T } from '@/features/lootwin/components/text';
import { copy } from '@/features/lootwin/data/win';
import { ct, radius, type } from '@/features/lootwin/theme';
import { useInsets } from '@/features/lootwin/use-insets';

const MARGIN = 24;

/** The rays behind the badge, drawn as wedges from the centre. */
function Rays({ size }: { size: number }) {
  const wedges = Array.from({ length: 12 }).map((_, i) => {
    const a0 = (Math.PI / 6) * i;
    const a1 = a0 + Math.PI / 12;
    const r = size;
    const c = size / 2;
    return `M${c} ${c} L${c + r * Math.cos(a0)} ${c + r * Math.sin(a0)} L${c + r * Math.cos(a1)} ${c + r * Math.sin(a1)} Z`;
  });
  return (
    <Svg width={size} height={size} style={{ position: 'absolute' }}>
      {wedges.map((d, i) => (
        <Path key={i} d={d} fill={ct.rays} />
      ))}
    </Svg>
  );
}

/** The bell on the announcement pill. */
function Bell({ tint }: { tint: string }) {
  return (
    <Svg width={14} height={14} viewBox="0 0 24 24">
      <Path d="M18 9.2a6 6 0 1 0-12 0c0 5-1.4 6.4-1.4 6.4h14.8S18 14.2 18 9.2Z" fill={tint} />
      <Path
        d="M13.7 19a2 2 0 0 1-3.4 0"
        stroke={tint}
        strokeWidth={1.8}
        fill="none"
        strokeLinecap="round"
      />
    </Svg>
  );
}

/**
 * Loot — you won something.
 *
 * Assembly only: the badge, what happened, what is coming, and the two ways
 * on.
 *
 * The badge sits in the screen's one flexible band, so the slack has a
 * single place to go. The rays behind it are drawn rather than bitmapped:
 * twelve wedges from the centre, which is what they are.
 */
export default function LootwinScreen() {
  const insets = useInsets();
  const { width } = useWindowDimensions();
  const glow = `lootGlow-${useId()}`;
  const stage = Math.min(width, 360);

  return (
    <View style={{ flex: 1, backgroundColor: ct.ground }}>
      <StatusBar style="light" />

      <View
        style={{
          flex: 1,
          paddingTop: insets.top + 8,
          paddingBottom: insets.bottom + 10,
          paddingHorizontal: MARGIN,
        }}
      >
        <View
          style={{
            flex: 1,
            alignItems: 'center',
            justifyContent: 'center',
            minHeight: 240,
          }}
        >
          <View
            style={{ width: stage, height: stage, alignItems: 'center', justifyContent: 'center' }}
          >
            <Rays size={stage} />
            <Svg width={stage} height={stage} style={{ position: 'absolute' }}>
              <Defs>
                <RadialGradient id={glow} cx="0.5" cy="0.5" r="0.5">
                  <Stop offset="0" stopColor={ct.ground} stopOpacity="0" />
                  <Stop offset="0.72" stopColor={ct.ground} stopOpacity="0.7" />
                  <Stop offset="1" stopColor={ct.ground} stopOpacity="1" />
                </RadialGradient>
              </Defs>
              <Rect x="0" y="0" width={stage} height={stage} fill={`url(#${glow})`} />
            </Svg>
            <Sparkles box={stage} />
            <RewardBadge size={stage * 0.56} />
          </View>
        </View>

        <T variant="headline" color={ct.onGround} style={{ textAlign: 'center' }}>
          {copy.headline}
        </T>

        <T
          variant="body"
          color={ct.dim}
          style={{ textAlign: 'center', marginTop: 12, paddingHorizontal: 6 }}
        >
          {copy.body}
        </T>

        <View
          style={{
            marginTop: 26,
            borderRadius: radius.card,
            backgroundColor: ct.violetDeep,
            padding: 16,
          }}
        >
          <View
            style={{
              alignSelf: 'flex-start',
              flexDirection: 'row',
              alignItems: 'center',
              height: 30,
              paddingHorizontal: 12,
              borderRadius: 15,
              backgroundColor: 'rgba(255,255,255,0.16)',
            }}
          >
            <Bell tint={ct.onViolet} />
            <T variant="pill" color={ct.onViolet} style={{ height: type.pill.line, marginLeft: 6 }}>
              {copy.pill}
            </T>
          </View>

          <T
            variant="cardTitle"
            color={ct.onViolet}
            style={{ height: type.cardTitle.line, marginTop: 14 }}
          >
            {copy.cardTitle}
          </T>
          <T variant="cardBody" color="rgba(255,255,255,0.84)" style={{ marginTop: 4 }}>
            {copy.cardBody}
          </T>
        </View>

        <View style={{ flexDirection: 'row', marginTop: 18 }}>
          <Pressable accessibilityRole="button" accessibilityLabel={copy.keep} style={{ flex: 1 }}>
            {({ pressed }) => (
              <View
                style={{
                  height: 56,
                  borderRadius: radius.cta,
                  backgroundColor: ct.slate,
                  alignItems: 'center',
                  justifyContent: 'center',
                  opacity: pressed ? 0.9 : 1,
                }}
              >
                <T variant="cta" color={ct.onGround} style={{ height: type.cta.line }}>
                  {copy.keep}
                </T>
              </View>
            )}
          </Pressable>

          <View style={{ width: 12 }} />

          <Pressable accessibilityRole="button" accessibilityLabel={copy.view} style={{ flex: 1 }}>
            {({ pressed }) => (
              <View
                style={{
                  height: 56,
                  borderRadius: radius.cta,
                  backgroundColor: '#FFFFFF',
                  alignItems: 'center',
                  justifyContent: 'center',
                  opacity: pressed ? 0.9 : 1,
                }}
              >
                <T variant="cta" color={ct.ground} style={{ height: type.cta.line }}>
                  {copy.view}
                </T>
              </View>
            )}
          </Pressable>
        </View>
      </View>
    </View>
  );
}
