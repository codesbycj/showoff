import { StatusBar } from 'expo-status-bar';
import { Pressable, ScrollView, View } from 'react-native';

import { BikeCard } from '@/features/spokecats/components/bike-card';
import { Glyph } from '@/features/spokecats/components/glyph';
import { T } from '@/features/spokecats/components/text';
import { TopBar } from '@/features/spokecats/components/top-bar';
import { bikes, chips, copy } from '@/features/spokecats/data/bikes';
import {
  CARD_GAP,
  CARDS_TOP,
  CHIP_HEIGHT,
  CHIPS_TOP,
  HEADER_TOP,
  MARGIN,
  TITLE_TOP,
} from '@/features/spokecats/layout';
import { radius, shadow, sp, type } from '@/features/spokecats/theme';
import { useInsets } from '@/features/spokecats/use-insets';

/**
 * Spoke — the categories screen.
 *
 * Assembly only: the menu and who is riding, what the screen is, how to
 * narrow it, and the bikes themselves — over a scroll.
 *
 * The chips are a rail rather than a wrap: the reference shows one clipped by
 * the right edge, and only a scroller can do that. The rail carries the page
 * margin in its content padding so the first chip lines up with the heading
 * and the last can still overhang.
 */
export default function SpokecatsScreen() {
  const insets = useInsets();

  return (
    <View style={{ flex: 1, backgroundColor: sp.canvas }}>
      <StatusBar style="dark" />

      <ScrollView
        showsVerticalScrollIndicator={false}
        contentContainerStyle={{
          paddingTop: insets.top + HEADER_TOP,
          paddingBottom: insets.bottom + 16,
        }}
      >
        <View style={{ paddingHorizontal: MARGIN }}>
          <TopBar />

          <View style={{ flexDirection: 'row', alignItems: 'center', marginTop: TITLE_TOP }}>
            <T variant="display" color={sp.ink} style={{ flex: 1, height: type.display.line }}>
              {copy.title}
            </T>
            <Pressable accessibilityRole="button" accessibilityLabel="Search">
              <View
                style={{
                  width: 44,
                  height: 44,
                  borderRadius: radius.control,
                  backgroundColor: sp.card,
                  alignItems: 'center',
                  justifyContent: 'center',
                  ...shadow.card,
                }}
              >
                <Glyph name="search" size={19} tint={sp.ink} />
              </View>
            </Pressable>
          </View>
        </View>

        <ScrollView
          horizontal
          showsHorizontalScrollIndicator={false}
          style={{ marginTop: CHIPS_TOP }}
          contentContainerStyle={{ paddingHorizontal: MARGIN }}
        >
          {chips.map((c, i) => (
            <View
              key={c.id}
              style={{
                height: CHIP_HEIGHT,
                paddingHorizontal: 20,
                marginLeft: i === 0 ? 0 : 10,
                borderRadius: radius.pill,
                backgroundColor: c.on ? sp.lime : sp.card,
                alignItems: 'center',
                justifyContent: 'center',
              }}
            >
              <T variant="chip" color={sp.ink} style={{ height: type.chip.line }}>
                {c.label}
              </T>
            </View>
          ))}
        </ScrollView>

        <View style={{ paddingHorizontal: MARGIN }}>
          {bikes.map((b, i) => (
            <View key={b.id} style={{ marginTop: i === 0 ? CARDS_TOP : CARD_GAP }}>
              <BikeCard name={b.name} usage={b.usage} battery={b.battery} src={b.src} />
            </View>
          ))}
        </View>
      </ScrollView>
    </View>
  );
}
