import { Image, View, type ImageSourcePropType } from 'react-native';

import { RoundButton } from './round-button';
import { T } from './text';
import { AGENT_BUTTON, AVATAR, AVATAR_RING } from '../layout';
import { radius, mr } from '../theme';

/**
 * Who to talk to, and the two ways to do it.
 *
 * The avatar's ring is a `borderWidth` on the same view that clips the
 * photograph, which is safe — it is `elevation` that must not share with
 * `overflow: 'hidden'`, and nothing here is raised.
 *
 * The reference prints the agent's name twice, bold over grey, which is a
 * placeholder someone forgot to fill in. The second line is his role here.
 */
export function AgentRow({
  name,
  role,
  avatar,
  onMessage,
  onCall,
}: {
  name: string;
  role: string;
  avatar: ImageSourcePropType;
  onMessage?: () => void;
  onCall?: () => void;
}) {
  return (
    <View style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
      <View
        style={{
          width: AVATAR,
          height: AVATAR,
          borderRadius: radius.circle,
          borderWidth: AVATAR_RING,
          borderColor: mr.accent,
          overflow: 'hidden',
        }}
      >
        <Image
          source={avatar}
          style={{ width: '100%', height: '100%' }}
          resizeMode="cover"
          accessibilityIgnoresInvertColors
          accessible
          accessibilityRole="image"
          accessibilityLabel={name}
        />
      </View>

      <View style={{ flex: 1, gap: 1 }}>
        <T variant="label" color={mr.ink} numberOfLines={1}>
          {name}
        </T>
        <T variant="small" color={mr.muted} numberOfLines={1}>
          {role}
        </T>
      </View>

      <View style={{ flexDirection: 'row', gap: 10 }}>
        <RoundButton
          name="message"
          label={`Message ${name}`}
          size={AGENT_BUTTON}
          variant="outline"
          onPress={onMessage}
        />
        <RoundButton
          name="phone"
          label={`Call ${name}`}
          size={AGENT_BUTTON}
          variant="outline"
          onPress={onCall}
        />
      </View>
    </View>
  );
}
