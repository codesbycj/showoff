import { View } from 'react-native';

import { Icon } from './icon';
import { T } from './text';
import type { Amenity } from '../data/boat';
import { radius, shadow, mr } from '../theme';

/**
 * What comes with the boat.
 *
 * **A wrap, not a scrolling row.** The reference shows four chips on two
 * lines, with the fourth starting a new line rather than being clipped by the
 * screen edge — which is the signature of a wrap. A horizontal scroll would
 * have kept all four on one line and run the last one off the edge, and that
 * is the thing the shot does not do. (The opposite case, a clipped item, is
 * what forces a scroll — see the category row in the velora showcase.)
 *
 * Each chip is white on a blue-cast page with a soft shadow rather than a
 * border. A hairline at this size reads as a seam; the shadow lifts it.
 */
export function AmenityChips({ amenities }: { amenities: Amenity[] }) {
  return (
    <View style={{ flexDirection: 'row', flexWrap: 'wrap', gap: 8 }}>
      {amenities.map((a) => (
        <View
          key={a.id}
          style={{
            flexDirection: 'row',
            alignItems: 'center',
            gap: 8,
            backgroundColor: mr.surface,
            borderRadius: radius.full,
            // Tight enough that Sun Deck, Jacuzzi and BBQ Grill share the
            // first row and Wi-Fi starts the second, which is the split the
            // reference has. At 16 they wrapped two and two.
            paddingHorizontal: 13,
            paddingVertical: 10,
            ...shadow.chip,
          }}
        >
          <Icon name={a.icon} size={16} color={mr.ink} />
          <T variant="label" color={mr.ink}>
            {a.label}
          </T>
        </View>
      ))}
    </View>
  );
}
