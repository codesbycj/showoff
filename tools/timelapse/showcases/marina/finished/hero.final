import { Image, View } from 'react-native';

import { RoundButton } from './round-button';
import { T } from './text';
import { BOAT } from '../data/boat';
import { HERO_HEIGHT, MARGIN, ROUND_BUTTON } from '../layout';
import { radius, mr } from '../theme';

/**
 * The photograph at the top, and the chrome that sits on it.
 *
 * The darkening along the top edge is **baked into the asset**, not laid over
 * at runtime — see `tools/bake/marina.py`. A drone shot of bright water gives
 * white type nothing to sit against, and the alternative is a third stacked
 * view with a gradient whose stops have to stay right on two platforms. Baked,
 * the hero is one image and one draw.
 *
 * The title is centred in the full width while the two buttons are pinned to
 * the margins, so the title stays optically centred rather than being pushed
 * off by whichever control is wider. It is also allowed to run under them: at
 * this length it does not, and reserving space for the worst case would make
 * every normal case look narrow.
 */
export function Hero({ topInset }: { topInset: number }) {
  return (
    <View style={{ height: HERO_HEIGHT }}>
      <Image
        source={BOAT.hero}
        style={{ width: '100%', height: '100%' }}
        resizeMode="cover"
        accessibilityIgnoresInvertColors
        accessible
        accessibilityRole="image"
        accessibilityLabel={`${BOAT.name}, ${BOAT.hull}, seen from the air`}
      />

      <View
        style={{
          position: 'absolute',
          top: topInset + 6,
          left: MARGIN,
          right: MARGIN,
          flexDirection: 'row',
          alignItems: 'flex-start',
          justifyContent: 'space-between',
        }}
      >
        <RoundButton name="back" label="Go back" size={ROUND_BUTTON} />

        <View style={{ flex: 1, alignItems: 'center', paddingTop: 2 }}>
          <T variant="heroTitle" color={mr.onHero}>
            {BOAT.name}
          </T>
          <T variant="heroSub" color={mr.onHeroDim}>
            {BOAT.hull}
          </T>
        </View>

        <RoundButton
          name="heart"
          label={BOAT.saved ? 'Remove from saved' : 'Save this boat'}
          size={ROUND_BUTTON}
          color={mr.heart}
          filled={BOAT.saved}
        />
      </View>

      {/* Which photograph of the set is showing. The current one is a larger
          disc rather than a stadium: over a photograph a stretched pill reads
          as a UI element, where a bigger dot still reads as a dot. */}
      <View
        style={{
          position: 'absolute',
          bottom: 14,
          left: 0,
          right: 0,
          flexDirection: 'row',
          alignItems: 'center',
          justifyContent: 'center',
          gap: 6,
        }}
        pointerEvents="none"
      >
        {Array.from({ length: BOAT.gallery.count }, (_, i) => {
          const on = i === BOAT.gallery.active;
          return (
            <View
              key={i}
              style={{
                width: on ? 9 : 6,
                height: on ? 9 : 6,
                borderRadius: radius.circle,
                backgroundColor: on ? mr.onHero : mr.onHeroDim,
              }}
            />
          );
        })}
      </View>
    </View>
  );
}
