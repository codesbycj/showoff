import { useId } from 'react';
import { View } from 'react-native';
import Svg, {
  Circle,
  Defs,
  G,
  LinearGradient,
  Path,
  RadialGradient,
  Rect,
  Stop,
} from 'react-native-svg';

import { shadow, vd } from '../theme';
import { BankCard } from './bank-card';

/**
 * The hero: a leather pocket with two cards standing out of it.
 *
 * The reference drops a **3D render** of a wallet into this screen, and a 3D
 * render cannot be recreated and must not be traced badly (AGENTS.md, "Three
 * kinds of reference"). The other sanctioned route — free-licensed stock —
 * would mean a brown leather wallet on a white cyclorama, cut out and tinted
 * green, which is exactly the "close enough" this project does not ship.
 *
 * So it is rebuilt as the thing the render is a picture of: a real pocket, two
 * real `BankCard`s, lit from the same lower-right corner as the backdrop. It
 * costs nothing at runtime, it is sharp at any size, it recolours with the
 * theme, and on camera it can be revealed a piece at a time — which a dropped
 * PNG cannot.
 *
 * Order matters and is the whole trick: the cards are laid down first and the
 * pocket's front panel is drawn over them, so they read as *inside* it. No
 * `overflow: 'hidden'` anywhere — that plus `elevation` is unreliable on
 * Android, and nothing here needs a clip once the panel does the hiding.
 *
 * Every offset is a fraction of `width`, so the whole thing scales with the
 * window rather than carrying numbers off an artboard.
 */
export function Wallet({ width }: { width: number }) {
  const id = useId();

  const body = width * 0.78;
  const rise = width * 0.3;
  const height = body + rise;
  const r = width * 0.1;
  /** How thick the leather reads at the mouth. */
  const lip = width * 0.055;

  const backCard = width * 0.74;
  const frontCard = width * 0.78;

  return (
    <View style={{ width, height }}>
      {/* The pale card, furthest back and leaning away. */}
      <View
        style={{
          position: 'absolute',
          left: width * 0.03,
          top: 0,
          transform: [{ rotate: '-7deg' }],
        }}
      >
        <BankCard width={backCard} tone="pale" />
      </View>

      {/* The brand's own, in front of it and leaning the other way. */}
      <View
        style={{
          position: 'absolute',
          left: width * 0.17,
          top: rise * 0.34,
          transform: [{ rotate: '5deg' }],
        }}
      >
        <BankCard width={frontCard} tone="dark" />
      </View>

      {/* The pocket, drawn over both. */}
      <View
        style={{
          position: 'absolute',
          left: 0,
          bottom: 0,
          width,
          height: body,
          ...shadow.wallet,
        }}
      >
        <Svg width={width} height={body}>
          <Defs>
            <LinearGradient id={`${id}-hide`} x1="8%" y1="0%" x2="92%" y2="100%">
              <Stop offset="0" stopColor={vd.leatherLip} />
              <Stop offset="0.38" stopColor={vd.leather} />
              <Stop offset="1" stopColor={vd.leatherDeep} />
            </LinearGradient>
            <LinearGradient id={`${id}-lip`} x1="0%" y1="0%" x2="100%" y2="0%">
              <Stop offset="0" stopColor={vd.leatherLip} stopOpacity="0.7" />
              <Stop offset="0.45" stopColor="#3d7b5d" stopOpacity="1" />
              <Stop offset="1" stopColor="#79a98f" stopOpacity="1" />
            </LinearGradient>
            <RadialGradient id={`${id}-stud`} cx="35%" cy="30%" r="70%">
              <Stop offset="0" stopColor="#efd7a1" />
              <Stop offset="0.55" stopColor={vd.stud} />
              <Stop offset="1" stopColor={vd.studShade} />
            </RadialGradient>
          </Defs>

          <Rect x="0" y="0" width={width} height={body} rx={r} fill={`url(#${id}-hide)`} />

          {/*
            The cut edge of the front panel, where the cards go in.

            A band rather than a line: the mouth of a wallet is the thickness
            of the leather seen end-on, and it is the brightest thing on the
            whole object because it faces the light squarely. Without it the
            pocket reads as a flat rounded rectangle with cards behind it.
          */}
          <Path
            d={`M 0 ${lip}
                V ${r}
                A ${r} ${r} 0 0 1 ${r} 0
                H ${width - r}
                A ${r} ${r} 0 0 1 ${width} ${r}
                V ${lip} Z`}
            fill={`url(#${id}-lip)`}
          />

          {/* The stitch, held off the edge the way a real one is. */}
          <Rect
            x={width * 0.055}
            y={width * 0.105}
            width={width - width * 0.11}
            height={body - width * 0.16}
            rx={r * 0.62}
            fill="none"
            stroke={vd.stitch}
            strokeWidth={Math.max(0.8, width * 0.006)}
            strokeDasharray={`${width * 0.016} ${width * 0.018}`}
          />

          {/*
            The stud on the flap: the shadow it sits in, then the brass, then
            the dark rim. Three passes, because one filled circle reads as a
            dot printed on the leather rather than a thing set into it.

            Grouped in a `G` so the three arrive together — a reveal that
            staged one sibling at a time would show a floating shadow for a
            beat and a half.
          */}
          <G>
            <Circle
              cx={width * 0.845}
              cy={body * 0.6 + width * 0.009}
              r={width * 0.045}
              fill="rgba(8, 26, 18, 0.5)"
            />
            <Circle cx={width * 0.845} cy={body * 0.6} r={width * 0.04} fill={`url(#${id}-stud)`} />
            <Circle
              cx={width * 0.845}
              cy={body * 0.6}
              r={width * 0.04}
              fill="none"
              stroke="rgba(14, 40, 32, 0.45)"
              strokeWidth={width * 0.004}
            />
          </G>
        </Svg>
      </View>
    </View>
  );
}

/** What the wallet occupies, so the stage can place it without guessing. */
export const walletBox = (width: number) => ({
  width,
  height: width * 0.78 + width * 0.3,
});
