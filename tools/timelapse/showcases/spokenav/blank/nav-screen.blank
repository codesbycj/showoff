 *
 * Assembly only: the road ahead with the route on it, where you are, what to
 * do next, how the ride is going, and the way to see more.
 *
 * The road fills the top 56% and the sheet takes the rest, so the two always
 * meet and the screen is full at any height. The distance in the instruction
 * is set heavier than the words around it because it is the only part of the
 * sentence you read at speed.
 */
export default function SpokenavScreen() {
  const insets = useInsets();

