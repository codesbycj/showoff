          title={BRIEFING.title}
          subtitle={BRIEFING.subtitle}
          action={BRIEFING.action}
          onPress={() => router.push('/auralegal/booking')}
        />
*/}

{/* STEP 2.28 name the list | FIX 2.31 the count and the link are the wrong way round
        <SectionHead
          title={FEED.sectionTitle}
          count={FEED.sectionAction}
          action={FEED.sectionCount}
        />
*/}

{/* STEP 2.30 name the list, the right way round
        <SectionHead
          title={FEED.sectionTitle}
          count={FEED.sectionCount}
          action={FEED.sectionAction}
        />
*/}

{/* STEP 2.32 room for the experts
        <View style={{ gap: 10 }}>
          {EXPERTS.map((e) => (
            <ExpertRow key={e.key} expert={e} onPress={() => router.push('/auralegal/profile')} />
          ))}
        </View>
*/}
      </ScrollView>

{/* STEP 2.34 pin the dock
      <Dock items={DOCK} active="explore" inset={insets.bottom} />
*/}
    </View>
  );
}
