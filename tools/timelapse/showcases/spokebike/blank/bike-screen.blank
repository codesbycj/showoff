          }}
        >
          <Glyph name="lock" size={18} tint={sp.ink} />
        </View>
        <T
          variant="swipe"
          color={sp.muted}
          style={{ flex: 1, textAlign: 'center', height: type.swipe.line }}
        >
          {copy.swipe}
        </T>
        <Glyph name="next" size={16} tint={sp.muted} />
