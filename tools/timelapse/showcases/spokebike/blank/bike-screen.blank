        {bike.name}
      </T>
*/}
{/* STEP 1.02 and what it is for
      <T variant="blurb" color={sp.muted} style={{ marginTop: BLURB_TOP, maxWidth: 240 }}>
        {bike.blurb}
      </T>
*/}

{/* STEP 1.04 with its charge beside it
      <View style={{ flex: 1, marginTop: STAGE_TOP }}>
        <BikeStage />
      </View>
*/}

{/* STEP 1.06 what it has done
      <View style={{ flexDirection: 'row', gap: TILE_GAP, marginTop: TILES_TOP }}>
