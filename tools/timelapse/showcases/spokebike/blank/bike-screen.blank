          const lime = t.tone === 'lime';
          return (
            <View
              key={t.id}
              style={{
                flex: 1,
                height: TILE_HEIGHT,
                borderRadius: radius.card,
                backgroundColor: lime ? sp.lime : sp.dark,
                padding: CARD_PAD,
                justifyContent: 'space-between',
              }}
            >
              <View style={{ flexDirection: 'row', alignItems: 'center' }}>
                <T
                  variant="tileLabel"
                  color={lime ? sp.ink : sp.onDark}
                  style={{ flex: 1, height: type.tileLabel.line }}
                >
                  {t.label}
                </T>
                <View
                  style={{
                    width: 28,
                    height: 28,
                    borderRadius: radius.control,
                    backgroundColor: lime ? sp.dark : sp.card,
                    alignItems: 'center',
                    justifyContent: 'center',
                  }}
                >
                  <Glyph name="arrow" size={14} tint={lime ? sp.onDark : sp.ink} />
                </View>
              </View>
              <T
                variant="tileValue"
                color={lime ? sp.ink : sp.onDark}
                style={{ height: type.tileValue.line }}
              >
                {t.value}
              </T>
            </View>
          );
        })}
      </View>
*/}

{/* STEP 1.08 and the way to take it
      <View
        style={{
          height: SWIPE_HEIGHT,
          marginTop: SWIPE_TOP,
          paddingLeft: 7,
          paddingRight: 18,
          borderRadius: radius.pill,
          backgroundColor: sp.card,
          flexDirection: 'row',
          alignItems: 'center',
          ...shadow.card,
        }}
      >
        <View
