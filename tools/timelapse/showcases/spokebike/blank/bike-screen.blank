import { Glyph } from '@/features/spokebike/components/glyph';
import { T } from '@/features/spokebike/components/text';
import { bike, copy, me, tiles } from '@/features/spokebike/data/bikes';
import {
  BLURB_TOP,
  CARD_PAD,
  HEADER_SIZE,
  HEADER_TOP,
  MARGIN,
  STAGE_TOP,
  SWIPE_HEIGHT,
  SWIPE_TOP,
  TILE_GAP,
  TILE_HEIGHT,
  TILES_TOP,
  TITLE_TOP,
} from '@/features/spokebike/layout';
import { radius, shadow, sp, type } from '@/features/spokebike/theme';
import { useInsets } from '@/features/spokebike/use-insets';

/**
 * Spoke — the bike.
 *
 * Assembly only: the way back, which bike this is, the bike itself with its
 * charge, what it has done, and the way to take it.
 *
 * The stack is solved from the bottom — swipe bar, tiles, then the photograph
 * takes everything left with `flex: 1` — so the screen is full whatever the
 * title wraps to.
 */
export default function SpokebikeScreen() {
  const insets = useInsets();

  const disc = {
    width: HEADER_SIZE,
    height: HEADER_SIZE,
    borderRadius: radius.control,
    backgroundColor: sp.card,
    alignItems: 'center' as const,
    justifyContent: 'center' as const,
  };

  return (
    <View
      style={{
        flex: 1,
        backgroundColor: sp.canvas,
        paddingTop: insets.top + HEADER_TOP,
        paddingHorizontal: MARGIN,
        paddingBottom: insets.bottom,
      }}
    >
      <StatusBar style="dark" />

      <View style={{ flexDirection: 'row', alignItems: 'center' }}>
        <Pressable accessibilityRole="button" accessibilityLabel="Go back">
          <View style={[disc, shadow.card]}>
            <Glyph name="back" size={19} tint={sp.ink} />
          </View>
        </Pressable>
        <View style={{ flex: 1 }} />
        <Pressable accessibilityRole="button" accessibilityLabel="Ride settings">
          <View style={[disc, shadow.card]}>
            <Glyph name="helmet" size={19} tint={sp.ink} />
          </View>
        </Pressable>
        <Pressable accessibilityRole="button" accessibilityLabel="Your account">
          <Image
            source={me.src}
            style={{
              width: HEADER_SIZE,
              height: HEADER_SIZE,
              borderRadius: radius.control,
              marginLeft: 10,
            }}
          />
        </Pressable>
      </View>

{/* STEP 1.01 which bike this is
      <T
        variant="display"
        color={sp.ink}
        style={{ marginTop: TITLE_TOP, height: type.display.line }}
