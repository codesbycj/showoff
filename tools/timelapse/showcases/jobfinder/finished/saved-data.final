import { type BrandKey } from '../components/brand-mark';
import { type TagTone, jf } from '../theme';

/**
 * The saved screen's listings.
 *
 * They are not the feed's `JOBS` filtered. The reference's saved list carries a
 * different set — it swaps the Apple content role for a Figma product design
 * role, and it re-tags the two it shares with the feed ("React" instead of
 * "JS", "Branding" instead of "Design"). That is what a saved list is: a
 * separate collection, not a view onto the same one.
 */
export type SavedJob = {
  key: string;
  title: string;
  company: string;
  mode: string;
  salary: string;
  per: string;
  tags: readonly { label: string; tone: TagTone }[];
  brand: BrandKey;
  brandBg: string;
  /** Which feed listing this opens, where one exists. */
  detail: string;
};

