/**
 * The profile screen's own chip palette. It does not reuse `TAG`, because these
 * are a different set — a mint, a peach, a lavender and a stone that the feed
 * never uses, all of them at 11dp medium on the card's white rather than 11dp
 * semibold on a tint.
 */
export const PROJECT_TAG = {
  mint: { bg: '#E2F2E5', fg: '#155E36' },
  peach: { bg: '#FAEAE1', fg: '#7C2D12' },
  lavender: { bg: '#EBE7F7', fg: '#3B0764' },
  stone: { bg: '#EDF0EB', fg: '#161719' },
} as const;
