/**
 * George Miller's profile.
 *
 * Everything here is invented for the showcase — the case studies, the
 * percentages, the skill-test ranking and the CV. The three project marks are
 * not company logos: they are the reference's own generic glyphs, which is why
 * they are named by shape rather than by brand.
 */
export type ProjectGlyphKey = 'layers' | 'alert' | 'initial';

export type CaseStudy = {
  key: string;
  eyebrow: string;
  title: string;
  blurb: string;
  tags: readonly { label: string; tone: 'mint' | 'peach' | 'lavender' | 'stone' }[];
  glyph: ProjectGlyphKey;
  glyphBg: string;
};

