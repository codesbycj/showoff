import { Pressable, View } from 'react-native';

import { form } from '../data/transfer';
import { CARD_PAD, FIELD_GLYPH, FIELD_HEIGHT } from '../layout';
import { fn, radius, shadow } from '../theme';
import { Icon, type IconName } from './icon';
import { T } from './text';

/**
 * Where the money is going: a bank, and an account at it.
 *
 * Two rows in one card rather than two cards, because they are one decision —
 * and the hairline between them is what says so without a heading.
 *
 * The first row is pressable and the second is not: a bank is chosen from a
 * list, an account number is typed. Giving both the same affordance would
 * promise a picker that cannot exist.
 */
export function DestinationCard({ onPickBank }: { onPickBank?: () => void }) {
  return (
    <View
      style={{
        borderRadius: radius.card,
        backgroundColor: fn.surface,
        paddingHorizontal: CARD_PAD,
        ...shadow.card,
      }}
    >
      <Pressable onPress={onPickBank} accessibilityRole="button" accessibilityLabel="Choose a bank">
        <Field
          glyph="bank"
          label={form.destinationLabel}
          value={form.destination}
          trailing="pick"
        />
      </Pressable>

      <View style={{ height: 1, backgroundColor: fn.rule }} />

      <Field glyph="card" label={form.numberLabel} value={form.number} />
    </View>
  );
}

function Field({
  glyph,
  label,
  value,
  trailing,
}: {
  glyph: IconName;
  label: string;
  value: string;
  trailing?: IconName;
}) {
  return (
    <View style={{ height: FIELD_HEIGHT + 16, flexDirection: 'row', alignItems: 'center' }}>
      <View
        style={{
          width: FIELD_GLYPH,
          height: FIELD_GLYPH,
          borderRadius: radius.full,
          backgroundColor: fn.sunken,
          alignItems: 'center',
          justifyContent: 'center',
        }}
      >
        <Icon name={glyph} size={15} color={fn.ink} />
      </View>

      <View style={{ flex: 1, marginLeft: 11 }}>
        <T variant="fieldLabel" color={fn.muted}>
          {label}
        </T>
        <T variant="fieldValue" color={fn.ink} numberOfLines={1}>
          {value}
        </T>
      </View>

      {trailing ? <Icon name={trailing} size={17} color={fn.muted} /> : null}
    </View>
  );
}
