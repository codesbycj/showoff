import { useState } from 'react';
import { View } from 'react-native';

import { list } from '../data/transfer';
import { GRABBER_H, GRABBER_W, SEARCH_TOP, SHEET_PAD, TABS_TOP } from '../layout';
import { fn, radius, shadow } from '../theme';
import { FilterTabs } from './filter-tabs';
import { ListRow } from './list-row';
import { SearchField } from './search-field';
import { T } from './text';

/**
 * The sheet at the foot: everyone you could send to.
 *
 * It is a sheet rather than a section — rounded only at the top, with a
 * grabber — because the reference's is one, and that shape promises it can be
 * dragged up over the form above it.
 *
 * Which filter is live is held here rather than in `FilterTabs`: the tabs are
 * what change it, but what it changes is the list underneath, and a component
 * that owns its own state cannot be driven from anywhere else.
 */
export function TransferSheet({ onSelect }: { onSelect?: (key: string) => void }) {
  const [filter, setFilter] = useState<string>(list.filters[0]);

  return (
    <View
      style={{
        flex: 1,
        borderTopLeftRadius: radius.sheet,
        borderTopRightRadius: radius.sheet,
        backgroundColor: fn.surface,
        paddingHorizontal: SHEET_PAD,
        paddingTop: 10,
        ...shadow.sheet,
      }}
    >
      <View style={{ alignItems: 'center' }}>
        <View
          style={{
            width: GRABBER_W,
            height: GRABBER_H,
            borderRadius: radius.full,
            backgroundColor: fn.grabber,
          }}
        />
      </View>

      <T variant="section" color={fn.ink} style={{ marginTop: 14 }}>
        {list.title}
      </T>

      <View style={{ marginTop: TABS_TOP }}>
        <FilterTabs items={list.filters} active={filter} onSelect={setFilter} />
      </View>

      <View style={{ marginTop: SEARCH_TOP }}>
        <SearchField placeholder={list.search} />
      </View>

      <View style={{ marginTop: 6 }}>
        {list.rows.map((r) => (
          <ListRow
            key={r.key}
            name={r.name}
            number={r.number}
            bank={r.bank}
            face={r.face}
            onPress={() => onSelect?.(r.key)}
          />
        ))}
      </View>
    </View>
  );
}
