import { useState } from 'react';
import { Pressable, View } from 'react-native';

import { fn } from '../theme';
import { Icon } from './icon';
import { T } from './text';

/**
 * The header: a back arrow and a centred title.
 *
 * The title is absolutely positioned across the whole bar rather than placed
 * beside the arrow — centred in the space the arrow leaves, it would sit a few
 * dp right of the screen's centre, and a lone word at the top of a screen is
 * exactly where that shows.
 */
export function AppBar({ title, onBack }: { title: string; onBack?: () => void }) {
  const [held, setHeld] = useState(false);

  return (
    <View style={{ height: 36, justifyContent: 'center' }}>
      <View
        style={{ position: 'absolute', left: 0, right: 0, alignItems: 'center' }}
        pointerEvents="none"
      >
        <T variant="title" color={fn.ink}>
          {title}
        </T>
      </View>

      <Pressable
        onPress={onBack}
        onPressIn={() => setHeld(true)}
        onPressOut={() => setHeld(false)}
        hitSlop={12}
        accessibilityRole="button"
        accessibilityLabel="Go back"
        style={{ alignSelf: 'flex-start', opacity: held ? 0.5 : 1 }}
      >
        <Icon name="back" size={21} />
      </Pressable>
    </View>
  );
}
