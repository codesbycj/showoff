import { View } from 'react-native';

import { copy } from '../data/start';
import { DISPLAY_TOP } from '../layout';
import { lk, type } from '../theme';
import { T } from './text';

/**
 * What the screen is asking.
 *
 * The two lines are written out rather than mapped so the reveal can set them
 * one at a time — on a screen this sparse the headline arriving is a beat
 * worth having.
 */
export function Headline() {
  return (
    <View style={{ marginTop: DISPLAY_TOP }}>
{/* STEP 1.07 the first line
      <T variant="display" color={lk.ink} style={{ height: type.display.line }}>
        {copy.headline[0]}
      </T>
*/}
{/* STEP 1.08 and the second
      <T variant="display" color={lk.ink} style={{ height: type.display.line }}>
        {copy.headline[1]}
      </T>
*/}
    </View>
  );
}
