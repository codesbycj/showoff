import { View } from 'react-native';

import { copy } from '../data/start';
import { DISPLAY_TOP } from '../layout';
import { ms, type } from '../theme';
import { T } from './text';

/**
 * Who the app is talking to, and about what.
 *
 * The runs are data, not markup: each line is a list of `{ text, weight,
 * accent }`, so where the sentence turns bold and where it turns orange are
 * properties of the copy rather than something this component hard-codes.
 *
 * React Native resolves a face by family name and not by numeric weight, so
 * each run names its own family — never a `font-bold` utility, which would
 * ask for a weight the family cannot supply.
 */
export function Greeting() {
  return (
    <View style={{ marginTop: DISPLAY_TOP }}>
      {copy.greetLines.map((line, i) => (
        <View key={i} style={{ flexDirection: 'row' }}>
          {line.map((run) => (
            <T
              key={run.text}
              variant={run.weight === 'bold' ? 'displayBold' : 'displayLight'}
              color={'accent' in run && run.accent ? ms.orange : ms.ink}
              style={{ height: type.displayBold.line }}
            >
              {run.text}
            </T>
          ))}
        </View>
      ))}
    </View>
  );
}
