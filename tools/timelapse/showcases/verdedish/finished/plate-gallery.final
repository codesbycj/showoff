import { useState } from 'react';
import {
  Image,
  type NativeScrollEvent,
  type NativeSyntheticEvent,
  ScrollView,
  View,
} from 'react-native';

import { gallery } from '../data/dish';
import { ct } from '../theme';

type Props = { width: number; height: number; radius: number };

/**
 * The dish's photographs — the dominant element on the screen (R8).
 *
 * A real pager: the dots count the frames that exist and mark the one the
 * scroller is on, so the control and the picture agree (R9). The index is
 * clamped at both ends because the reveal stages this array one entry at a
 * time (I7).
 */
export function PlateGallery({ width, height, radius }: Props) {
  const [page, setPage] = useState(0);

  const onScroll = (e: NativeSyntheticEvent<NativeScrollEvent>) => {
    const next = Math.round(e.nativeEvent.contentOffset.x / Math.max(width, 1));
    setPage(Math.min(Math.max(next, 0), Math.max(gallery.length - 1, 0)));
  };

  return (
    <View
      style={{
        height,
        borderBottomLeftRadius: radius,
        borderBottomRightRadius: radius,
        overflow: 'hidden',
        backgroundColor: ct.tray,
      }}
    >
      <ScrollView
        horizontal
        pagingEnabled
        showsHorizontalScrollIndicator={false}
        onScroll={onScroll}
        scrollEventThrottle={32}
      >
        {gallery.map((shot) => (
          <Image
            key={shot.id}
            source={shot.image}
            style={{ width, height }}
            resizeMode="cover"
            accessibilityLabel="Dish photograph"
          />
        ))}
      </ScrollView>

      <View
        style={{
          position: 'absolute',
          left: 0,
          right: 0,
          bottom: 16,
          flexDirection: 'row',
          justifyContent: 'center',
          gap: 6,
        }}
      >
        {gallery.map((shot, i) => (
          <View
            key={shot.id}
            style={{
              width: i === page ? 20 : 7,
              height: 7,
              borderRadius: 4,
              backgroundColor: i === page ? ct.green : ct.white,
            }}
          />
        ))}
      </View>
    </View>
  );
}
