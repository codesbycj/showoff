import { Pressable, View } from 'react-native';
import Svg, { Path } from 'react-native-svg';

import { ACTIONS_TOP, ACTION_HEIGHT } from '../layout';
import { mg, radius } from '../theme';

/**
 * Pass, or like.
 *
 * Both are real controls with accessible names — the reference's pair are
 * two glyphs in two rounded rectangles and nothing says which does what. The
 * like is the wider of the two and takes the brand colour, because on this
 * screen it is the thing the app wants.
 */
export function ActionRow({ onPass, onLike }: { onPass?: () => void; onLike?: () => void }) {
  return (
    <View style={{ flexDirection: 'row', gap: 12, marginTop: ACTIONS_TOP }}>
      <Pressable
        onPress={onPass}
        style={({ pressed }) => ({ flex: 1, opacity: pressed ? 0.85 : 1 })}
        accessibilityRole="button"
        accessibilityLabel="Pass"
      >
        <View
          style={{
            height: ACTION_HEIGHT,
            borderRadius: radius.action,
            backgroundColor: mg.card,
            alignItems: 'center',
            justifyContent: 'center',
          }}
        >
          <Svg width={24} height={24} viewBox="0 0 24 24">
            <Path
              d="M6.4 6.4 17.6 17.6M17.6 6.4 6.4 17.6"
              stroke={mg.ink}
              strokeWidth={2.4}
              strokeLinecap="round"
            />
          </Svg>
        </View>
      </Pressable>

      <Pressable
        onPress={onLike}
        style={({ pressed }) => ({ flex: 1.3, opacity: pressed ? 0.85 : 1 })}
        accessibilityRole="button"
        accessibilityLabel="Like"
      >
        <View
          style={{
            height: ACTION_HEIGHT,
            borderRadius: radius.action,
            backgroundColor: mg.red,
            alignItems: 'center',
            justifyContent: 'center',
          }}
        >
          <Svg width={26} height={26} viewBox="0 0 24 24">
            <Path
              d="M12 20.6c-.6 0-1-.2-1.5-.6C5.6 15.8 3 13.2 3 9.8A4.8 4.8 0 0 1 12 7.6a4.8 4.8 0 0 1 9 2.2c0 3.4-2.6 6-7.5 10.2-.5.4-.9.6-1.5.6Z"
              fill={mg.onRed}
            />
          </Svg>
        </View>
      </Pressable>
    </View>
  );
}
