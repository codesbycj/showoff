/**
 * Screen 1 content — the discovery feed.
 *
 * Lifted verbatim from the export's markup, so the components stay
 * presentational and the screen stays a list of imports.
 *
 * `CHIPS` and `NAV` carry explicit element types rather than leaning on `as
 * const`. Both are emptied one entry at a time for the timelapse, and an array
 * literal with nothing in it infers `never[]` — which typechecks here and then
 * fails at every call site.
 */

/** The search capsule's placeholder. */
export const SEARCH_PLACEHOLDER = 'Where would you like to go?';

/** A destination chip. `label: null` is the image-only third chip. */
export type Chip = {
  key: string;
  label: string | null;
  /** `require` of a bundled asset, which Metro resolves to a number. */
  image: number;
};

/** The horizontal country selector. The third chip is image-only, as drawn. */
export const CHIPS: readonly Chip[] = [
  {
    key: 'uae',
    label: 'UAE',
    image: require('../../../../assets/images/voyago/chip-uae.jpg'),
  },
  {
    key: 'egypt',
    label: 'EGYPT',
    image: require('../../../../assets/images/voyago/chip-egypt.jpg'),
  },
  {
    key: 'bora',
    label: null,
    image: require('../../../../assets/images/voyago/chip-tropical.jpg'),
  },
];

/** The 290dp hero card. */
export const FEATURED = {
  country: 'UAE',
  city: 'Dubai',
  priceLabel: 'Starting Price',
  price: '120$',
  image: require('../../../../assets/images/voyago/hero-dubai.jpg') as number,
} as const;

/** The single hotel preview beneath it. */
export const HOTEL_PREVIEW = {
  name: 'Address Sky View',
  price: '120$',
  per: 'Night',
  rating: '5.0',
  image: require('../../../../assets/images/voyago/mini-skyview.jpg') as number,
} as const;

/** Section headings, so the screen never carries a bare string. */
export const SECTIONS = {
  nearby: { title: 'Nearby Destination', action: 'View All' },
  hotels: { title: 'Recommended Hotels', action: 'Dubai' },
} as const;

export type NavItem = { key: string; label: string };

/**
 * The floating tab bar. `Schedule` is the active tab and the only one that
 * carries the orange plane disc.
 */
export const NAV: readonly NavItem[] = [
  { key: 'tickets', label: 'Tickets' },
  { key: 'schedule', label: 'Schedule' },
  { key: 'trips', label: 'My Trips' },
];
