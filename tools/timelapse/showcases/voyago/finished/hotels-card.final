import { Image } from 'expo-image';
import { ArrowRight } from 'lucide-react-native';
import { Pressable, Text, View } from 'react-native';

import { FONT, R, SP, alpha, vy } from '../theme';

/**
 * The 360dp photographic card the hotel stack is built on.
 *
 * Its background is baked — the export darkens the photograph with
 * `brightness-[0.78] contrast-105`, both CSS filters React Native cannot apply,
 * and lays a vignette over it. All of that is composited into
 * `hotel-skyview.jpg` by `tools/bake/voyago-hotel.py`.
 *
 * The action is a 44x64 rounded *rectangle*, not a circle: `rounded-full` on a
 * non-square box gives a stadium, and at 44x64 that is a tall lozenge. It is
 * drawn with an explicit 22dp radius so the shape does not depend on how a
 * platform resolves a 9999dp radius on an oblong.
 *
 * `backdrop-blur-md` on the price pill and the rating disc is dropped, as on
 * home — there is no RN equivalent, and over a photograph this dark the 20%
 * white fill reaches the same colour on its own.
 */
export function FeaturedHotelCard({
  name,
  price,
  per,
  rating,
  image,
  onPress,
}: {
  name: string;
  price: string;
  per: string;
  rating: string;
  image: number;
  onPress?: () => void;
}) {
  return (
    <View
      style={{
        borderRadius: R.heroTall,
        shadowColor: vy.ink,
        shadowOpacity: 0.25,
        shadowRadius: 25,
        shadowOffset: { width: 0, height: 12 },
        elevation: 10,
        zIndex: 10,
      }}
    >
      <View style={{ height: 360, borderRadius: R.heroTall, overflow: 'hidden' }}>
        <Image
          source={image}
          style={{ position: 'absolute', top: 0, left: 0, right: 0, bottom: 0 }}
          contentFit="cover"
        />

        <View style={{ flex: 1, padding: SP['2xl'], justifyContent: 'space-between' }}>
          <View
            style={{
              flexDirection: 'row',
              alignItems: 'flex-start',
              justifyContent: 'space-between',
            }}
          >
            <Text
              style={{
                maxWidth: 200,
                fontFamily: FONT.semibold,
                fontSize: 30,
                lineHeight: 33.6,
                letterSpacing: -0.75,
                color: vy.white,
              }}
            >
              {name}
            </Text>

            <Pressable
              onPress={onPress}
              accessibilityRole="button"
              accessibilityLabel={`View ${name.replace('\n', ' ')} details`}
            >
              <View
                style={{
                  width: 44,
                  height: 64,
                  borderRadius: 22,
                  backgroundColor: alpha(vy.mintBadge, 0.95),
                  alignItems: 'center',
                  justifyContent: 'center',
                  shadowColor: vy.ink,
                  shadowOpacity: 0.18,
                  shadowRadius: 6,
                  shadowOffset: { width: 0, height: 3 },
                  elevation: 4,
                }}
              >
                <ArrowRight size={16} color={vy.slate950} strokeWidth={2.2} />
              </View>
            </Pressable>
          </View>

          <View
            style={{
              flexDirection: 'row',
              alignItems: 'center',
              justifyContent: 'space-between',
              paddingBottom: SP['4xl'],
            }}
          >
            <View
              style={{
                flexDirection: 'row',
                alignItems: 'baseline',
                gap: 6,
                backgroundColor: alpha(vy.white, 0.2),
                borderWidth: 1,
                borderColor: alpha(vy.white, 0.25),
                borderRadius: R.full,
                paddingHorizontal: SP.xl,
                paddingVertical: 10,
              }}
            >
              <Text
                style={{
                  fontFamily: FONT.bold,
                  fontSize: 24,
                  lineHeight: 30,
                  letterSpacing: -0.6,
                  color: vy.white,
                }}
              >
                {price}
              </Text>
              <Text
                style={{
                  fontFamily: FONT.regular,
                  fontSize: 12,
                  lineHeight: 16,
                  color: alpha(vy.white, 0.8),
                }}
              >
                {per}
              </Text>
            </View>

            <View
              style={{
                width: 56,
                height: 56,
                borderRadius: R.full,
                backgroundColor: alpha(vy.white, 0.2),
                borderWidth: 1,
                borderColor: alpha(vy.white, 0.25),
                alignItems: 'center',
                justifyContent: 'center',
              }}
            >
              <Text
                style={{
                  fontFamily: FONT.bold,
                  fontSize: 18,
                  lineHeight: 22,
                  letterSpacing: -0.45,
                  color: vy.white,
                }}
              >
                {rating}
              </Text>
            </View>
          </View>
        </View>
      </View>
    </View>
  );
}
