import { View } from 'react-native';
import Svg, { Circle, Path } from 'react-native-svg';

import { empty } from '../data/wallet';
import { EMPTY_H } from '../layout';
import { fu } from '../theme';
import { T } from './text';

/**
 * What the list shows when there is nothing in it.
 *
 * A line drawing, which is drawing range by any reading — a mark, not a
 * picture. The reference draws a figure with binoculars; a figure reduced to
 * six strokes reads as scribble at this size, so it is a magnifier over an
 * empty line instead, which says the same thing and survives being small.
 */
export function EmptyState() {
  return (
    <View style={{ height: EMPTY_H, alignItems: 'center', justifyContent: 'center' }}>
      <Svg width={168} height={104} viewBox="0 0 168 104">
        <Path
          d="M14 78 H154"
          stroke={fu.sketch}
          strokeWidth={2.2}
          strokeLinecap="round"
          strokeDasharray="1 9"
        />
        <Circle cx={74} cy={44} r={26} fill="none" stroke={fu.sketch} strokeWidth={2.6} />
        <Path d="M93 63 L112 82" stroke={fu.sketch} strokeWidth={4} strokeLinecap="round" />
        <Path
          d="M63 44 a11 11 0 0 1 11 -11"
          fill="none"
          stroke={fu.promoAccent}
          strokeWidth={3}
          strokeLinecap="round"
        />
        <Circle cx={126} cy={30} r={7} fill={fu.promoAccent} />
        <Circle cx={142} cy={46} r={4} fill={fu.promoAccent} opacity={0.6} />
      </Svg>

      <T
        variant="promoMeta"
        color={fu.muted}
        style={{ marginTop: 10, textAlign: 'center', width: '76%' }}
      >
        {empty.caption}
      </T>
    </View>
  );
}
