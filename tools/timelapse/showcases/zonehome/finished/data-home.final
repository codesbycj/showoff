];

export const section = { title: 'Popular Restaurants' };

export type Restaurant = {
  id: string;
  name: string;
  photo: number;
  rating: number;
  reviews: number;
  kind: string;
  price: string;
  /** Only some carry a running offer — hence the annotation. */
  offer?: string;
  liked?: boolean;
};

