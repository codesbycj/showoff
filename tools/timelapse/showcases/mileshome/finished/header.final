import Bell from 'lucide-react-native/icons/bell';
import Search from 'lucide-react-native/icons/search';
import { Image, Pressable, View } from 'react-native';

import { header } from '../data/home';
import { HEADER_AVATAR, HEADER_HEIGHT } from '../layout';
import { ml, radius, shadow } from '../theme';
import { FACES } from './faces';
import { T } from './text';

/**
 * Who is here, and the two things they can do from anywhere.
 *
 * Floating surfaces rather than a bar: the page behind is a colour with
 * photographs thrown over it, and a solid header would cut that in half.
 */
export function Header({ onAlerts, onSearch }: { onAlerts?: () => void; onSearch?: () => void }) {
  return (
    <View style={{ flexDirection: 'row', alignItems: 'center' }}>
      <View
        style={{
          height: HEADER_HEIGHT,
          borderRadius: radius.pill,
          backgroundColor: ml.surface,
          flexDirection: 'row',
          alignItems: 'center',
          paddingLeft: 6,
          paddingRight: 18,
          gap: 9,
          ...shadow.float,
        }}
      >
        <Image
          source={FACES[0]}
          style={{ width: HEADER_AVATAR, height: HEADER_AVATAR, borderRadius: radius.full }}
          resizeMode="cover"
          accessibilityIgnoresInvertColors
        />
        <View>
          <T variant="greetingMeta" color={ml.muted}>
            {header.meta}
          </T>
          <T variant="greeting" color={ml.ink}>
            {header.name}
          </T>
        </View>
      </View>

      <View style={{ flex: 1 }} />

      <View style={{ flexDirection: 'row', gap: 8 }}>
        <Pressable onPress={onAlerts} accessibilityRole="button" accessibilityLabel="Alerts">
          <View
            style={{
              width: HEADER_HEIGHT,
              height: HEADER_HEIGHT,
              borderRadius: radius.full,
              backgroundColor: ml.surface,
              alignItems: 'center',
              justifyContent: 'center',
              ...shadow.float,
            }}
          >
            <Bell size={18} color={ml.ink} strokeWidth={1.9} />
          </View>
        </Pressable>

        <Pressable onPress={onSearch} accessibilityRole="button" accessibilityLabel="Search">
          <View
            style={{
              width: HEADER_HEIGHT,
              height: HEADER_HEIGHT,
              borderRadius: radius.full,
              backgroundColor: ml.surface,
              alignItems: 'center',
              justifyContent: 'center',
              ...shadow.float,
            }}
          >
            <Search size={18} color={ml.ink} strokeWidth={1.9} />
          </View>
        </Pressable>
      </View>
    </View>
  );
}
