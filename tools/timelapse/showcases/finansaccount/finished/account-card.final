import { View } from 'react-native';

import type { FlagName } from '../data/account';
import { labels } from '../data/account';
import { CARD_PAD, CARD_RATIO } from '../layout';
import { fn, radius, shadow } from '../theme';
import { FlagDisc } from './flag-disc';
import { Icon } from './icon';
import { SchemeMark } from './scheme-mark';
import { T } from './text';

/**
 * One account, as a card.
 *
 * Its height is a ratio of its width rather than a number, so it keeps its
 * proportion whatever the page gives it — a card that loses its aspect stops
 * reading as a card.
 *
 * The scheme mark is optional because the second account in the row does not
 * carry one, and a card that drew an empty slot for it would be a card with a
 * hole in it.
 */
export function AccountCard({
  width,
  flag,
  kind,
  scheme,
  balance,
  number,
  valid,
}: {
  width: number;
  flag: FlagName;
  kind: string;
  scheme: boolean;
  balance: string;
  number: string;
  valid: string;
}) {
  return (
    <View
      style={{
        width,
        height: width * CARD_RATIO,
        borderRadius: radius.card,
        backgroundColor: fn.surface,
        borderWidth: 1,
        borderColor: fn.edge,
        padding: CARD_PAD,
        justifyContent: 'space-between',
        ...shadow.card,
      }}
    >
      <View style={{ flexDirection: 'row', alignItems: 'center' }}>
        <FlagDisc name={flag} size={20} />
        <T variant="cardKind" color={fn.ink} style={{ marginLeft: 7 }}>
          {kind}
        </T>
        <View style={{ flex: 1 }} />
        {scheme ? <SchemeMark color={fn.ink} /> : null}
      </View>

      <View>
        <T variant="cardLabel" color={fn.cardMuted}>
          {labels.balance}
        </T>
        <View style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
          <T variant="cardAmount" color={fn.ink}>
            {balance}
          </T>
          <Icon name="eye" size={15} color={fn.cardMuted} strokeWidth={1.8} />
        </View>
      </View>

      <View style={{ flexDirection: 'row', alignItems: 'flex-end' }}>
        <View>
          <T variant="cardLabel" color={fn.cardMuted}>
            {labels.number}
          </T>
          <T variant="cardValue" color={fn.ink}>
            {number}
          </T>
        </View>
        <View style={{ flex: 1 }} />
        <View style={{ alignItems: 'flex-end' }}>
          <T variant="cardLabel" color={fn.cardMuted}>
            {labels.valid}
          </T>
          <T variant="cardValue" color={fn.ink}>
            {valid}
          </T>
        </View>
      </View>
    </View>
  );
}
