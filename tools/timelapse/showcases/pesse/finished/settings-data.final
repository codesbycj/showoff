import { type SymbolName } from '../symbols';

/**
 * The settings screen's content.
 *
 * Rows carry a `trailing` that names what sits at their right edge. It is a
 * tagged shape rather than a set of optional fields, because a row has exactly
 * one of these and the alternative is four booleans with an undocumented rule
 * about which wins.
 */
export type Trailing =
  | { kind: 'toggle'; on: boolean }
  | { kind: 'chevron' }
  | { kind: 'pill'; text: string }
  | { kind: 'count'; text: string }
  | { kind: 'brand'; text: string };

export type SettingRow = {
  key: string;
  icon: SymbolName;
  title: string;
  subtitle: string;
  trailing: Trailing;
};

export type SettingGroup = {
  key: string;
  label: string;
  /** The small status to the right of the group label. Only the first has one. */
  status?: string;
  rows: readonly SettingRow[];
};

