/**
 * The dock. The bar reports which key was pressed and the screen decides where
 * it leads, so adding a destination is a line in a screen rather than a change
 * here.
 */
export const TABS = [
  { key: 'home', icon: 'accountBalanceWallet', label: 'Home', route: '/pesse/home' },
  { key: 'cards', icon: 'creditCard', label: 'Cards', route: '/pesse/cards' },
  { key: 'send', icon: 'currencyExchange', label: 'Send', route: '/pesse/send' },
  { key: 'settings', icon: 'settings', label: 'Settings', route: '/pesse/settings' },
] as const;

export type TabKey = (typeof TABS)[number]['key'];
