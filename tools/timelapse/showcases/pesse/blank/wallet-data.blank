import { type SymbolName } from '../symbols';
import { ps } from '../theme';

/**
 * The home screen's content, and the dock every tabbed screen shares.
 *
 * The Send-again rail's badges are a small type of their own: each contact
 * carries a linked banking network, drawn as either a letter, a short acronym
 * or an icon in a coloured disc. They are kept as a discriminated shape rather
 * than three optional fields, so a contact cannot end up with both a letter and
 * an icon and no rule about which wins.
 */
export type NetworkBadge =
  | { kind: 'letter'; text: string; fill: string; ink: string }
  | { kind: 'icon'; icon: SymbolName; fill: string; ink: string };

export type Contact = {
  key: string;
  name: string;
  photo: number;
  badge: NetworkBadge;
};

