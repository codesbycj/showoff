export type Txn = {
  key: string;
  title: string;
  when: string;
  amount: string;
  /** Credits are lime, debits are red. One flag, so the two cannot disagree. */
  credit: boolean;
  photo?: number;
  icon?: SymbolName;
  badge?: NetworkBadge;
};

