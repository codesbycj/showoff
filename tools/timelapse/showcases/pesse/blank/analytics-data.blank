import { type SymbolName } from '../symbols';

/**
 * The analytics screen's content.
 *
 * Bar heights are the reference's own percentages of the chart's 112dp band,
 * not derived from the amounts — Jun 18's $1,420 against Jun 30's $190 is a 7.5x
 * ratio, and the reference draws 92% against 20%, which is 4.6x. The chart is
 * eased, in other words, and deriving the heights would redraw it.
 */
export type Bar = {
  key: string;
  day: string;
  label: string;
  amount: string;
  /** Percentage of the chart band, as the reference gives it. */
  height: number;
};

export const BARS: readonly Bar[] = [
  { key: 'd04', day: '04', label: 'Jun 04', amount: '$310.00', height: 32 },
  { key: 'd09', day: '09', label: 'Jun 09', amount: '$520.40', height: 52 },
  { key: 'd14', day: '14', label: 'Jun 14', amount: '$280.10', height: 28 },
  { key: 'd18', day: '18', label: 'Jun 18 (Peak)', amount: '$1,420.00', height: 92 },
  { key: 'd22', day: '22', label: 'Jun 22', amount: '$640.00', height: 60 },
  { key: 'd26', day: '26', label: 'Jun 26', amount: '$410.80', height: 40 },
  { key: 'd30', day: '30', label: 'Jun 30', amount: '$190.00', height: 20 },
];

export type Category = {
  key: string;
  icon: SymbolName;
  title: string;
  subtitle: string;
  amount: string;
  share: string;
  /** The one category the design calls out, in lime with a dot beside it. */
  flagged?: boolean;
  /** Its slice of the stacked bar above the list, as a fraction. */
  weight: number;
  barTone: string;
};

