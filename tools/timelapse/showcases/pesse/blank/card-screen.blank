import { router } from 'expo-router';
import { StatusBar } from 'expo-status-bar';
import { useState } from 'react';
import { Pressable, ScrollView, Text, View } from 'react-native';
import { useSafeAreaInsets } from 'react-native-safe-area-context';

// STEP 3.01 back, and a title
// import { DetailHeader } from '@/features/pesse/components/detail-header';
// STEP 3.05 a card face
// import { PaymentCard } from '@/features/pesse/components/payment-card';
import { Symbol } from '@/features/pesse/components/symbol';
import { CARDS, SELECT_CARD } from '@/features/pesse/data/cards';
import { LEVEL, R, SP, TYPE, ps, pesseTheme } from '@/features/pesse/theme';

/**
 * Screen 3 — select card.
 *
 * A chooser, not a tab: it is reached from the balance pill on home and from
 * "Switch Card" on analytics, and it leaves by its own Close button. So it
 * carries no dock, and Close goes back rather than to a fixed destination —
 * whichever screen opened it is where Close returns to.
 */
export default function PesseSelectCard() {
  const insets = useSafeAreaInsets();
  const [active, setActive] = useState<string>(SELECT_CARD.activeKey);

  return (
    <View style={[pesseTheme, { flex: 1, backgroundColor: ps.surface }]}>
      <StatusBar style="dark" />

      <View style={{ paddingTop: insets.top, paddingHorizontal: SP.margin }}>
{/* STEP 3.02 name the screen
        <DetailHeader
          title={SELECT_CARD.navTitle}
          onBack={() => router.back()}
          action="help"
          photo={require('../../../assets/images/pesse/linda.jpg')}
          onProfile={() => router.push('/pesse/settings')}
        />
*/}
      </View>

      <ScrollView
        showsVerticalScrollIndicator={false}
        contentContainerStyle={{
          paddingHorizontal: SP.margin,
          paddingTop: SP.md,
          paddingBottom: 120 + insets.bottom,
        }}
      >
        <View
          style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between' }}
        >
          <View>
{/* STEP 3.03 say what to do
            <Text style={[TYPE.headlineMd, { color: ps.onSurface }]}>{SELECT_CARD.title}</Text>
*/}
            <Text style={[TYPE.bodySm, { color: ps.secondary, marginTop: 2 }]}>
              {SELECT_CARD.subtitle}
            </Text>
          </View>

          <Pressable accessibilityRole="button">
            <View
              style={[
                {
                  flexDirection: 'row',
                  alignItems: 'center',
                  gap: 6,
                  paddingHorizontal: 16,
                  paddingVertical: 8,
                  borderRadius: R.full,
                  backgroundColor: ps.surfaceLowest,
                },
                LEVEL.container,
              ]}
            >
              <Symbol name="add" size={18} color={ps.onSurface} />
{/* STEP 3.04 offer another
              <Text style={[TYPE.labelMd, { color: ps.onSurface }]}>{SELECT_CARD.newCard}</Text>
*/}
            </View>
          </Pressable>
        </View>

        <View style={{ marginTop: SP.lg, gap: SP.md }}>
{/* STEP 3.09 a fourth card that does not exist | FIX 3.10 remove it
          <DetailHeader title="Ghost card" />
*/}

{/* STEP 3.06 deal them out
          {CARDS.map((card) => (
            <PaymentCard
              key={card.key}
              card={card}
              selected={card.key === active}
              onPress={() => setActive(card.key)}
            />
          ))}
*/}
        </View>
      </ScrollView>

      {/* The Close button floats over the page, as the reference has it. */}
      <View
        style={{
          position: 'absolute',
          left: 0,
          right: 0,
          bottom: Math.max(insets.bottom, 12) + 12,
          alignItems: 'center',
        }}
      >
        <Pressable onPress={() => router.back()} accessibilityRole="button">
          <View
            style={[
              {
                flexDirection: 'row',
                alignItems: 'center',
                gap: 8,
                paddingHorizontal: 32,
                height: 56,
                borderRadius: R.full,
                backgroundColor: ps.inverse,
              },
              LEVEL.floating,
            ]}
          >
            <Symbol name="close" size={20} color={ps.onInverse} />
{/* STEP 3.11 and a way out
            <Text style={[TYPE.labelLg, { color: ps.onInverse }]}>{SELECT_CARD.close}</Text>
*/}
          </View>
        </Pressable>
      </View>
    </View>
  );
}
