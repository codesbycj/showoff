export type Product = {
  id: string;
  title: string;
  price: number;
  was: number;
  image: number;
  /** Only the first card is saved; declared, not inferred. */
  saved?: boolean;
};

/**
 * Four, not the board's two. Two filled one row and left 75dp of empty canvas
 * above the tab bar — an R1 GAP FAIL, and I3 says the fix is the row the board
 * cropped, never a spacer.
 */
