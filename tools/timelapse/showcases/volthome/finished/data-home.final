/**
 * Everything volthome says.
 *
 * **Every product is invented.** The board's shop front is a named console, a
 * named phone and a named pair of earbuds; a rebuild that ships those is
 * impersonation (I1).
 *
 * **R5: labels, not prose.** The board's own blurb runs to three lines and
 * ends in "Read more"; nothing here is longer than a label.
 *
 * Arrays are annotated, never inferred: the reveal stages them one entry at a
 * time (RULES §5.4, I7).
 */

export const brand = { name: 'Voltline' };

export const address = { label: 'Delivery address', value: '92 High Street, London' };

export const search = { hint: 'Search the entire shop' };

export const promo = {
  badge: '50%',
  lead: 'Delivery is',
  /** The board's own three words. Longer ran under the banner's own shape. */
  tail: 'cheaper',
};

export const sections = {
  categories: 'Categories',
  flash: 'Flash Sale',
  seeAll: 'See all',
};

/**
 * The sale timer, in seconds.
 *
 * **R9: it counts.** The board types "02:59:23" into a static frame; this one
 * is a real countdown, so the clock on screen is the time that is left.
 */
export const SALE_SECONDS = 2 * 3600 + 59 * 60 + 23;

export type Category = { id: string; label: string; image: number };

/** Five photographs, not five drawn marks — I4's category-tile rule. */
export const categories: Category[] = [
  {
    id: 'audio',
    label: 'Audio',
