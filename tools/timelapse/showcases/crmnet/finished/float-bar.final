import { useState } from 'react';
import { Pressable, View } from 'react-native';

import { bar, type BarKey } from '../data/network';
import { BAR_BUTTON, BAR_HEIGHT } from '../layout';
import { cn, radius, shadow } from '../theme';
import { Icon } from './icon';

/**
 * The bar floating over the grid: three things you can do to the list itself.
 *
 * Narrow and centred rather than full width, which is what the reference does
 * and what keeps it reading as an object rather than as a bar. Its width comes
 * from its contents, because three round targets have a natural size.
 */
export function FloatBar({ onSelect }: { onSelect?: (key: BarKey) => void }) {
  const [held, setHeld] = useState<BarKey | null>(null);

  return (
    <View
      style={{
        height: BAR_HEIGHT,
        borderRadius: radius.full,
        backgroundColor: cn.surface,
        flexDirection: 'row',
        alignItems: 'center',
        paddingHorizontal: 8,
        gap: 6,
        ...shadow.bar,
      }}
    >
      {bar.map((key) => (
        <Pressable
          key={key}
          onPress={() => onSelect?.(key)}
          onPressIn={() => setHeld(key)}
          onPressOut={() => setHeld(null)}
          accessibilityRole="button"
          accessibilityLabel={key}
        >
          <View
            style={{
              width: BAR_BUTTON,
              height: BAR_BUTTON,
              borderRadius: radius.full,
              backgroundColor: cn.canvas,
              alignItems: 'center',
              justifyContent: 'center',
              opacity: held === key ? 0.7 : 1,
            }}
          >
            <Icon name={key} size={17} />
          </View>
        </Pressable>
      ))}
    </View>
  );
}
