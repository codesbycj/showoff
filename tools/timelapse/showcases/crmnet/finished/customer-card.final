import { useState } from 'react';
import { Pressable, View } from 'react-native';

import { labels } from '../data/network';
import { CARD_AVATAR, CARD_BUTTON, CARD_HEIGHT, CARD_PAD } from '../layout';
import { cn, radius, shadow } from '../theme';
import { Avatar } from './avatar';
import { Icon } from './icon';
import { T } from './text';

/**
 * One customer, as a card in the grid.
 *
 * Three states, all the same card: ordinary, accented (the one the reference
 * picks out), and dimmed (one it greys back). `dim` drops the whole card's
 * opacity rather than restating every colour — a dimmed card is the same card
 * seen through less light, and listing nine faded variants of the palette is
 * how a theme stops being one.
 *
 * The visual box is an inner `View`, never the `Pressable`'s own style: a
 * `style={({pressed}) => …}` function is dropped in a static web render, and
 * the card would lose its fill and its height in every harness shot.
 */
export function CustomerCard({
  name,
  company,
  amount,
  face,
  accent,
  dim,
  onPress,
}: {
  name: string;
  company: string;
  amount: string;
  face: number;
  accent: boolean;
  dim: boolean;
  onPress?: () => void;
}) {
  const [held, setHeld] = useState(false);

  const fill = accent ? cn.accent : cn.surface;
  const ink = accent ? cn.onAccent : cn.text;

  return (
    <Pressable
      onPress={onPress}
      onPressIn={() => setHeld(true)}
      onPressOut={() => setHeld(false)}
      accessibilityRole="button"
      accessibilityLabel={`${name}, ${company}`}
      style={{ flex: 1 }}
    >
      <View
        style={{
          height: CARD_HEIGHT,
          borderRadius: radius.card,
          backgroundColor: fill,
          borderWidth: accent ? 0 : 1,
          borderColor: cn.edge,
          padding: CARD_PAD,
          justifyContent: 'space-between',
          opacity: dim ? 0.45 : held ? 0.9 : 1,
          ...shadow.card,
        }}
      >
        <View>
          <Avatar face={face} size={CARD_AVATAR} />

          <T variant="name" color={ink} numberOfLines={2} style={{ marginTop: 9 }}>
            {name}
          </T>
          <T variant="company" color={accent ? cn.onAccent : cn.muted} numberOfLines={2}>
            {company}
          </T>
        </View>

        <View style={{ flexDirection: 'row', alignItems: 'flex-end' }}>
          <View
            style={{
              flex: 1,
              paddingHorizontal: 10,
              paddingVertical: 6,
              borderRadius: radius.pill,
              backgroundColor: accent ? cn.surface : cn.pill,
            }}
          >
            <T variant="amount" color={cn.text} numberOfLines={1}>
              {amount}
            </T>
            <T variant="amountLabel" color={cn.muted}>
              {labels.pipeline}
            </T>
          </View>

          <View
            style={{
              width: CARD_BUTTON,
              height: CARD_BUTTON,
              borderRadius: radius.full,
              backgroundColor: cn.ink,
              alignItems: 'center',
              justifyContent: 'center',
              marginLeft: 7,
            }}
          >
            <Icon name="go" size={15} color={cn.onInk} strokeWidth={2.2} />
          </View>
        </View>
      </View>
    </Pressable>
  );
}
