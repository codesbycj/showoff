import { Pressable, ScrollView, View } from 'react-native';

import { FILTER_GAP, FILTER_HEIGHT, MARGIN } from '../layout';
import { cn, radius } from '../theme';
import { T } from './text';

/**
 * The filters, in a row that scrolls.
 *
 * Horizontal rather than a wrap, and the reference says so directly: its last
 * pill is cut by the right-hand edge of the screen, which a wrap layout
 * physically cannot reproduce.
 *
 * The padding is on the content container, not the view, so the first pill
 * lines up with the page margin while the row still scrolls edge to edge.
 */
export function FilterRow({
  items,
  active,
  onSelect,
}: {
  items: readonly string[];
  active: string;
  onSelect?: (item: string) => void;
}) {
  return (
    <ScrollView
      horizontal
      showsHorizontalScrollIndicator={false}
      contentContainerStyle={{ paddingHorizontal: MARGIN, gap: FILTER_GAP }}
    >
      {items.map((item) => {
        const on = item === active;
        return (
          <Pressable
            key={item}
            onPress={() => onSelect?.(item)}
            accessibilityRole="tab"
            accessibilityState={{ selected: on }}
          >
            <View
              style={{
                height: FILTER_HEIGHT,
                paddingHorizontal: 18,
                borderRadius: radius.pill,
                backgroundColor: on ? cn.ink : 'transparent',
                borderWidth: 1,
                borderColor: on ? cn.ink : cn.edge,
                alignItems: 'center',
                justifyContent: 'center',
              }}
            >
              <T variant={on ? 'filterOn' : 'filter'} color={on ? cn.onInk : cn.muted}>
                {item}
              </T>
            </View>
          </Pressable>
        );
      })}
    </ScrollView>
  );
}
