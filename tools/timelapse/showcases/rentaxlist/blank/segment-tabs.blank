import { Pressable, View } from 'react-native';

import { TAB_GAP, TAB_RULE } from '../layout';
import { radius, rx } from '../theme';
import { T } from './text';

/**
 * Premium and Exclusive, with a rule under the live one.
 *
 * The rule is a child of its own tab rather than a bar positioned under the
 * row, so it is exactly as wide as the word it underlines and cannot drift
 * when the labels change — a measured underline is the thing that breaks the
 * first time somebody translates the screen.
 */
export function SegmentTabs({
  items,
  active,
  onSelect,
}: {
  items: readonly { key: string; label: string; flag: string | null }[];
  active: string;
  onSelect?: (key: string) => void;
}) {
  return (
    <View style={{ flexDirection: 'row', gap: TAB_GAP }}>
      {/* STEP 1.09 one tab each
      {items.map((item) => {
        const on = item.key === active;
        return (
          <Pressable
            key={item.key}
            onPress={() => onSelect?.(item.key)}
            accessibilityRole="tab"
            accessibilityState={{ selected: on }}
          >
            <View style={{ alignItems: 'center' }}>
              <View style={{ flexDirection: 'row', alignItems: 'center', gap: 6 }}>
                <T variant={on ? 'tabOn' : 'tab'} color={on ? rx.onDark : rx.onDarkMuted}>
                  {item.label}
                </T>
                {item.flag ? (
                  <View
                    style={{
                      paddingHorizontal: 6,
                      paddingVertical: 2,
                      // MISTAKE 1.10 the flag came in adrift
                      marginLeft: 22,
                      borderRadius: radius.pill,
                      backgroundColor: rx.flag,
                    }}
                  >
                    <T variant="flag" color={rx.onFlag}>
                      {item.flag}
                    </T>
                  </View>
                ) : null}
              </View>
              <View
                style={{
                  height: TAB_RULE,
                  alignSelf: 'stretch',
                  marginTop: 7,
                  borderRadius: TAB_RULE,
                  backgroundColor: on ? rx.onDark : 'transparent',
                }}
              />
            </View>
          </Pressable>
        );
      })}
      */}
    </View>
  );
}
