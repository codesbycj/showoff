import { useState } from 'react';
import { Pressable, View } from 'react-native';

import { CARD_HEIGHT, CARD_PAD, PLATE_BUTTON, PLATE_HEIGHT } from '../layout';
import { radius, rx } from '../theme';
import { CarArt } from './car-art';
import { FaceStack } from './face-stack';
import { Icon } from './icon';
import { T } from './text';

/**
 * One car, as a card.
 *
 * The price plate sits in the card's bottom-left corner and is rounded only on
 * the corners that are *inside* the card, so it reads as cut out of it rather
 * than laid on top. The card itself needs no clip for this, which matters:
 * `overflow: 'hidden'` next to an `elevation` is unreliable on Android.
 *
 * The car is drawn, not photographed — see the note in `car-art.tsx`. It is
 * deliberately allowed to sit low and wide in the card's right half, which is
 * where the reference puts its cut-outs.
 */
export function CarCard({
  name,
  range,
  rating,
  recommend,
  priceLabel,
  price,
  card,
  body,
  swatch,
  onPress,
}: {
  name: string;
  range: string;
  rating: string;
  recommend: string;
  priceLabel: string;
  price: string;
  card: string;
  body: string;
  swatch: string;
  onPress?: () => void;
}) {
  const [held, setHeld] = useState(false);

  return (
    <Pressable
      onPress={onPress}
      onPressIn={() => setHeld(true)}
      onPressOut={() => setHeld(false)}
      accessibilityRole="button"
      accessibilityLabel={`${name}, ${price} a day`}
    >
      <View
        style={{
          height: CARD_HEIGHT,
          borderRadius: radius.card,
          // MISTAKE 1.23 the cards came in outlined
          borderWidth: 3,
          backgroundColor: card,
          padding: CARD_PAD,
          opacity: held ? 0.92 : 1,
        }}
      >
        {/* STEP 1.17 what colour it is
        <View style={{ flexDirection: 'row', alignItems: 'center' }}>
          <T variant="cardMeta" color={rx.onCardMuted}>
            Color:
          </T>
          <View
            style={{
              width: 9,
              height: 9,
              borderRadius: radius.full,
              backgroundColor: swatch,
              marginLeft: 5,
            }}
          />
          <View style={{ flex: 1 }} />
          <View
            style={{
              flexDirection: 'row',
              alignItems: 'center',
              gap: 4,
              paddingHorizontal: 9,
              paddingVertical: 4,
              borderRadius: radius.pill,
              backgroundColor: 'rgba(18, 18, 18, 0.1)',
            }}
          >
            <Icon name="range" size={12} color={rx.onCard} strokeWidth={2} />
            <T variant="cardPill" color={rx.onCard}>
              {range}
            </T>
          </View>
        </View>
        */}

        {/* STEP 1.18 which car
        <T variant="cardTitle" color={rx.onCard} style={{ marginTop: 8 }} numberOfLines={1}>
          {name}
        </T>
        */}

        <View style={{ flexDirection: 'row', alignItems: 'center', marginTop: 8 }}>
          {/* STEP 1.19 who has driven it
          <FaceStack ring={card} />
          */}
          <Icon name="star" size={12} color={rx.onCard} strokeWidth={2.2} />
          <T variant="rating" color={rx.onCard} style={{ marginLeft: 3 }}>
            {rating}
          </T>
        </View>

        {/* STEP 1.20 and what they thought
        <T variant="recommend" color={rx.onCardMuted} style={{ marginTop: 4 }}>
          {recommend}
        </T>
        */}

        {/* STEP 1.21 the car itself
        <View style={{ position: 'absolute', right: 2, bottom: 6 }} pointerEvents="none">
          <CarArt width={190} body={body} />
        </View>
        */}

        {/* STEP 1.22 and what it costs
        <View
          style={{
            position: 'absolute',
            left: 0,
            bottom: 0,
            height: PLATE_HEIGHT,
            flexDirection: 'row',
            alignItems: 'center',
            paddingLeft: CARD_PAD,
            paddingRight: 7,
            gap: 10,
            backgroundColor: rx.canvas,
            borderTopRightRadius: radius.card,
            borderBottomLeftRadius: radius.card,
          }}
        >
          <View>
            <T variant="priceLabel" color={rx.onDarkMuted}>
              {priceLabel}
            </T>
            <T variant="price" color={rx.onDark}>
              {price}
            </T>
          </View>
          <View
            style={{
              width: PLATE_BUTTON,
              height: PLATE_BUTTON,
              borderRadius: radius.full,
              borderWidth: 1,
              borderColor: rx.raisedEdge,
              alignItems: 'center',
              justifyContent: 'center',
            }}
          >
            <Icon name="go" size={15} color={rx.onDark} strokeWidth={2} />
          </View>
        </View>
        */}
      </View>
    </Pressable>
  );
}
