import { Image, Pressable, ScrollView, View } from 'react-native';

import { copy, events } from '../data/start';
import { EVENT_W, MARGIN, RAIL_MIN, RAIL_TOP, SECTION_TOP } from '../layout';
import { radius, type, vl } from '../theme';
import { T } from './text';

/** The heading over the rail. */
export function UpcomingHead({ onSeeAll }: { onSeeAll?: () => void }) {
  return (
    <View style={{ flexDirection: 'row', alignItems: 'center', marginTop: SECTION_TOP }}>
      <T variant="section" color={vl.ink} style={{ flex: 1, height: type.section.line }}>
        {copy.upcoming}
      </T>
      <Pressable
        onPress={onSeeAll}
        accessibilityRole="button"
        accessibilityLabel="See all upcoming events"
      >
        <T variant="seeAll" color={vl.muted} style={{ height: type.seeAll.line }}>
          {copy.seeAll}
        </T>
      </Pressable>
    </View>
  );
}

/** One card. Written out in `EventRail` so the reveal lands them singly. */
function Card({ i, onPress }: { i: number; onPress?: (id: string) => void }) {
  const e = events[i];
  return (
    <Pressable
      onPress={() => onPress?.(e.id)}
      style={{ alignSelf: 'stretch' }}
      accessibilityRole="button"
      accessibilityLabel={`${e.name}, ${e.level}`}
    >
      <View style={{ width: EVENT_W, marginRight: 12, flex: 1 }}>
        <View style={{ flex: 1, borderRadius: radius.card, overflow: 'hidden' }}>
          <Image
            source={e.photo}
            resizeMode="cover"
            style={{
              position: 'absolute',
              top: 0,
              left: 0,
              right: 0,
              bottom: 0,
              width: '100%',
              height: '100%',
            }}
          />

          <View style={{ flex: 1, justifyContent: 'flex-end', alignItems: 'center', padding: 10 }}>
            <View
              style={{
                paddingHorizontal: 10,
                paddingVertical: 5,
                borderRadius: radius.pill,
                backgroundColor: '#FFFFFFD9',
              }}
            >
              <T variant="chip" color={vl.green} style={{ height: type.chip.line }}>
                {e.level}
              </T>
            </View>
          </View>
        </View>

        <T variant="eventName" color={vl.ink} style={{ marginTop: 8, height: type.eventName.line }}>
          {e.name}
        </T>
      </View>
    </Pressable>
  );
}

/**
 * What is on soon.
 *
 * The rail bleeds past the page margin and puts the margin back as content
 * padding, so the second card is clipped by the right edge — which is how a
 * rail says there is more. The cards stretch to the rail's height, so the
 * screen fills rather than leaving a band of white above the dock.
 */
export function EventRail({ onPress }: { onPress?: (id: string) => void }) {
  return (
    <View style={{ flex: 1, minHeight: RAIL_MIN, marginTop: RAIL_TOP }}>
      <ScrollView
        horizontal
        showsHorizontalScrollIndicator={false}
        style={{ marginHorizontal: -MARGIN }}
        contentContainerStyle={{ paddingHorizontal: MARGIN, alignItems: 'stretch' }}
      >
        <Card i={0} onPress={onPress} />
        <Card i={1} onPress={onPress} />
      </ScrollView>
    </View>
  );
}
