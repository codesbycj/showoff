/**
 * Screen 2 content — live scores and schedule.
 *
 * This is the one screen with no usable reference render: Stitch's own
 * `screen.png` came back empty apart from the dock, so everything here is read
 * off the markup alone. That is the normal order of authority anyway — the
 * markup is the spec and the PNG is only a check on it — but it is worth
 * knowing that for this screen there was nothing to check against.
 *
 * `DATES`, `LEAGUES` and `MATCHES` carry explicit element types, because each is
 * emptied one entry at a time for the timelapse and an empty array literal
 * infers `never[]`.
 */

export const SEARCH = { placeholder: 'Search team, league, or match...' } as const;

export type CalendarDay = { key: string; weekday: string; day: string };

export const DATES: readonly CalendarDay[] = [
  { key: '12', weekday: 'Sun', day: '12' },
  { key: '13', weekday: 'Mon', day: '13' },
  { key: '14', weekday: 'Tue', day: '14' },
  { key: '15', weekday: 'Wed', day: '15' },
  { key: '16', weekday: 'Thu', day: '16' },
  { key: '17', weekday: 'Fri', day: '17' },
  { key: '18', weekday: 'Sat', day: '18' },
];

export type League = {
  key: string;
  label: string;
  icon: 'stars' | 'sportsSoccer' | 'shield' | 'militaryTech';
};

export const LEAGUES: readonly League[] = [
  { key: 'ucl', label: 'UEFA Champions League', icon: 'stars' },
  { key: 'epl', label: 'Premier League', icon: 'sportsSoccer' },
  { key: 'laliga', label: 'La Liga', icon: 'shield' },
  { key: 'seriea', label: 'Serie A', icon: 'militaryTech' },
];

export const BOARD = { title: "Live & Today's Fixtures", count: '3 Matches' } as const;

export type Team = { name: string; side: string; crest: number };

/** A 1/X/2 pill on a live card. */
export type MicroOdd = { key: string; label: string; value: string };

/** A stacked odds button on a scheduled card. */
export type PreOdd = { key: string; label: string; value: string };

/**
 * One fixture.
 *
 * `kind` splits the card into its two real shapes rather than making every
 * field optional: a live match shows a running clock, a score and three inline
 * 1/X/2 pills over a social footer; a scheduled one shows a kickoff time, a VS
 * badge and three stacked odds buttons over a projection footer. The shell
 * around them — venue meta, the seven-column team grid, a bled footer strip — is
 * the same, which is why they are still one component.
 */
export type Match =
  | {
      kind: 'live';
      key: string;
      venue: string;
      venueIcon: 'stadium' | 'sportsSoccer';
      clock: string;
      home: Team;
      away: Team;
      score: { home: string; away: string };
      /** Which side the lime highlight falls on, or neither. */
      lead: 'home' | 'away' | null;
      odds: readonly MicroOdd[];
      activeOdd: string;
      faces: readonly number[];
      social: string;
      action: string;
    }
  | {
      kind: 'scheduled';
      key: string;
      venue: string;
      venueIcon: 'schedule';
      kickoff: string;
      home: Team;
      away: Team;
      oddsTitle: string;
      oddsTag: string;
      odds: readonly PreOdd[];
      insight: string;
      action: string;
    };

