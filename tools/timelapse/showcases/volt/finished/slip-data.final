/**
 * Screen 4 content — the bet slip.
 *
 * `MODES`, `LEGS`, `CHIPS`, `SUMMARY` and `SETTLED` carry explicit element
 * types because each is emptied one entry at a time for the timelapse, and an
 * empty array literal infers `never[]`.
 */

export const SLIP = {
  title: 'Bet Slip',
  count: '(3 Selections)',
  clear: 'Clear',
  legsTitle: 'Active Legs in Slip',
  legsLive: '3 Live Matches',
} as const;

export type Mode = { key: string; label: string };

export const MODES: readonly Mode[] = [
  { key: 'single', label: 'Single' },
  { key: 'parlay', label: 'Parlay / Multi' },
  { key: 'system', label: 'System' },
];

export const BOOST = {
  title: 'Boost Activated',
  badge: '+15%',
  blurb: 'Multi-Match Acca Booster applied',
  was: '6.37x',
  now: '7.33x',
} as const;

/**
 * One leg of the parlay.
 *
 * `state` drives both the trailing badge and the tracker bar: a winning leg
 * takes a lime tick and a lime bar, a pending one an hourglass and a sage bar.
 * `progress` is the bar's fill, which the export sets per leg as `w-full`,
 * `w-[70%]` and `w-[45%]`.
 */
export type Leg = {
  key: string;
  league: string;
  minute: string;
  /** The third leg's minute marker is sage, not lime — it is not winning. */
  live: boolean;
  fixture: string;
  market: string;
  odds: string;
  state: 'winning' | 'pending';
  progress: number;
};

