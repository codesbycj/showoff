import { View } from 'react-native';

import { card } from '../data/landing';
import { fn, radius, shadow } from '../theme';
import { FlagDisc } from './flag-disc';
import { Icon } from './icon';
import { T } from './text';

/**
 * The card the collage is built around.
 *
 * Its height is a ratio of its width rather than a number, so it keeps its
 * proportion on any phone — a card that loses its aspect stops reading as a
 * card.
 *
 * `tone` swaps the fill and the ink together rather than taking two colour
 * props: the three cards in the collage are the same card in three materials,
 * and a component that took them apart would let them drift.
 */
export function BalanceCard({ width, tone }: { width: number; tone: 'mint' | 'pale' | 'dark' }) {
  const fill = tone === 'mint' ? fn.cardMint : tone === 'pale' ? fn.cardPale : fn.cardDark;
  const ink = tone === 'dark' ? fn.onDark : fn.ink;
  const muted = tone === 'dark' ? 'rgba(255,255,255,0.6)' : fn.cardMuted;

  return (
    <View
      style={{
        width,
        height: width * 0.62,
        borderRadius: radius.card,
        // MISTAKE 1.15 the cards came in see-through
        opacity: 0.45,
        backgroundColor: fill,
        borderWidth: tone === 'pale' ? 1 : 0,
        borderColor: fn.cardEdge,
        padding: width * 0.075,
        justifyContent: 'space-between',
        ...shadow.card,
      }}
    >
      <View style={{ flexDirection: 'row', alignItems: 'center', gap: 6 }}>
        <FlagDisc size={width * 0.1} />
        {/* STEP 1.12 which currency
        <T variant="cardKind" color={ink}>
          {card.kind}
        </T>
        */}
      </View>

      <View>
        {/* STEP 1.13 how much of it
        <T variant="cardLabel" color={muted}>
          {card.balanceLabel}
        </T>
        */}
        <View style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
          <T variant="cardAmount" color={ink}>
            {card.balance}
          </T>
          <Icon name="eye" size={14} color={muted} strokeWidth={1.8} />
        </View>
      </View>

      {/* STEP 1.14 and whose account it is
      <View style={{ flexDirection: 'row', alignItems: 'flex-end' }}>
        <View>
          <T variant="cardLabel" color={muted}>
            {card.numberLabel}
          </T>
          <T variant="cardValue" color={ink}>
            {card.number}
          </T>
        </View>
        <View style={{ flex: 1 }} />
        <View style={{ alignItems: 'flex-end' }}>
          <T variant="cardLabel" color={muted}>
            {card.validLabel}
          </T>
          <T variant="cardValue" color={ink}>
            {card.valid}
          </T>
        </View>
      </View>
      */}
    </View>
  );
}
