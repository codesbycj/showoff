import { router } from 'expo-router';
import { StatusBar } from 'expo-status-bar';
import { ScrollView, Text, View } from 'react-native';
import { useSafeAreaInsets } from 'react-native-safe-area-context';

import { AppHeader, TabBar } from '@/features/redbrew/components/bits';
import { LiveOrderCard, OrderRow } from '@/features/redbrew/components/order-parts';
import { Symbol } from '@/features/redbrew/components/symbol';
import { HOME } from '@/features/redbrew/data/home';
import { TABS } from '@/features/redbrew/data/nav';
import { HISTORY, ORDERS } from '@/features/redbrew/data/orders';
import { SP, TYPE, rb, redbrewTheme } from '@/features/redbrew/theme';

/**
 * Screen 5 — order history and review.
 *
 * The live order gets an elevated panel of its own at the top, with the review
 * block folded into it, and the settled orders follow as a plain list. That
 * split is the reference's: one order is being acted on, the rest are records.
 */
export default function RedbrewOrders() {
  const insets = useSafeAreaInsets();

  return (
    <View style={[redbrewTheme, { flex: 1, backgroundColor: rb.bg }]}>
      <StatusBar style="dark" />

      <View style={{ paddingTop: insets.top, paddingHorizontal: SP.margin }}>
        <AppHeader
          section={ORDERS.section}
          store={HOME.store}
          avatar={require('../../../assets/images/redbrew/alex.jpg')}
          onBell={() => router.push('/redbrew/tracking')}
          onAvatar={() => router.push('/redbrew/profile')}
          onStore={() => router.push('/redbrew/profile')}
        />
      </View>

      <ScrollView
        showsVerticalScrollIndicator={false}
        contentContainerStyle={{
          paddingHorizontal: SP.margin,
          paddingBottom: SP.lg,
          gap: SP.lg,
        }}
      >
        <LiveOrderCard
          onSubmit={() => router.push('/redbrew')}
          onSkip={() => router.push('/redbrew')}
        />

        <View style={{ gap: SP.md }}>
          <View
            style={{
              flexDirection: 'row',
              alignItems: 'center',
              justifyContent: 'space-between',
            }}
          >
            <View style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
              <Symbol name="historyEdu" size={22} color={rb.crimson} />
              <Text style={[TYPE.headlineMd, { color: rb.ink }]}>{ORDERS.historyTitle}</Text>
            </View>
            <Text style={[TYPE.labelMd, { color: rb.secondary }]}>{ORDERS.historyCount}</Text>
          </View>

          <View style={{ gap: SP.md }}>
            {HISTORY.map((o) => (
              <OrderRow
                key={o.key}
                order={o}
                onAction={() =>
                  router.push(o.tone === 'live' ? '/redbrew/tracking' : '/redbrew/cart')
                }
              />
            ))}
          </View>
        </View>
      </ScrollView>

      <View style={{ paddingBottom: Math.max(insets.bottom, 8) }}>
        <TabBar
          active="orders"
          onSelect={(key) => {
            const tab = TABS.find((t) => t.key === key);
            if (tab && key !== 'orders') router.push(tab.route);
          }}
        />
      </View>
    </View>
  );
}
