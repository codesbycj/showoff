import { Image } from 'expo-image';
import { router } from 'expo-router';
import { StatusBar } from 'expo-status-bar';
import { useId, useState } from 'react';
import { Pressable, View } from 'react-native';
import Svg, { Defs, LinearGradient, Path, Rect, Stop } from 'react-native-svg';

import { T } from '@/features/primeplan/components/text';
import { copy, faces, savePct } from '@/features/primeplan/data/plan';
import { ct, radius, type } from '@/features/primeplan/theme';
import { useInsets } from '@/features/primeplan/use-insets';

const MARGIN = 20;

/** A laurel branch, drawn: a curved stem with leaves down one side. */
function Laurel({ size = 92, flip = false }: { size?: number; flip?: boolean }) {
  const leaves = [0, 1, 2, 3, 4, 5].map((i) => {
    const t = i / 5;
    const x = 46 - 30 * Math.sin(t * 1.5);
    const y = 16 + 72 * t;
    const r = -40 + t * 50;
    return { x, y, r, s: 1 - t * 0.28 };
  });
  return (
    <View style={{ width: size, height: size, transform: flip ? [{ scaleX: -1 }] : undefined }}>
      <Svg width={size} height={size} viewBox="0 0 100 100">
        <Path
          d="M50 12C34 30 28 54 36 86"
          stroke={ct.blue}
          strokeWidth="5"
          fill="none"
          strokeLinecap="round"
        />
        {leaves.map((l, i) => (
          <Path
            key={i}
            d="M0 0c9-6 19-3 23 4-7 6-18 5-23-4Z"
            fill={i % 2 ? ct.blue : ct.blueDeep}
            transform={`translate(${l.x} ${l.y}) rotate(${l.r}) scale(${l.s.toFixed(2)})`}
          />
        ))}
      </Svg>
    </View>
  );
}

function Star({ size = 22 }: { size?: number }) {
  return (
    <Svg width={size} height={size} viewBox="0 0 24 24">
      <Path
        fill={ct.blue}
        d="M12 2.6 14.8 8.6l6.4.9-4.6 4.5 1.1 6.4L12 17.4 6.3 20.4l1.1-6.4L2.8 9.5l6.4-.9Z"
      />
    </Svg>
  );
}

function Glyph({
  name,
  size = 16,
  tint,
}: {
  name: 'lock' | 'clock' | 'target' | 'check' | 'back' | 'arrow';
  size?: number;
  tint: string;
}) {
  const s = {
    stroke: tint,
    strokeWidth: 1.9,
    strokeLinecap: 'round' as const,
    strokeLinejoin: 'round' as const,
    fill: 'none',
  };
  return (
    <Svg width={size} height={size} viewBox="0 0 24 24">
      {name === 'lock' && (
        <>
          <Rect {...s} x="4.8" y="10.4" width="14.4" height="9.8" rx="3" />
          <Path {...s} d="M8.4 10.4V7.8a3.6 3.6 0 0 1 7.2 0v2.6" />
        </>
      )}
      {name === 'clock' && (
        <>
          <Path {...s} d="M20.2 12a8.2 8.2 0 1 1-8.2-8.2" />
          <Path {...s} d="M12 7.6V12l3 1.8" />
        </>
      )}
      {name === 'target' && (
        <>
          <Path {...s} d="M20.2 12a8.2 8.2 0 1 1-4.6-7.4" />
          <Path {...s} d="m8.6 11.6 2.8 2.8 8-8.4" />
        </>
      )}
      {name === 'check' && (
        <>
          <Path fill={tint} d="M12 2.8A9.2 9.2 0 1 1 2.8 12 9.2 9.2 0 0 1 12 2.8Z" />
          <Path
            d="m7.8 12.2 2.8 2.8 5.6-5.8"
            stroke="#FFFFFF"
            strokeWidth={2}
            fill="none"
            strokeLinecap="round"
            strokeLinejoin="round"
          />
        </>
      )}
      {name === 'back' && <Path {...s} strokeWidth={2.2} d="m14.2 5.6-6.4 6.4 6.4 6.4" />}
      {name === 'arrow' && <Path {...s} strokeWidth={2.2} d="M5 12h13M12.8 6.6 18.2 12l-5.4 5.4" />}
    </Svg>
  );
}

/**
 * PrimeFit — the paywall.
 *
 * Assembly only: the brand, the proof, the plan it unlocks, the two prices,
 * and the one button.
 *
 * The sky is a drawn gradient in SVG user space rather than
 * `expo-linear-gradient`, which mirrors a diagonal on the web render. The
 * laurels either side of the stars are drawn too: the reference's are a 3D
 * render, and a branch of leaves is an idea rather than an arrangement.
 */
export default function PrimeplanScreen() {
  const insets = useInsets();
  const [yearly, setYearly] = useState(true);
  const sky = `primeSky-${useId()}`;

  return (
    <View style={{ flex: 1, backgroundColor: ct.page }}>
      <StatusBar style="dark" />

      <Svg width="100%" height="56%" style={{ position: 'absolute', top: 0 }}>
        <Defs>
          <LinearGradient id={sky} x1="0" y1="0" x2="0" y2="1">
            <Stop offset="0" stopColor={ct.skyTop} />
            <Stop offset="0.72" stopColor={ct.skyBottom} />
            {/* Ending on the page's own white, so the sky fades out instead
                of stopping on a hard line across the screen. */}
            <Stop offset="1" stopColor={ct.page} />
          </LinearGradient>
        </Defs>
        <Rect x="0" y="0" width="100%" height="100%" fill={`url(#${sky})`} />
      </Svg>

      <View style={{ flex: 1, paddingTop: insets.top + 6, paddingHorizontal: MARGIN }}>
        <View style={{ flexDirection: 'row', alignItems: 'center', height: 48 }}>
          <Pressable
            accessibilityRole="button"
            accessibilityLabel="Back"
            onPress={() => router.back()}
          >
            <View
              style={{
                width: 44,
                height: 44,
                borderRadius: 22,
                backgroundColor: ct.page,
                alignItems: 'center',
                justifyContent: 'center',
              }}
            >
              <Glyph name="back" size={19} tint={ct.ink} />
            </View>
          </Pressable>
          <View
            style={{
              flex: 1,
              flexDirection: 'row',
              alignItems: 'center',
              justifyContent: 'center',
            }}
          >
            <T variant="brand" color={ct.ink} style={{ height: type.brand.line }}>
              {copy.brand}
            </T>
            <View
              style={{
                height: 26,
                paddingHorizontal: 10,
                borderRadius: radius.pill,
                backgroundColor: ct.blue,
                alignItems: 'center',
                justifyContent: 'center',
                marginLeft: 8,
              }}
            >
              <T variant="badge" color={ct.onBlue} style={{ height: type.badge.line }}>
                {copy.max}
              </T>
            </View>
          </View>
          <View style={{ width: 44 }} />
        </View>

        <View style={{ flex: 1, flexDirection: 'row', alignItems: 'center', minHeight: 168 }}>
          <Laurel size={92} />
          <View style={{ flex: 1, alignItems: 'center' }}>
            <View style={{ flexDirection: 'row', alignItems: 'center' }}>
              {faces.map((f, i) => (
                <View
                  key={i}
                  style={{
                    width: 30,
                    height: 30,
                    borderRadius: 15,
                    overflow: 'hidden',
                    borderWidth: 2,
                    borderColor: ct.page,
                    marginLeft: i === 0 ? 0 : -10,
                  }}
                >
                  <Image source={f} style={{ width: 26, height: 26 }} contentFit="cover" />
                </View>
              ))}
              <View
                style={{
                  height: 26,
                  paddingHorizontal: 9,
                  borderRadius: 13,
                  backgroundColor: ct.page,
                  alignItems: 'center',
                  justifyContent: 'center',
                  marginLeft: 6,
                }}
              >
                <T variant="count" color={ct.ink} style={{ height: type.count.line }}>
                  {copy.count}
                </T>
              </View>
            </View>

            <View style={{ flexDirection: 'row', marginTop: 12 }}>
              {[0, 1, 2, 3, 4].map((i) => (
                <View key={i} style={{ marginHorizontal: 2 }}>
                  <Star size={22} />
                </View>
              ))}
            </View>

            <T variant="claim" color={ct.ink} style={{ textAlign: 'center', marginTop: 10 }}>
              {copy.claim}
            </T>
          </View>
          <Laurel size={92} flip />
        </View>

        <View
          style={{
            borderRadius: radius.card,
            backgroundColor: ct.page,
            padding: 16,
            shadowColor: '#0B2A52',
            shadowOpacity: 0.08,
            shadowRadius: 18,
            shadowOffset: { width: 0, height: 8 },
            elevation: 4,
          }}
        >
          <View style={{ flexDirection: 'row', alignItems: 'center' }}>
            <Glyph name="lock" size={16} tint={ct.ink} />
            <T
              variant="cardTitle"
              color={ct.ink}
              style={{ flex: 1, height: type.cardTitle.line, marginLeft: 7 }}
            >
              {copy.planTitle}
            </T>
            <View
              style={{
                height: 26,
                paddingHorizontal: 10,
                borderRadius: radius.pill,
                backgroundColor: ct.blueSoft,
                alignItems: 'center',
                justifyContent: 'center',
              }}
            >
              <T variant="chip" color={ct.blueDeep} style={{ height: type.chip.line }}>
                {copy.locked}
              </T>
            </View>
          </View>

          <View style={{ flexDirection: 'row', alignItems: 'center', marginTop: 14 }}>
            {[
              { label: copy.today, value: copy.todayWeight, icon: 'clock' as const },
              { label: copy.later, value: copy.laterWeight, icon: 'target' as const },
            ].map((tile, i) => (
              <View
                key={tile.label}
                style={{ flex: 1, flexDirection: 'row', alignItems: 'center' }}
              >
                {i === 1 ? (
                  <View style={{ marginHorizontal: 10 }}>
                    <Glyph name="arrow" size={18} tint={ct.ink} />
                  </View>
                ) : null}
                <View
                  style={{
                    flex: 1,
                    borderRadius: radius.tile,
                    backgroundColor: ct.tile,
                    paddingVertical: 12,
                    alignItems: 'center',
                  }}
                >
                  <View style={{ flexDirection: 'row', alignItems: 'center' }}>
                    <Glyph name={tile.icon} size={14} tint={ct.muted} />
                    <T
                      variant="tileLabel"
                      color={ct.muted}
                      style={{ height: type.tileLabel.line, marginLeft: 5 }}
                    >
                      {tile.label}
                    </T>
                  </View>
                  <T
                    variant="tileValue"
                    color={ct.ink}
                    style={{ height: type.tileValue.line, marginTop: 2 }}
                  >
                    {tile.value}
                  </T>
                </View>
              </View>
            ))}
          </View>

          <View
            style={{
              flexDirection: 'row',
              alignItems: 'center',
              justifyContent: 'center',
              marginTop: 14,
              height: 46,
              borderRadius: radius.tile,
              borderWidth: 1,
              borderColor: ct.hairline,
            }}
          >
            <Glyph name="check" size={18} tint={ct.blue} />
            <T
              variant="feature"
              color={ct.ink}
              style={{ height: type.feature.line, marginLeft: 8 }}
            >
              {copy.feature}
            </T>
          </View>
        </View>

        <View style={{ flexDirection: 'row', marginTop: 16 }}>
          {[
            { id: 'weekly', name: copy.weekly, price: copy.weeklyPrice, unit: copy.weeklyUnit },
            { id: 'yearly', name: copy.yearly, price: copy.yearlyPrice, unit: copy.yearlyUnit },
          ].map((plan, i) => {
            const on = (plan.id === 'yearly') === yearly;
            return (
              <Pressable
                key={plan.id}
                accessibilityRole="button"
                accessibilityLabel={`${plan.name}, ${plan.price} ${plan.unit}`}
                accessibilityState={{ selected: on }}
                onPress={() => setYearly(plan.id === 'yearly')}
                style={{ flex: 1, marginLeft: i === 0 ? 0 : 12 }}
              >
                <View
                  style={{
                    borderRadius: radius.tile,
                    borderWidth: on ? 2 : 1,
                    borderColor: on ? ct.blue : ct.hairline,
                    paddingHorizontal: 14,
                    paddingVertical: 14,
                  }}
                >
                  <T variant="planName" color={ct.muted} style={{ height: type.planName.line }}>
                    {plan.name}
                  </T>
                  <View style={{ flexDirection: 'row', alignItems: 'baseline', marginTop: 2 }}>
                    <T variant="planPrice" color={ct.ink} style={{ height: type.planPrice.line }}>
                      {plan.price}
                    </T>
                    <T
                      variant="planUnit"
                      color={ct.muted}
                      style={{ height: type.planUnit.line, marginLeft: 3 }}
                    >
                      {plan.unit}
                    </T>
                  </View>
                </View>

                {plan.id === 'yearly' ? (
                  <View
                    style={{
                      position: 'absolute',
                      top: -13,
                      alignSelf: 'center',
                      height: 24,
                      paddingHorizontal: 10,
                      borderRadius: 12,
                      backgroundColor: ct.blue,
                      alignItems: 'center',
                      justifyContent: 'center',
                    }}
                  >
                    <T variant="chip" color={ct.onBlue} style={{ height: type.chip.line }}>
                      {`Save ${savePct}% · ${copy.best}`}
                    </T>
                  </View>
                ) : null}
              </Pressable>
            );
          })}
        </View>

        <T
          variant="fine"
          color={ct.faint}
          style={{ height: type.fine.line, textAlign: 'center', marginTop: 14 }}
        >
          {copy.fine}
        </T>

        <Pressable
          accessibilityRole="button"
          accessibilityLabel={copy.cta}
          style={{ marginTop: 10, marginBottom: insets.bottom + 10 }}
        >
          {({ pressed }) => (
            <View
              style={{
                height: 58,
                borderRadius: radius.cta,
                backgroundColor: ct.blue,
                alignItems: 'center',
                justifyContent: 'center',
                opacity: pressed ? 0.9 : 1,
              }}
            >
              <T variant="cta" color={ct.onBlue} style={{ height: type.cta.line }}>
                {copy.cta}
              </T>
            </View>
          )}
        </Pressable>
      </View>
    </View>
  );
}
