import { router } from 'expo-router';
import { StatusBar } from 'expo-status-bar';
import { Pressable, View } from 'react-native';

import { Orb } from '@/features/glucompanion/components/mascot';
import { T } from '@/features/glucompanion/components/text';
import { copy, page, pages } from '@/features/glucompanion/data/companion';
import { ct, radius, type } from '@/features/glucompanion/theme';
import { useInsets } from '@/features/glucompanion/use-insets';

const MARGIN = 24;

/**
 * Glu — the companion, and the way in.
 *
 * Assembly only: the orb, the promise, the dots, and the two ways to start.
 *
 * The screen is near-black, so every grey on it is picked against black
 * rather than carried over from the two light screens before it — the same
 * token at the same value would read about 3:1 here.
 *
 * "Terms" and "Privacy Policy" are two controls rather than one sentence,
 * because they are two destinations. The reference underlines both and
 * links neither.
 */
export default function GlucompanionScreen() {
  const insets = useInsets();

  return (
    <View style={{ flex: 1, backgroundColor: '#0C0C0D' }}>
      <StatusBar style="light" />

      <View
        style={{
          flex: 1,
          paddingTop: insets.top + 10,
          paddingBottom: insets.bottom + 4,
          paddingHorizontal: MARGIN,
        }}
      >
        {/* The orb sits at the foot of its band rather than centred in it:
            centred, the slack split above and below and the 70dp underneath
            read as a hole between the orb and the headline. Above it the
            slack is the status bar's own space, which is not a gap. */}
        <View style={{ flex: 1, alignItems: 'center', justifyContent: 'flex-end', minHeight: 230 }}>
          <Orb size={262} />
        </View>

        <T variant="display" color="#FFFFFF" style={{ marginTop: 18 }}>
          {copy.headline}
        </T>

        <T variant="body" color="rgba(255,255,255,0.72)" style={{ marginTop: 10 }}>
          {copy.body}
        </T>

        <View style={{ flexDirection: 'row', alignItems: 'center', marginTop: 22 }}>
          {Array.from({ length: pages }).map((_, i) => (
            <View
              key={i}
              style={{
                width: i === page ? 18 : 6,
                height: 6,
                borderRadius: 3,
                marginRight: 5,
                backgroundColor: i === page ? '#FFFFFF' : 'rgba(255,255,255,0.26)',
              }}
            />
          ))}
        </View>

        <Pressable
          accessibilityRole="button"
          accessibilityLabel={copy.email}
          onPress={() => router.push('/gluwhy')}
          style={{ marginTop: 20 }}
        >
          {({ pressed }) => (
            <View
              style={{
                height: 58,
                borderRadius: radius.cta,
                backgroundColor: '#FFFFFF',
                alignItems: 'center',
                justifyContent: 'center',
                opacity: pressed ? 0.9 : 1,
              }}
            >
              <T variant="cta" color={ct.ink} style={{ height: type.cta.line }}>
                {copy.email}
              </T>
            </View>
          )}
        </Pressable>

        <Pressable
          accessibilityRole="button"
          accessibilityLabel={copy.noAccount}
          style={{ marginTop: 10 }}
        >
          {({ pressed }) => (
            <View
              style={{
                height: 58,
                borderRadius: radius.cta,
                backgroundColor: '#1D1D20',
                alignItems: 'center',
                justifyContent: 'center',
                opacity: pressed ? 0.9 : 1,
              }}
            >
              <T variant="cta" color="rgba(255,255,255,0.86)" style={{ height: type.cta.line }}>
                {copy.noAccount}
              </T>
            </View>
          )}
        </Pressable>

        <View
          style={{
            flexDirection: 'row',
            flexWrap: 'wrap',
            justifyContent: 'center',
            alignItems: 'center',
            marginTop: 14,
          }}
        >
          <T
            variant="pillNote"
            color="rgba(255,255,255,0.56)"
            style={{ height: type.pillNote.line }}
          >
            {copy.legalLead}
          </T>
          <Pressable
            accessibilityRole="button"
            accessibilityLabel={copy.terms}
            style={{ paddingVertical: 14, paddingHorizontal: 5 }}
          >
            <T
              variant="pillNote"
              color="#FFFFFF"
              style={{ height: type.pillNote.line, textDecorationLine: 'underline' }}
            >
              {copy.terms}
            </T>
          </Pressable>
          <T
            variant="pillNote"
            color="rgba(255,255,255,0.56)"
            style={{ height: type.pillNote.line }}
          >
            {copy.legalMid}
          </T>
          <Pressable
            accessibilityRole="button"
            accessibilityLabel={copy.privacy}
            style={{ paddingVertical: 14, paddingHorizontal: 5 }}
          >
            <T
              variant="pillNote"
              color="#FFFFFF"
              style={{ height: type.pillNote.line, textDecorationLine: 'underline' }}
            >
              {copy.privacy}
            </T>
          </Pressable>
        </View>
      </View>
    </View>
  );
}
