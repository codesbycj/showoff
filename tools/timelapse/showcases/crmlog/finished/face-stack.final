import { Image, View } from 'react-native';

import { faces } from '../data/history';
import { FACE } from '../layout';
import { radius } from '../theme';
import { FACES } from './faces';

/**
 * The three people on a deal, overlapping.
 *
 * Each disc after the first is pulled back over the one before it with a
 * negative margin rather than being absolutely positioned, so the stack's
 * width is still its own and whatever sits beside it cannot be overlapped.
 *
 * The ring is the card's own colour, passed in: the stack sits on four
 * different cards and a hardcoded ring reads as a mistake on three of them.
 */
export function FaceStack({ ring }: { ring: string }) {
  return (
    <View style={{ flexDirection: 'row' }}>
      {faces.map((face, i) => (
        <Image
          key={face.key}
          source={FACES[face.face]}
          style={{
            width: FACE,
            height: FACE,
            borderRadius: radius.full,
            borderWidth: 2,
            borderColor: ring,
            marginLeft: i === 0 ? 0 : -FACE * 0.34,
          }}
          resizeMode="cover"
          accessibilityIgnoresInvertColors
        />
      ))}
    </View>
  );
}
