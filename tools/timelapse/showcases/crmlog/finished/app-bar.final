import { useState } from 'react';
import { Pressable, View } from 'react-native';

import { HEADER_BUTTON } from '../layout';
import { cl, radius } from '../theme';
import { Icon, type IconName } from './icon';
import { T } from './text';

/**
 * The header: a round button either side of a two-line title.
 *
 * Ranged left between the buttons rather than centred, which is what the
 * reference does — a two-line title centred between two controls reads as a
 * heading that has lost its left edge.
 */
export function AppBar({
  one,
  two,
  onBack,
  onShare,
}: {
  one: string;
  two: string;
  onBack?: () => void;
  onShare?: () => void;
}) {
  return (
    <View style={{ flexDirection: 'row', alignItems: 'center' }}>
      <RoundButton name="back" onPress={onBack} label="Go back" />

      <View style={{ flex: 1, marginHorizontal: 12 }}>
        <T variant="title" color={cl.onDark}>
          {one}
        </T>
        <T variant="title" color={cl.onDark}>
          {two}
        </T>
      </View>

      <RoundButton name="share" onPress={onShare} label="Share" />
    </View>
  );
}

function RoundButton({
  name,
  onPress,
  label,
}: {
  name: IconName;
  onPress?: () => void;
  label: string;
}) {
  const [held, setHeld] = useState(false);

  return (
    <Pressable
      onPress={onPress}
      onPressIn={() => setHeld(true)}
      onPressOut={() => setHeld(false)}
      accessibilityRole="button"
      accessibilityLabel={label}
    >
      <View
        style={{
          width: HEADER_BUTTON,
          height: HEADER_BUTTON,
          borderRadius: radius.full,
          backgroundColor: cl.raised,
          borderWidth: 1,
          borderColor: cl.raisedEdge,
          alignItems: 'center',
          justifyContent: 'center',
          opacity: held ? 0.7 : 1,
        }}
      >
        <Icon name={name} size={17} />
      </View>
    </Pressable>
  );
}
