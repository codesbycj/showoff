import { router } from 'expo-router';
import { StatusBar } from 'expo-status-bar';
import { Pressable, View } from 'react-native';
import Svg, { Circle, Path, Rect } from 'react-native-svg';

import { T } from '@/features/acropay/components/text';
import { Wallet } from '@/features/acropay/components/wallet';
import { copy, features, saving } from '@/features/acropay/data/pay';
import { ct, radius, type } from '@/features/acropay/theme';
import { useAcroLayout } from '@/features/acropay/layout';
import { useInsets } from '@/features/acropay/use-insets';

/** The three feature glyphs, the close control and the laurels — all drawn. */
function Glyph({
  name,
  size = 22,
  tint = ct.muted,
}: {
  name: 'ticket' | 'note' | 'bell' | 'close' | 'star' | 'medal';
  size?: number;
  tint?: string;
}) {
  const s = {
    stroke: tint,
    strokeWidth: 1.7,
    strokeLinecap: 'round' as const,
    strokeLinejoin: 'round' as const,
    fill: 'none',
  };
  return (
    <Svg width={size} height={size} viewBox="0 0 24 24">
      {name === 'ticket' && (
        <>
          <Path
            {...s}
            d="M3.4 9.4V7.8a2.4 2.4 0 0 1 2.4-2.4h12.4a2.4 2.4 0 0 1 2.4 2.4v1.6a2.6 2.6 0 0 0 0 5.2v1.6a2.4 2.4 0 0 1-2.4 2.4H5.8a2.4 2.4 0 0 1-2.4-2.4v-1.6a2.6 2.6 0 0 0 0-5.2Z"
          />
          <Path {...s} d="M14 7.6v8.8" strokeDasharray="2.4 2.6" />
        </>
      )}
      {name === 'note' && (
        <>
          <Rect {...s} x="2.8" y="6.4" width="18.4" height="11.2" rx="2.6" />
          <Circle {...s} cx="12" cy="12" r="2.8" />
          <Path {...s} d="M6.2 9.6v4.8M17.8 9.6v4.8" />
        </>
      )}
      {name === 'bell' && (
        <>
          <Path {...s} d="M18 9.2a6 6 0 1 0-12 0c0 5-1.4 6.4-1.4 6.4h14.8S18 14.2 18 9.2Z" />
          <Path {...s} d="M13.7 19a2 2 0 0 1-3.4 0" />
        </>
      )}
      {name === 'close' && <Path {...s} strokeWidth={2} d="m6.6 6.6 10.8 10.8M17.4 6.6 6.6 17.4" />}
      {name === 'star' && (
        <Path
          fill={tint}
          d="M12 2.8 14.8 8.6l6.4.9-4.6 4.5 1.1 6.4L12 17.4 6.3 20.4l1.1-6.4L2.8 9.5l6.4-.9Z"
        />
      )}
      {name === 'medal' && (
        <Path
          fill={tint}
          d="M18.4 3.2c0 6.6-2.4 12-6.6 15.4 1-6.2 3-11.4 6.6-15.4Zm-3.6 3.4c-1 5.2-3 9.2-6 12 .4-5 2.4-9 6-12Z"
        />
      )}
    </Svg>
  );
}

/**
 * Acronym — the paywall.
 *
 * Assembly only: the way out, the hero, the claim, what you get, what it
 * saves, what it costs, and the one button.
 *
 * Every block's height is fixed and the hero takes the remainder, so the
 * "Continue" button sits on the safe area at any phone height and there is
 * no band of white anywhere above it.
 */
export default function AcropayScreen() {
  const insets = useInsets();
  const { rowH, margin } = useAcroLayout(insets, features.length);

  return (
    <View style={{ flex: 1, backgroundColor: ct.pink }}>
      <StatusBar style="light" />

      <View
        style={{
          flex: 1,
          marginTop: insets.top + 8,
          paddingHorizontal: margin,
          paddingBottom: insets.bottom + 10,
        }}
      >
        {/* The sheet's fill is a child rather than the container's own
            backgroundColor, so it can be revealed as a step. Left on the
            container it paints from frame one and the take opens on an empty
            white sheet. */}
        <View
          style={{
            position: 'absolute',
            top: 0,
            left: 0,
            right: 0,
            bottom: 0,
            backgroundColor: ct.page,
            borderTopLeftRadius: radius.sheet,
            borderTopRightRadius: radius.sheet,
          }}
        />

        <View style={{ alignItems: 'flex-end', paddingTop: 14 }}>
          <Pressable
            accessibilityRole="button"
            accessibilityLabel="Close"
            onPress={() => router.back()}
          >
            <View
              style={{
                width: 44,
                height: 44,
                borderRadius: 22,
                backgroundColor: '#F2F3F6',
                alignItems: 'center',
                justifyContent: 'center',
              }}
            >
              <Glyph name="close" size={18} tint={ct.muted} />
            </View>
          </Pressable>
        </View>

        {/* The one flexible band on the screen. Everything else has a fixed
            height, so the slack has exactly one place to go and the footnote
            cannot be pushed off the bottom — which is what a hand-summed
            "fixed" total did on the first pass. */}
        <View style={{ flex: 1, alignItems: 'center', justifyContent: 'center', minHeight: 104 }}>
          <Wallet size={132} />
        </View>

        <T variant="headline" color={ct.ink} style={{ textAlign: 'center', marginTop: 6 }}>
          {copy.headline}
        </T>

        <View
          style={{
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'center',
            marginTop: 18,
          }}
        >
          <View style={{ transform: [{ scaleX: -1 }] }}>
            <Glyph name="medal" size={34} tint={ct.laurel} />
          </View>
          <View style={{ alignItems: 'center', marginHorizontal: 6 }}>
            <View style={{ flexDirection: 'row', alignItems: 'center' }}>
              <Glyph name="star" size={20} tint={ct.gold} />
              <T
                variant="rating"
                color={ct.ink}
                style={{ height: type.rating.line, marginLeft: 7 }}
              >
                {copy.rating}
              </T>
            </View>
            <T
              variant="ratingNote"
              color={ct.muted}
              style={{ height: type.ratingNote.line, marginTop: 1 }}
            >
              {copy.ratingNote}
            </T>
          </View>
          <Glyph name="medal" size={34} tint={ct.laurel} />
        </View>

        <View
          style={{
            marginTop: 18,
            borderRadius: radius.card,
            borderWidth: 1,
            borderColor: ct.hairline,
            paddingHorizontal: 16,
          }}
        >
          {features.map((f, i) => (
            <View
              key={f.id}
              style={{
                height: rowH,
                flexDirection: 'row',
                alignItems: 'center',
                borderTopWidth: i === 0 ? 0 : 1,
                borderTopColor: ct.hairline,
              }}
            >
              <Glyph name={f.icon} size={22} tint={ct.muted} />
              <T variant="row" color={ct.ink} style={{ height: type.row.line, marginLeft: 14 }}>
                {f.label}
              </T>
            </View>
          ))}
        </View>

        <View
          style={{
            marginTop: 16,
            borderRadius: radius.card,
            backgroundColor: ct.pinkWash,
            padding: 14,
          }}
        >
          <View
            style={{
              flexDirection: 'row',
              flexWrap: 'wrap',
              justifyContent: 'center',
              alignItems: 'baseline',
            }}
          >
            <T variant="save" color={ct.ink} style={{ height: type.save.line }}>
              {`${copy.saveLead} `}
            </T>
            <T variant="saveBig" color={ct.pinkDeep} style={{ height: type.saveBig.line }}>
              {saving}
            </T>
            <T variant="save" color={ct.ink} style={{ height: type.save.line }}>
              {` ${copy.saveTail}`}
            </T>
          </View>

          <View
            style={{
              marginTop: 12,
              height: 58,
              borderRadius: 14,
              backgroundColor: ct.page,
              flexDirection: 'row',
              alignItems: 'center',
              paddingHorizontal: 16,
            }}
          >
            <T variant="plan" color={ct.ink} style={{ height: type.plan.line }}>
              {copy.plan}
            </T>
            <View
              style={{
                height: 26,
                paddingHorizontal: 10,
                borderRadius: 13,
                backgroundColor: ct.pinkWash,
                alignItems: 'center',
                justifyContent: 'center',
                marginLeft: 10,
              }}
            >
              <T variant="badge" color={ct.pinkDeep} style={{ height: type.badge.line }}>
                {copy.badge}
              </T>
            </View>
            <View style={{ flex: 1 }} />
            <T variant="price" color={ct.ink} style={{ height: type.price.line }}>
              {copy.price}
            </T>
          </View>
        </View>

        <View style={{ height: 16 }} />

        <Pressable accessibilityRole="button" accessibilityLabel={copy.cta}>
          {({ pressed }) => (
            <View
              style={{
                height: 58,
                borderRadius: radius.cta,
                backgroundColor: ct.pink,
                alignItems: 'center',
                justifyContent: 'center',
                opacity: pressed ? 0.9 : 1,
              }}
            >
              <T variant="cta" color={ct.onPink} style={{ height: type.cta.line }}>
                {copy.cta}
              </T>
            </View>
          )}
        </Pressable>

        <View
          style={{
            flexDirection: 'row',
            alignItems: 'center',
            justifyContent: 'center',
            marginTop: 12,
          }}
        >
          <Glyph name="medal" size={16} tint={ct.pink} />
          <T variant="foot" color={ct.pink} style={{ height: type.foot.line, marginLeft: 6 }}>
            {copy.foot}
          </T>
        </View>
      </View>
    </View>
  );
}
