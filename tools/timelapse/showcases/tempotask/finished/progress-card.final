import { View } from 'react-native';

import { copy, days, peakLabel } from '../data/task';
import { CARD_PAD, COLUMN_WIDTH, PLOT_HEIGHT, PROGRESS_HEIGHT } from '../layout';
import { radius, shadow, tp, type } from '../theme';
import { CardHead } from './card-head';
import { Hatch } from './glyph';
import { T } from './text';

/**
 * How the week went: six hatched days, one of them solid, and the change on
 * each pinned beside it.
 *
 * Every column's height comes from the data rather than from a hand-placed
 * offset, so the chart cannot disagree with the numbers printed on it — which
 * a design shot's chart usually does.
 *
 * The chips sit at a `lift` given per day, as a share of the plot. That keeps
 * the scatter the reference has without putting a dp offset in a component,
 * and it still holds when the card is a different width.
 *
 * The selected day's chip is lifted off its own column and positioned
 * absolutely, so it can overhang the bar without widening the row.
 */
export function ProgressCard() {
  const chipTone = (tone: string) =>
    tone === 'green' ? tp.green : tone === 'orange' ? tp.orange : tp.dark;

  return (
    <View
      style={{
        height: PROGRESS_HEIGHT,
        borderRadius: radius.card,
        backgroundColor: tp.card,
        padding: CARD_PAD,
        ...shadow.card,
      }}
    >
      <CardHead title={copy.progress} />

      <View style={{ flex: 1, flexDirection: 'row', alignItems: 'flex-end', marginTop: 14 }}>
        {days.map((d) => (
          <View key={d.day} style={{ flex: 1, alignItems: 'center' }}>
            <View style={{ height: PLOT_HEIGHT, justifyContent: 'flex-end' }}>
              <View
                style={{
                  position: 'absolute',
                  bottom: d.chip.lift * PLOT_HEIGHT,
                  zIndex: 2,
                }}
              >
                <View
                  style={{
                    paddingHorizontal: 7,
                    paddingVertical: 3,
                    borderRadius: radius.pill,
                    backgroundColor: chipTone(d.chip.tone),
                  }}
                >
                  <T variant="chip" color={tp.onDark} style={{ height: type.chip.line }}>
                    {d.chip.text}
                  </T>
                </View>
              </View>

              {d.peak ? (
                <View style={{ alignItems: 'center' }}>
                  <View
                    style={{
                      paddingHorizontal: 8,
                      paddingVertical: 3,
                      borderRadius: radius.pill,
                      backgroundColor: tp.dark,
                      marginBottom: 6,
                    }}
                  >
                    <T variant="chip" color={tp.onDark} style={{ height: type.chip.line }}>
                      {peakLabel}
                    </T>
                  </View>
                  <View
                    style={{
                      width: COLUMN_WIDTH,
                      height: PLOT_HEIGHT * 0.72,
                      borderRadius: radius.pill,
                      backgroundColor: tp.dark,
                    }}
                  />
                </View>
              ) : (
                <Hatch width={COLUMN_WIDTH} height={PLOT_HEIGHT * d.height} tint={tp.hatch} />
              )}
            </View>

            <T
              variant={d.peak ? 'axisOn' : 'axis'}
              color={d.peak ? tp.ink : tp.muted}
              style={{ marginTop: 10, height: type.axis.line }}
            >
              {d.day}
            </T>
          </View>
        ))}
      </View>
    </View>
  );
}
