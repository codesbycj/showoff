/** A folder, drawn — a folder is a small flat object and squarely in range. */
function FolderMark({ size = 26, tint }: { size?: number; tint: string }) {
  return (
    <Svg width={size} height={size} viewBox="0 0 24 24">
      <Path
        d="M3.4 7a2 2 0 0 1 2-2h3.8l1.8 2.2h7.6a2 2 0 0 1 2 2v8.2a2 2 0 0 1-2 2H5.4a2 2 0 0 1-2-2Z"
        fill={tint}
      />
    </Svg>
  );
}

