  {
    id: 'alex',
    name: 'Alex Johnson',
    stage: 'Treatment',
    tint: 'lavender',
    image: require('../../../../assets/images/axisrisk/a1.jpg'),
  },
  {
    id: 'casey',
    name: 'Casey Brown',
    stage: 'Monitoring',
